{
    "Author": [
        "Perdigon"
    ],
    "Genre": "Canso",
    "Title": "Entramor e pensamen ",
    "FullText": [
        "Entramor e pensamen",
        "e bos cugz e greu consir,",
        "e fin joi e lonc dezir,",
        "mi menon levan cazen,",
        "e per luec sospir e plor",
        "de paor",
        "quel comnhatz",
        "quem fo donatz",
        "gent autreiatz",
        "soblit quar no soi tornatz.",
        "Lo bos cugz en quieu enten",
        "madui molt coral sospir,",
        "tan tem el cuiar faillir",
        "cai dun ric enprendemen;",
        "e sieu trop estavaillor,",
        "leis caor",
        "prec, sill platz,",
        "que nos deslatz",
        "lo plaitz fermatz",
        "quem fo per leis autreiatz.",
        "Car parra dafortimen.",
        "quim ve laisar e gurpir",
        "lei cuns quex volgrobezir,",
        "sim rete per chauzimen;",
        "quar li valen valedor",
        "an sabor",
        "quan laisatz",
        "dezeretatz",
        "don par pecatz",
        "fasson captenh acabatz.",
        "Quim laissa ses faillimen.",
        "no cug per atent delir,",
        "quenquer sai on puesc guerir",
        "si Dieus el Bautz mi consen;",
        "que lai truep fina valor",
        "ses error",
        "que lonratz",
        "pretz esmeratz,",
        "sobremontatz,",
        "amparals dezamparatz.",
        "Fis Jois, dreituraus defen",
        "que cui que veiatz failhir",
        "que vos non prenguatz albir;",
        "mas pretz e valor e sen",
        "vos det Dieus queus fes meillor",
        "e gensor",
        "dels regnatz.",
        "Per so gardatz",
        "que lenguanatz",
        "viu sal e lautrencolpatz.",
        "Del rei dArago mes gen,",
        "quar tan li platz enantir",
        "tot quan bos pretz deu grazir;",
        "el rei nAnfos eisamen,",
        "cab ricx faitz demperador",
        "creis honor;",
        "don sapchatz",
        "que acordatz",
        "los volgren patz",
        "vezer contrals renegatz.",
        "Fillol, si faitz vostrator",
        "az onor:",
        "ben gardatz,",
        "si gen lobratz,",
        "que compliscatz",
        "lobra e no la desfasatz.",
        "Ves nArias mon senhor",
        "vai e cor,",
        "chans mesclatz,",
        "e dill, sill platz,",
        "quentrels regnatz",
        "par sos fis pretz esmeratz."
    ],
