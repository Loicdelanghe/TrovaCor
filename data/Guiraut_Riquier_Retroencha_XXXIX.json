{
    "Author": [
        "Guiraut_Riquier"
    ],
    "Genre": "Retroencha",
    "Title": "Pus astres no m'es donat ",
    "FullText": [
        "Pus astres no mes donat",
        "que de midons bes meschaya,",
        "ni nulhs mos plazers nol platz,",
        "ni ai poder quem nestraya,",
        "ops mes quieu sia fondatz",
        "en via damor veraya:",
        "e puesc napenre assatz",
        "en Cataluenha la gaya,",
        "  entrels catalans valens</em",
        "m>  e les donas avinens.</em",
        "Quar dompneys, pretz e valors,",
        "joys e gratz e cortezia,",
        "sens e sabers et honors,",
        "belhs parlars, bella paria,",
        "e larguesa et amors",
        "conoyssensa e cundia",
        "troban mantenh e secors",
        "en Cataluenha a tria,",
        "  entrels catalans valens</em",
        "m>  e les donas avinens.</em",
        "Per quieu ai tot mon acort",
        "que delhs lurs costums aprenda,",
        "per tal qua mon Belh Deport",
        "one razon, que mentenda;",
        "que non ai autre conort,",
        "que de murir me defenda,",
        "et ai cor per penre port,",
        "quen Cataluenha atenda,",
        "  entrels catalans valens</em",
        "m>  e les donas avinens.</em",
        "E sieu entrelhs non aprenc",
        "o per quAmors guazardona",
        "servir als sieus, don dan prenc,",
        "noy a mas quom me rebona;",
        "quar tant dafan ne sostenc,",
        "que ma gitat de Narbona,",
        "e per gandir via tenc",
        "en Cataluenha la bona,",
        "  entrels catalans valens</em",
        "m>  e les donas avinens.</em",
        "Tan suy dapenre raisos",
        "so que damar ai falhensa,",
        "que nulhs pessars no mes bos",
        "mas selh quals verays agensa;",
        "e quar nol say ad estros,",
        "au per bona entendensa",
        "querre e trobar cochos",
        "en Cataluenha valensa,",
        "  entrels catalans valens</em",
        "m>  e les donas avinens.</em",
        "h",
        "(Text dAnglade)"
    ],
