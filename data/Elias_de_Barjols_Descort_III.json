{
    "Author": [
        "Elias_de_Barjols"
    ],
    "Genre": "Descort",
    "Title": "Una valenta ",
    "FullText": [
        "    Una valenta,",
        "car sol es avinenta",
        "e de plazers plazenta,",
        "ol queu fass un descort gai.",
        "    Belles e genta,",
        "mas nol platz quem consenta",
        "samor, ni latalenta,",
        "on il peccat e tort fai.",
        "    Queu lam ses bausia,",
        "ab lial cor fin e vera",
        "    e ses tricharia ;",
        "queu de lleis nom loing nim estrai,",
        "    [sieo son on queo sia,",
        "que samor non fui ni desfai]",
        "    caissi fos il mia",
        "com eu lam totz iornz mielz e mai.",
        "      Mas per doptansa",
        "    no laus far semblansa",
        "    con lam finamen ;",
        "      tant tem sonransa,",
        "    qeill torn a pesansa",
        "    siel dic mon talen.",
        "      Greu malanansa",
        "    trop long esperansa,",
        "    son ioi non aten !",
        "      En tal balansa",
        "    ai per sobramansa",
        "    estat longamen.",
        "    Pero sieu un dia",
        "    so camics damia",
        "      nagues,",
        "    ca midons plagues,",
        "    ia tan no volria",
        "    nuilla manentia",
        "      [m] vengues ;",
        "    si non sumelia",
        "    mal vi sa paria",
        "      e sos bes,",
        "    si nom val merces",
        "    e sa cortezia,",
        "    pos nom val lamia",
        "      ni res.",
        "    DEn Agout volria",
        "    tant de manentia",
        "      l vengues",
        "    que donar pogues",
        "    tot so quel plairia,",
        "    car sai que seria",
        "      ben mes."
    ],
