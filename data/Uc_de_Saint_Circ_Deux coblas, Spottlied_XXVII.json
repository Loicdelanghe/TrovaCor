    "Genre": "Coblas",
    "Title": "Pei Ramon ditz ",
    "FullText": [
        " Pei Ramonz ditz ",
        "E de trobar se gaba ",
        " Qe la raz",
        "Trobera senes gab,",
        " Qel es garnitz",
        "Tant dart et de silaba",
        " Qen sos escritz",
        "A trobat u silab.",
        " Laig er aunitz",
        "Saissi non o acaba,",
        " O gen geritz",
        "Sen pot venir a cab.",
        " Sainz esperitz",
        "Len garde de mescab;",
        " Queu soi marritz",
        "Se ja de rei mescaba."
    ],
