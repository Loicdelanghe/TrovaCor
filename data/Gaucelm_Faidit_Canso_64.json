{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Tuich cil que amon Valor ",
    "FullText": [
        "Tuich cil que amon Valor",
        "von saber que dAmor",
        "mou larguess e gai solatz,",
        "orguoills et humilitatz,",
        "pretz darmas, servirs dhonor,",
        ", jois, cortesia",
        "Doncs, pois so-n mou, ben deuria",
        "hascus poignar, qui bon pretz vol aver",
        "fin Amor leialmen mantener.",
        "E si-s fan lo li meillor",
        "ui pretz complitz a sabor ;",
        "mas li feignedor malvatz",
        "b falsas amistatz",
        "vout Pretz en avol color,",
        ", qui-l ver dir en volia,",
        "quella mezeissa via",
        "vezem al plus de las dompnas tener ",
        "qer qe mes greu, car ie-n puosc dire ver.",
        "Las falsas e-il feignedor",
        "fan tant qe-ill fin amador",
        "puois dan en lur baratz,",
        "aitals es prejars tornatz",
        "ot per doptanssa de lor,",
        "qe lus en lautre no-is fia ;",
        "qui per so-is recreiria",
        "on a fin cor damar ni ferm voler,",
        "Amors non vol camics si desesper.",
        "Mas sivals segon lerror",
        "falsas e-ill trichador",
        "Volgra fosson ad un latz",
        "hascus fos galiatz !",
        "fin leial prejador",
        "ompnas ses bauzia",
        "mantenguesson drudaria ;",
        "quenueitz es grans, en amor, a vezer",
        "qe fals amans i puosc ab fins caber !",
        "Damor agr ieu cor meillor,",
        "que de re mas la dolor",
        "men sent, don fui enganatz ;",
        "jes per so no-m desplatz,",
        "m fan li maltrag paor ;",
        "pchatz ben camaria",
        "fort volontiers si sabia",
        "hauzir bon luoc, on pogues remaner,",
        "obava qi-m saubes retener ",
        "Mas un aitals sazos cor",
        "qe greu trob om bon seignor",
        "ompna don si amatz",
        "otz sols, ses autre perchatz,",
        "ieu ab francha doussor",
        "obes leial seignoria",
        "be-m plagra, caissi-s taing sia,",
        "qan dui amic sacordon dun voler,",
        "o qa lun platz deu a lautre plazer.",
        "Vas Montferrat ten ta via",
        "mon Tesaur, ses faillia,",
        ", chanssos, que ill sap mieills valer",
        "uill autre qe hom puosca vezer.",
        "Reis Castelans, caps e guia,",
        "om Dieus vos aguia,",
        "z ben del mon, evospot hom vezer",
        "b los faitz far et ab pretz mantener."
    ],
