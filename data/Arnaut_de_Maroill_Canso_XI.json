{
    "Author": [
        "Arnaut_de_Maroill"
    ],
    "Genre": "Canso",
    "Title": "Ses ioi non es valors ",
    "FullText": [
        "Ses ioi non es valors",
        "ni ses valor honors,",
        "que Jois adutz Amors",
        "et Amors dompna gaia",
        "e gaiesa solatz",
        "e solatz cortesia ;",
        "per qu'ieu non vuoill un dia",
        "ure desconortatz,",
        "que neis quan sui iratz,",
        "eu chant e m'asolatz,",
        "cora c'avinen sia.",
        "En joi ai mon esper,",
        "fin cor e ferm voler,",
        "e joi non puesc aver,",
        "ompna, tro c'a vos plaia,",
        "cui me sui autreiatz",
        "per aital aventura,",
        "c'Amors m'en asegura,",
        "mas vos m'en esfredatz.",
        "Mas una ren sapchatz,",
        "s'Amor e mi forssatz,",
        "rop etz salvatg' e dura.",
        "El cor vos mir ades",
        "e, car nous vei plus pres,",
        "la gensser c'anc nasques,",
        "prec vos que dans noi aia.",
        "Bona dompna, sius platz,",
        "al vostre pretz retraire,",
        "si jois de vos m'esclaire,",
        "es tant ma voluntatz,",
        "qu'en autres ambaissatz",
        "non fui alezeratz,",
        "pois ieu anc vos vi gaire.",
        "Dompna, per vos mi clam,",
        "car totz art et aflam,",
        "tant de bon cor vos am.",
        "Ai ! franca res veraia,",
        "car tant es aut poiatz",
        "lo desirs quem tormenta,",
        "merceus clam, dompna genta,",
        "colors d'autras beutatz,",
        "que s'ieu orguoill i fatz,",
        "la vostr' humilitatz",
        "per merce m'o cossenta.",
        "Chausimen e merce",
        "podetz aver de me,",
        "qu'ieus amarai jasse,",
        "e tot so quem n'eschaia,",
        "ompna, penrai en patz",
        "aissi cum bos sufrire ;",
        "qu'ieus am tant eus desire,",
        "mais m'en val us oratz",
        "la nuoich, quan sui colgatz,",
        "qu'ieus tengues e mos bratz,",
        "que d'autr' esser jauzire."
    ],
