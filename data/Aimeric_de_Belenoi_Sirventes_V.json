    "Genre": "Sirventes",
    "Title": "Anc puois qe giois ni cant ",
    "FullText": [
        "Anc puois qe giois ni cant",
        "ni donars ni servirs",
        "ni pret ni gent garnirs",
        "ni amoros demans",
        "noi troberon amicx,",
        "no fo lo segle ricx",
        "ni reinhet fis ni pat,",
        "doncs ben es grant foudat",
        "qui non ama tot . . . . . .",
        ". . . . . . . . . . . . . . . . . .",
        ". . . . . fait ben estans,",
        "gent mangiars ni vestirs",
        "onrars ni acuglirs",
        ". . . . . . . . . . . .",
        ". . . . . . . . . . .",
        ". . . . . . . . . . . . . .",
        ". . no fon pechat,",
        "ni merces, so sapcias,",
        "res mas bon cor, qe del cor mou e nais",
        "lo fait per ce es om bons e savais.",
        "Cor es segnoreians",
        "sobre tut los consirs,",
        "e vesers eausirs",
        "iuials fait els senblans,",
        "qels gioues els anticx",
        "ai cor francx e enicx",
        "de fait e de semblans;",
        "q'enperis ne reinhat",
        "non fan ome grasir, mas cors verais,",
        "si tot lo vist sa grant beutat nil pais.",
        "Als petit es als grans",
        "es naisers e morirs",
        "e salvars e perirs",
        "comunals, per qu' enians",
        "me senbl'e grans fasticx",
        "c'om cobes flacs ni rix",
        "gia sia poestat;",
        "c'a ricor fon donat",
        "poders, qe fos dels clerges e dels lais",
        "capdels e guit e qe pret noil fos fais.",
        "Lai son umelians,",
        "e me fon lo venirs",
        "dout, e greus lo partirs,",
        "en Castella, on lans",
        "mos avinent presicx.",
        "non atanh a casticx,",
        "mas, car al franc rei plat",
        "bels dict e fait presat:",
        "qe no cresa sermon don pre abais,",
        "mas grat, com fe sos avis, bos assai."
    ],
