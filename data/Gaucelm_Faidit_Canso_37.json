{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Gen fora, contra lafan ",
    "FullText": [
        "Gen fora, contra lafan",
        "qe ma dat duna dompn Amors,",
        "puois ab lieis non trob mas dan,",
        "qe-m fezes dautra part socors,",
        "ab que saleuges ma dolors :",
        "qe-il dir de non desplazen",
        "e lieis, on plus non enten,",
        "man ostat",
        "e virat",
        "lo cor e-l sen",
        "un greu fais,",
        "per qieu lais",
        "entendemen ",
        "Tant qant la preguei chantan,",
        "no-m fo lo prejars mas follors,",
        "per qe-m vir deserenan",
        "lo prec e-l cor e-l chan aillors,",
        "as tal on beutatz e valors",
        "son, e tuich bon faich valen ;",
        "e sil de cor mi cossen",
        "ni mes dat",
        "e bon grat",
        "ab ferm coven,",
        "ges oimais",
        "no mirais",
        "mespaven.",
        "E pero li beill semblan",
        "e-il gent acuillir e-il doussors",
        "el sieu bel cors nou, prezan,",
        "e-ill beutatz, e-il fresca colors,",
        "qes sobre totas autras flors,",
        "la-m fant amar tant temen",
        "canc no-i lausei far parven",
        "mon pensat",
        "acordat,",
        "ni-l fin talen",
        "on matrais,",
        "mos cors gais ",
        "men !",
        "Ardimen matrais trop gran,",
        "mas doptei qen sia clamors",
        "quan la bella-m soferc tan ",
        "qenqer sent las doussas sabors,",
        "qe de greu malananssa-m sors ",
        "qan li baisiei doussamen",
        "son bel, blauc col covinen,",
        "ab honrat",
        "ous comjat,",
        "privadamen ;",
        "adoncs frais",
        "lo doutz bais",
        "mon marrimen !",
        "Tant son siei faich benestan",
        "que tot lals com ve es errors",
        "mantenen qom les denan ;",
        "e vei los bes e las honors,",
        "e-ls plazers chascun jorn majors ;",
        "e-l sieus doutz esgar rizen",
        "qe-m fetz amorosamen",
        "mant loingnat",
        "e foudat,",
        "per qieu li-m ren ",
        "on mi nais,",
        "al cor, jais",
        "qe-m ten gauzen.",
        "Ses prec, ses dich e ses man,",
        "canc no-ill fis, tant mes grans paors,",
        "liautrei mon cor e mon chan",
        "per retraire sas grans lauzors ",
        "E car val sobre las meillors,",
        "aja-n, sil platz, chausimen",
        "tal qe-m don, suau e gen,",
        "un emblat",
        "on prezat",
        "e bel prezen,",
        "contra-ls brais",
        "els savais,",
        "men.",
        "Pros Vescomtess ab cors gen,",
        "a Ventadorn vos presen",
        "mon comjat",
        "acordat ",
        "chantar plazen",
        "qes oimais",
        "tornatz gais",
        "onradamen."
    ],
