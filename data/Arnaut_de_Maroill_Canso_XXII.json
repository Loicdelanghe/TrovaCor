{
    "Author": [
        "Arnaut_de_Maroill"
    ],
    "Genre": "Canso",
    "Title": "Franques' e noirimens ",
    "FullText": [
        "Franques' e noirimens",
        "m'aduz e chausimens",
        "c'ades am ses falsura ;",
        "mas cals que sial bes,",
        "eu am mais trop ab vos,",
        "bella dompna e pros,",
        "totz temps far mon dampnatge,",
        "c'ab autra conqueses ;",
        "que tant grans honors m'es,",
        "ot mon maltraich meillura.",
        "Tant es ferms mos talens",
        "en vos, dompna valens,",
        "non puosc aver mesura",
        "nous am, ab que beus pes,",
        "mas d'autra ren c'anc fos,",
        "c'aisso es l'ochaisos",
        "on m'avetz cor salvatge,",
        "e d'aisso, sius plagues,",
        "s'autre tort nous fezes,",
        "non degratz far rancura.",
        "On plus vostre cors gens",
        "mi mostra espavens",
        "ni me desasegura,",
        "Amors, que mi a pres,",
        "m'en fai plus enveios,",
        "quem te vostras faissos",
        "edinz e mon coratge",
        "e mostram que Merces",
        "a mains autres conques :",
        "veus so que m'asegura.",
        "Franca res avinens,",
        "en cui jois e jovens",
        "e totz bos aips s'atura,",
        "a tort m'avetz comes ;",
        "qui tant cant pot es bos,",
        "(que plus noil quier razos)",
        "e non es de paratge,",
        "sera, coms o marques,",
        "avols hom mal apres,",
        "qui jutga per dreitura.",
        "Pros dompna conoissens,",
        "en cui es pretz e sens",
        "e beutatz fin' e pura,",
        "que natura i mes,",
        "cors gai et orgoillos,",
        "e semblans amoros",
        "e joi e d'agradatge,",
        "e sobre totas res",
        "son vostre faich cortes",
        "mais d'autra creatura.",
        "Chanso, ves Mon Frances",
        "t'en vai, quar ab lui es",
        "jois e bon' aventura.",
        "Senher En Genos,",
        "lo fin pretz qu'en vos es",
        "creis ades e meillura."
    ],
