{
    "Author": [
        "Fraire_Menor"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Cor ay e voluntatz ",
    "FullText": [
        "Cor ay e voluntatz",
        "que fassus precx prezatz,",
        "sieu ben far los sabia;",
        "e volgram fos donatz",
        "sens e sabers assatz,",
        "sels quals precx convenria,",
        "que voler pro nauria.",
        "Dona sancta Maria,",
        "preyatz Ihesus, sius platz,",
        "que es Cristz apellatz",
        "e de paradis via,",
        "quampar lanima mia",
        "si cum plazers li sia,",
        "quem perdon mos peccatz",
        "quai pessan cogitatz",
        "e ditz per ma folia,",
        "sels quai obratz man dia",
        "aissi quo non devia,",
        "on so mot encolpatz;",
        "ona de dignetatz,",
        "vos men faitz guerentia.",
        "Enquer prec quem valhatz,",
        "ona, e quem sofratz",
        "quieu vos laus tota via.",
        "Pero crey ques vertatz",
        "que sil sen dels prelatz",
        "el saber de clercia",
        "hom aiustar podia,",
        "e ieu poder avia",
        "quen mi fos ajustatz,",
        "non seria bastatz,",
        "nil mile non auria",
        "el saber quobs mauria",
        "al laus quieu dir volria,",
        "ona,ls bes que son datz",
        "en vos quenlumenatz",
        "ot lo mon ques perdia;",
        "per vos se salves guia,",
        "per quieu dic sens fadia:",
        "per vos son restauratz,",
        "ona,ls que son salvatz;",
        "aidatz me quieu sals sia.",
        "Quieu crey, si vos maidatz",
        "ni mos precx escoutatz",
        "tant etz de Dieu amia",
        "leu sera acabatz",
        "mos precx et yssaussatz,",
        "mielhs que nom tanheria",
        "segon que yeu fallia",
        "el temps que mal vivia.",
        "Pero suy men laissatz,",
        "on prec merce maiatz,",
        "questiers non pujaria",
        "a la gran companhia",
        "on es totalegria",
        "e Dieu ques trinitatz,",
        "ni veiria sa fatz",
        "si merces nom valia.",
        "O maire de Dieu pia,",
        "no truep en voz fadia!",
        "Sivals aitan maidatz",
        "quan que sia passatz",
        "quieu pres dels sayns estia."
    ],
