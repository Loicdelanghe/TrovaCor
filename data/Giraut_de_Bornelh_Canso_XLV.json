{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Ges aissi del tot nom lais",
    "FullText": [
        "Ges aissi del tot nom lais",
        "Chantar ni deport ni rire,",
        "Can quera do lai meslais;",
        " Mas car plus no platz",
        " Conortz ni solatz,",
        "No volh en me sol despendre",
        " Mos bos dichs prezatz,",
        " Ans desque comens",
        " Mos chans avinens,",
        " Pois nestrenh las dens,",
        " Que nols aus retraire;",
        " Car non i vei gaire",
        "   Cui plassa jais",
        " Ni trop qui menvei,",
        "Seu malegre ni mesbaudei.",
        "E pero si me notz mais ",
        "Mas que no mes bel a dire ",
        "Ma malamia quem trais",
        " E sim par foldatz",
        " Car men sui proatz,",
        "Pos a leis nom posc defendre.",
        " Mal me sui menatz,",
        " Serai donc sofrens,",
        " Ja men venha lens",
        " Bes e jauzimens;",
        " Canc negus amaire",
        " No saup damor gaire",
        "   Que leu sirais,",
        " CAmors dona le",
        "Com laltrui tort blande mercei.",
        "Vers es que samor mestrais",
        "E non pot escondire;",
        "Mas pos la forsal prat pais,",
        " Que mi val vertatz ?",
        " Melhs me forassatz",
        "Quel cor vires en atendre",
        " Vas calacom latz;",
        " Que pos forsa vens,",
        " Non es drechs valens,",
        " El paucs esciens,",
        " Que mes chabdelaire,",
        " Dona mun veiaire",
        "   Queu cre mabais,",
        " Can vas leis felnei;",
        "Ca poder quem sorzom sordei.",
        "Mas quim fos amics verais",
        "E de mos bes esjauzire,",
        "Fis e francs e ses mals ais,",
        " Ab quem fos celatz,",
        " Que no fos preiatz,",
        "Joi mi pogrenquera rendre.",
        " Non sui tan lonhatz?",
        " Quel cor mescrezens",
        " Se combat el sens",
        " El tertz espavens;",
        " Canc nuls temens laire",
        " Negu fort repaire",
        "   Sols non enfrais,",
        " Quel cor e tuch tre",
        "Plus temen nolh movan desrei.",
        "Era sojorn et engrais,",
        "Car sap com me pot aucire!",
        "Canc pois no fui letz ni gais,",
        " Descus fols versatz",
        " Que maduis pechatz",
        "Mafiet em fetz entendre",
        " Gran mensonhel fatz",
        " Nom fo pois guirens",
        " Plus quel pensamens,",
        " En que mas, o vens.",
        " E ja domneiaire,",
        " Serus emperaire,",
        "   So sobrer fais",
        " Non er quilh lenvei,",
        "CAmors no vol com senhorei.",
        "Canc no fo qui be safrais",
        "Nis fetz vencutz ni sofrire,",
        "Si tot fon en als savais,",
        " Cans no fos paiatz",
        " Cus desmezuratz",
        "Ques menassa descoissendre,",
        " Per cumilitatz",
        " Val als conoissens.",
        " E donc no naprens",
        " Corgolhs es niens",
        " El bos sofertaire,",
        " Si no nes gabaire,",
        "   Conquer qui bais",
        " E tenhe manei?",
        "Mas eu no dic que be nestei!",
        "Anc valors cui vils pretz frais",
        "Per vils agradils assire",
        "Vas benestar no satrais",
        " Ni ja rics malvatz",
        " Ni mal ensenhatz",
        "No si degren alt estendre!",
        " Sin fos drechs jutjatz,",
        " En van!  O mentens?",
        " Oc!  E donc consens,",
        " Que malvaza gens",
        " Saus vas domnatraire",
        " Conhda de bon aire,",
        "   Que daize nais",
        " Locs en que folei?",
        "Mas cui non pes, amor abnei!"
    ],
