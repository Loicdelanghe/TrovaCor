{
    "Author": [
        "Arnaut_de_Maroill"
    ],
    "Genre": "Canso",
    "Title": "Sabers e cortezia ",
    "FullText": [
        "Sabers e cortezia",
        "e belha paria",
        "e fina beutatz,",
        "ab [fis] pretz esmeratz",
        "a vos fan guerentia,",
        ". . . . . . . . . .",
        "pros dona e valens,",
        "e totz laus avinens ;",
        "per que nos part un dia",
        "e vos mos pensamens.",
        "Donal genser que sia,",
        " per vos me castia",
        "sens e voluntatz",
        "e nom laisson em patz,",
        "qu'a mon sen, si podia,",
        "mi deslunaria",
        "els autz entendemens,",
        "e d'autra part jovens",
        "tz qu'onrada folhia",
        "val en luecx mais que sens.",
        "En aissos pliu es fia,",
        "que mais nos camba",
        "de vos mos pensatz,",
        "e suy m'aseguratz.",
        "Mais vuelh qu'amors m'aucia",
        "que grans gailhardia",
        "qui ser recrezens (?)",
        "qu'ades [es] mos talens",
        "plus segurs tota via,",
        "mielher e mais valens.",
        "Per nom de drudaria",
        "d'autra nom plairia",
        "plazers ni solatz,",
        "an sui enamoratz",
        "que nous dezamaria,",
        "si ja nom valia",
        "lo vostre guays cors gens,",
        "quar el es cors rizens ;",
        "mais val belha fadia",
        "qu'us dos dezavinens.",
        "Totz temps vos amaria,",
        "si totz temps vivia,",
        "dona, so sapchatz ;",
        "e doncx humilitatz",
        "ni merces nom valria,",
        "que n'o sufriria",
        "lo vostr' ensenhamens.",
        "Dompn' als belhs digz plazens,",
        "merceus clam, sius plazia",
        "quem valgues chauzimens."
    ],
