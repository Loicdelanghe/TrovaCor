{
    "Author": [
        "Peire_de_la_Cavarana"
    ],
    "Genre": "Sirventes",
    "Title": "D'un serventes faire ",
    "FullText": [
        "D'un serventes faire",
        "Es mos pessamenz,",
        "Qel pogues retraire",
        "Viatz e breumenz,",
        "Qel nostr'emperaire",
        "Aiosta granz genz.",
        " Lombart, beus gardaz</em",
        "  Que ia non siaz</em",
        "  Peier qe compraz,</em",
        " Si ferm non estaz.</em",
        "De son aver prendre",
        "Nous mostraz avars;",
        "Per vos far contendre",
        "Ja non er escars;",
        "Sil vos fai pois rendre,",
        "L'avers er amars.",
        " Lombart, beus gardaz, ecc.",
        "De Pullaus sovegna",
        "Dels valenz baros,",
        "Qu'il non an que pregna,",
        "For de lor maisos:",
        "Gardaz no'ndevegna",
        "Autretal de vos.",
        " Lombart, beus gardaz, ecc.",
        "La gent d'Alemagna",
        "Non voillaz amar",
        "Ni ia sa compaigna",
        "Nous plaza usar,",
        "Car cor m'en fai laigna,",
        "Ab lor sargotar.",
        " Lombart, beus gardaz, ecc.",
        "Granoglas resembla",
        "En dir: broder, guaz?",
        "Lairan, quant s'asembla,",
        "Cum cans enrabiaz.",
        "No voillaz ia venga!",
        "De vos los loingnaz!",
        " Lombart, beus gardaz, ecc.",
        "Deus gart Lombardia,",
        "Boloign'e Milans",
        "E lor compaignia,",
        "Brexa e Mantoans,",
        "C'us d'els sers non sia,",
        "Els bos Marquesans.",
        " Lombart, beus gardaz, ecc.",
        "Deus sal en Sardegna",
        "Mon Malgrat-de-toz,",
        "Car genz viu e regna",
        "E val sobre toz;",
        "Cus tant larcs nos segna",
        "De neguna voz.",
        " Lombart, beus gardaz, ecc.",
        "Saill d'Agaiz, bem plaz",
        "Car tant gent regnaz,",
        "Verones honraz,",
        "E si ferm estaz.",
        " Lombart, beus gardaz, ecc."
    ],
