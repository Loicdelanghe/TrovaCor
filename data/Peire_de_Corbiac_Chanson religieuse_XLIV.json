{
    "Author": [
        "Peire_de_Corbiac"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Dona, dels anglis rehina ",
    "FullText": [
        "Dona, dels angils rehina,",
        "esperansa dels crezens:",
        "segon que maonda sens",
        "chan de vos lengua romana;",
        "quar nulhs hom iustz ni peccayre",
        "e vos lauzar nos deu traire,",
        "cum sos sens mielhs laparelha,",
        "omans o lengua latina.",
        "Dona, roza ses espina,",
        "sobre totas flors olens,",
        "ergua seca frug fazens,",
        "terra que ses labor grana,",
        "estela del solelh mayre,",
        "noyrissa del vostre payre:",
        "el mon nulha nous semelha,",
        "ondana ni vezina.",
        "Dona, ioves enfantina",
        "fos a Dieu obedens",
        "en totz sos comandamens;",
        "per que la gens crestana",
        "cre ver e sap tot lafaire",
        "queus dis langels saludaire,",
        "quan receubes per laurelha",
        "Dieu, cuy enfantes vergina.",
        "Dompna, verges pura e fina",
        "ans que fos lenfantamens",
        "et apres tot eyssamens:",
        "receup en vos carn humana",
        "Ihesucristz, nostre salvayre,",
        "si quon ses trencamen faire",
        "ntral belhs rays quan solella",
        "per la fenestra veyrina.",
        "Dompna, vos etz layglentina",
        "que trobet vert Moysens",
        "entre las flamas ardens,",
        "e la toizos de la lana",
        "ques mulhet dins la secayre,",
        "on Gedeons fon proayre;",
        "e naturas meravelha",
        "quom remazetz intayzina.",
        "Dompna, estela marina",
        "e las autras pus luzens,",
        "la mars nos combat el vens:",
        "mostra nos via sertana;",
        "car sins vols a bon port trayre,",
        "non tem naus ni governayre",
        "ni tempest quens desturbelha",
        "l sobern de la marina.",
        "Dona, metiess e metzina,",
        "lectoaris et enguens:",
        "los nafratz de mort guirens",
        "lave lia, onh e sana;",
        "ossa, pia, de bon ayre,",
        "fai nos tost de mal estrayre;",
        "car perdutz es qui sonelha,",
        "que la mortz les trop vezina.",
        "Don, espoza, filhe mayre:",
        "mandal filh e pregal payre,",
        "ab lespos parle consselha",
        "om merces nos siayzina.",
        "Nos durmen, mas tuns esvelha",
        "quens sia mortz vezina."
    ],
