    "Genre": "Cobla",
    "Title": "Veillz Cumunals plaides ",
    "FullText": [
        "Veillz Cumunals plaides,",
        "ver brivat lo corves;",
        "ill malvatz serventes",
        "qe vos auch far e dir,",
        "me tornon en azir,",
        "ill vostra ianglosia,",
        "!--[if gte mso 9]><xml>",
        "me desplaz chascun dia,",
        "m n'es vos enoios,",
        "que limars d'esperos,",
        "ms e falcos",
        "m mais auzir que vos.",
        "Mas sobrebe vos pres",
        "viella no volges,",
        "'ab autra foraz mes",
        "feraus greu soffrir.",
        "on a obs queus tir",
        "ossa sa drudaria,",
        "n vol iauzir;",
        "qe no sen iauziria,",
        "'outra doas messos",
        "on auria drut de vos;",
        "ullal ianglos",
        "o sera ia cogos."
    ],
