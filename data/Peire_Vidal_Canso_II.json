    "Genre": "Canso",
    "Title": "Atressi col perilhans",
    "FullText": [
        "Atressi col perilhans",
        "Que sus en l'aiga balansa,",
        "Que non a conort de vida,",
        "Tan sofre greu escarida,",
        "Que paors li toi membransa,",
        "E pois quan ven a bon por",
        "Per astre o per socors :",
        "Tot aitals astres m'a sors,",
        "Per qu'eu ai assatz razo",
        "De far novela chanso.",
        "Estat aurai malanans",
        "E sufert greu malanansa,",
        "Tan que merces m'es falhida",
        "De leis qu'e son tort m'oblida ;",
        "E non aus penre venjansa.",
        "Pero eu trac peitz de mort,",
        "Qu'anc nom volc valer Amors ;",
        "Mas er s'en va la dolors.",
        "Qu'en tal ai m'entensio,",
        "Quel plai qu'eu chant el sap bo.",
        "De la bela sui clamans,",
        "Que me mostra per semblansa",
        "Que ma mortz l'es abelida :",
        "E quar melhs non es chauzida,",
        "Ai faita mout gran erransa.",
        "Tornarai l'ir' en conor",
        "E virarai m'en alhors,",
        "Quar sens es e grans valors,",
        "Qui de bran senhor felo",
        "Se lonha ses mal resso.",
        "Aissim venquet sos semblans",
        "Al prim qu'eu vi s'acoindansa,",
        "Que lauzan l'ai enantida ;",
        "E trop lauzars es mentida",
        "Maintas vetz senes doptansa.",
        "Per qu'al repropchier m'acor",
        "Qu'ai auzit dels ancessors,",
        "Qu'a temps vens'om vensedors",
        "E per temps e per sazo",
        "Vencut fan gran vensezo.",
        "Fis amics sui ben amans",
        "Et ai per dreg benenansa ;",
        "Tan bon'aventuram guida,",
        "Que leis qu'a valor complida",
        "M'a mes en bon'esperansa",
        "E m'a trait de mala sort,",
        "Si quel neus mi sembla flors",
        "El glatz jardis e verdors,",
        "Et ai fag per dreit mon pro",
        "Tan quez enrequitz en so.",
        "Tant avetz bon pretz e fort,",
        "Bona domna, que valors",
        "Vos lauza mais que lauzors,",
        "Per qu'eu retrac ma chanso",
        "Novela ab novel so.",
        "Bona domna, neus de por",
        "Sembla la vostra blancors,",
        "E par de rozal colors ;",
        "Qu'aissus fetz Deus de faisso",
        "Que naturai pert razo."
    ],
