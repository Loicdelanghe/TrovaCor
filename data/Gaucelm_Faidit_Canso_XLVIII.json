    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "D'un dot bell plaser ",
    "FullText": [
        "D'un dot bell plaser",
        "plasent",
        "ovon miei cant ver",
        "valent",
        "gient;",
        "car si mos solatz",
        "platz",
        "ben credent,",
        "ni s'ieu be",
        "fas re,",
        "ons me ve,",
        "cui ne soi grasire.",
        "liei desire",
        "si c'alhor",
        "mon desir no vire,",
        "car lieis am e lieis ador",
        "usisc per la meglior.",
        "Sol al sieu voler",
        "m'atent,",
        "car del sieu saber",
        "aprent",
        "sen",
        "on m'es donat",
        "grat",
        "us conoisent.",
        "tant gent me",
        "mante,",
        "ua merce,",
        "car soi bos sofrire,",
        "ce gausire",
        "soi d'amor,",
        "don giausent consire;",
        "et anc a nul amador",
        "on avenc tan de ricor.",
        "E fas so parer",
        "soen,",
        "car del clar dut ser",
        "giausent",
        "pren",
        "consirier amat ",
        "fatz",
        "oi e pauc sofrent,",
        "car en ffre",
        "nos te",
        "boca, per ce",
        "tagn, las, q'ieum n'asire,",
        "can m'albire",
        "sa valor;",
        "effols trop pot dire. ",
        "soi donc fols, s'ieu dic m'onor? ",
        "oc, sel ditz torn' a folor.",
        "Com giam det poder,",
        "enten",
        "q'ieu ages leser",
        "disen",
        "len",
        "os bes cem a dat. ",
        "pat! ",
        "ofren clan las dent. ",
        "not sove,",
        "ce sse",
        "ut, si no cre?",
        "trop potz uer asire ",
        "vollm aucire,",
        "sim socor,",
        "cill cu soi servire?",
        "ni morai, sin dic lausor? ",
        "oc, sil dit nol an sabor.",
        "Ben dei doncs temer",
        "tement;",
        "o leis c'esper,",
        "grasen",
        "ren",
        "ces dels onrat",
        "lat",
        "cem fes present.",
        "e ssap, se",
        "nom ve,",
        "cel cor la remire,",
        "en sospire",
        "de dolor",
        "en trauc greu martire,",
        "car del tornar ai paor",
        "quem tegna per mentidor.",
        "Pot li doncs caler",
        "s'ieu ment? ",
        "hoc, giat vol veser;",
        "vai t'en!",
        "fen",
        "ot altres pensat",
        "nat",
        "cs pensament! ",
        "crer me te",
        "cove;",
        "u duncs, giois mi me",
        "si quen deia rire. ",
        "e not tire,",
        "chanso; cor",
        "tost, ses escondire,",
        "an Sobira, mon segnor,",
        "ui pret pren per valedor.",
        "N'Agout aus eslire",
        "en Plus-avinent, c'ap lor",
        "p bon preiss e valor."
    ],
