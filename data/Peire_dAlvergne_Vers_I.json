{
    "Author": [
        "Peire_dAlvergne"
    ],
    "Genre": "Romance",
    "Title": "Rossinhol, el seu repaire ",
    "FullText": [
        "Rossinhol, el seu repaire",
        "miras ma dona vezer",
        "e diguas lil mieu afaire",
        "et ill diguat del sieu ver,",
        " e man sa",
        " com lestai,",
        "mas de mill sovenha,",
        " que ges la",
        " per nuill pla",
        "b si not retenha,",
        "quades nom tornes retraire",
        "son star e son captener,",
        "quieu non ai paren ni fraire",
        "on tant ho vueilla saber. ",
        " Ar sen va",
        " lauzels gua",
        "reit vas hon ill renha,",
        " ab essai,",
        " ses esglai,",
        "o quen trob lensenha.",
        "Quan lauzeletz de bon aire",
        "sa beutat aparer,",
        "ous chant comenset a braire,",
        "si com sol far contral ser;",
        " pueis se ta",
        " que non brai,",
        "mas de liei sengenha,",
        " col retra",
        " ses panta",
        "o quill auzir denha.",
        " Sel queus es verais amaire,",
        "olc quieu en vostre poder",
        "engues sai esser chantaire,",
        "per so queus fos a plazer.",
        " E sabrai,",
        " quan veira",
        "e vos lentresenha,",
        " queil dirai.",
        " Si ren sa",
        "per quel lai sen fenha,",
        "E sil port per ques nesclaire,",
        "gran gaug en devetz aver,",
        "canc hom no nasquet de maire",
        "tan de beus puesca voler.",
        " lem nira",
        " Em moura",
        "ab gaug, on quem venha...",
        " No farai,",
        " quar non a",
        "qual plag en prenha.",
        "Daisom farai plaideiaire:",
        "quin amor ha son esper,",
        "nos deuria tardar gaire,",
        "tan com lamors na lezer;",
        " que tost cha",
        " blancs en ba",
        "cum flors sobre lenha;",
        " e val ma",
        " quil fag fa",
        "quals lan destrenha. ",
        "m>b)</em",
        "Ben ha tengut dreg-viatge",
        "lauzels lai on el tramis,",
        "et ill enviam mesatge",
        "segon que de mi formis:",
        "  Molt mi platz,",
        " so sapchatz,",
        "ostra parladura;",
        " et aujatz,",
        " quel diguatz,",
        "o don mi pren cura.",
        "Fort mi pot esser salvatge",
        "quar ses lonhatz mos amis,",
        "canc ioi de negun linhatge",
        "no vi que tan mabelis;",
        " trop viatz",
        " fol comiatz,",
        "mas, sieu fos segura,",
        " mais bontatz",
        " nagrasatz:",
        "per quieu nai rancura.",
        "Que tan lam de bon coratge,",
        "cades, seu entredormis,",
        "ab lui ai en guidonatge",
        "oc e ioi e gaug e ris;",
        " elsolatz",
        " cai em patz",
        "no sap creatura,",
        " tan quan iatz",
        " e mos bratz",
        "o ques trasfigura.",
        "Tostems mi fo dagradatge,",
        "pos lo vi et ans quel vis,",
        "e ges de plus ric linhatge",
        "non vueill autraver conquis;",
        " mos cuidatz",
        " es bos fatz;",
        "nom pot far tortura",
        " vens ni glatz",
        " ni estatz",
        "utz ni freidura.",
        "XI",
        "Bon amors ha un uzatge",
        "col bos aurs, quan ben es fis,",
        "que sesmera de bontatge",
        "qui ab bontat li servis;",
        " e crezatz",
        " camistatz",
        "cascun iorn meillura:",
        " meilluratz",
        " et amatz",
        "ui iois saura.",
        "XII",
        "Dous auzels, vas son estatge",
        "miretz, quan venral matis,",
        "e diguatz len dreg lengatge",
        "e qual guiza lobedis. ",
        " Abrivatz",
        " nes tornatz,",
        "trop per gran mezura",
        " doctrinatz,",
        " emparlatz",
        "bonaventura."
    ],
