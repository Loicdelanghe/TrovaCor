{
    "Author": [
        "Taurel"
    ],
    "Genre": "Tenso",
    "Title": "Falconet, de Guillalmona ",
    "FullText": [
        "Falconet, de Guillalmona",
        "us veig enamorat,",
        "el marqes de Monferat",
        "fai pechat qe no laus dona;",
        "q'anc mais tan bon rofian",
        "no vim per menar putan,",
        "ni miels sapcha la via del bordel;",
        "e tain se ben la malsana al mezel!",
        "Molt fo vostra lanza bona,",
        "Taurel; per mon grat,",
        "non fora al desbarat;",
        "qant anavatz vas Cremona,",
        "maint cavallier e vilan",
        "auzizetz de vostra man;",
        "pero pechat non aguest el mazel,",
        "qe totz prumers fugitz vostre vedel.",
        "Falconet, cel qius abeta",
        "non fa qe cortes,",
        "ni la rauba del marqes",
        "nous enconbra la boneta;",
        "oimais pot vostre roncis",
        "anar plus leus pels camis,",
        "e qant seres albergats en Postal,",
        "la noig, siatz segurs de manjar mal.",
        "Non crei qeus don nius prometa,",
        "Taurel, d'aqest mes;",
        "ronciners joglars, plaides,",
        "pron sabetz de la falveta",
        "se ja de Guillem Rentis,",
        "trahetz chavals ni roncis,",
        "anz portaretz armas de mon segnal,",
        "pois donara ad amdos per igal",
        "Lo segners de Tartarona",
        "veig q'es meilluratz:",
        "bastis castels e fossatz,",
        "e guerreja e met e dona,",
        "e rauba ser e matin",
        "las estradas el camin,",
        "e a promes al fol de Gallian",
        "lo palafre del prumer mercadan.",
        "Fe q'ieu deig na Guillelmona,",
        "Taurel, per senat",
        "teingl marqes de Monferat;",
        "ben li taing portar corona,",
        "q'aissi trais sa guerr'a fin",
        "com fetz Rainaltz a Sengrin",
        "qu'ab flansa destruis Passijan,",
        "ma miels conquis l'emperaire Milan."
    ],
