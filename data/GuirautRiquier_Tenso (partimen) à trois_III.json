    "Genre": "Tenso (Partimen)",
    "Title": "An Miquel de Castilho ",
    "FullText": [
        "An Miquel de Castilho",
        "[Guiraut]",
        "Codolen deman",
        "u saber mal o bo",
        "ons a fin ayman,",
        "l fa es&lt;g&gt;art non-chalen",
        "vista de tota gen,",
        "si sela",
        "loy fa de bon grat,",
        "mas res non l'autreya",
        "de so quel guerreya.",
        "Guiraut Riquier, non es bo",
        "[Miquel]",
        "quen amor ay[a] enjan,",
        "us non pot far son pro",
        "ons ab fals semblan,",
        "vos que nom es gen",
        "'amor ni son lag parven,",
        "nil ris fa",
        "es gay biaysat.",
        "Nom play, ans m'esfreya,",
        "amors que guerreya.",
        "Guiraut Riquier, bel e bo",
        "Codole",
        "m'es qu'ieu diga en chantan",
        "mon cor de bela razo",
        "que vos me metetz [denan].",
        "Si midons, qu'es d'avinen,",
        "m'esgarda am fals parven,",
        "lo sela",
        "li prenc ab bon grat,",
        "si tot s'esdesleya",
        "amors quem guerreya.",
        "Jes damor no sabetz p&lt;ro&gt;,",
        "Guiraut Riquier",
        "'ans dizetz falhimen gran,",
        "Miquel, e no sabetz co,",
        "qu'ieu res d'aco nous deman.",
        "Codolet falh yssamen,",
        "[pero] non tan laiamen,",
        "car lauza",
        "m'a l'esgart privat,",
        "mas res nom despleya",
        "del deman que deya.",
        "Yeu vos ay dita razo,",
        "Miquel",
        "Guiraut, segon mon senblan,",
        "vos metetz mi tenso",
        "b vostr'engenh c'avetz gran,",
        "qu'ieu parli pron, qu&lt;i&gt; m'enten,",
        "man c'aysi conten.",
        "Si l'ama",
        "nol a joy donat,",
        "de leys cuy enveya",
        "ben laus ques re&lt;c&gt;reya.",
        "Guiraut Riquier, oc e no",
        "Codole",
        "vos puesc dir al meu semblan,",
        "mays er ay chauzit mon pro",
        "o c'anatz demandan:",
        "s fis aman que s'enten",
        "pros dona conoysen,",
        "qu'esgarda",
        "l'aya per privat,",
        "de fin cor l'autreya",
        "lo joy quel guerreya.",
        "Miquel, ab razonar gen",
        "Guiraut Riquier",
        "uiatz cobrir falhimen,",
        "el falha",
        "Codolet vertat,",
        "mays lo Viguier veya",
        "d'ams cal pus fadeya.",
        "Guiraut Riquier, nom repen",
        "Miquel",
        "per vostre blasmar soven,",
        "ni falsa",
        "non ay lo dictat,",
        "mas mon cor s'autreya",
        "al Vygier c'o veya.",
        "Per l'onrat Vigier valen",
        "Codole",
        "vuelh venir a ensenhamen,",
        "c'al falha",
        "dig&lt;u&gt;a escac mat,",
        "Guiraut, e que veya",
        "de nos cal fadeya."
    ],
