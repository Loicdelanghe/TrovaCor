    "Genre": "Sirventes",
    "Title": "Un trichaire ",
    "FullText": [
        " Un trichaire",
        " Pstre laire",
        "Vl que chant, pus sui chantaire.",
        " Cossiraire",
        " Mal pessaire",
        "Serai del chant tro l'esclaire.",
        " De Sensaire",
        " Tro Belcaire",
        "A cercat lo galaire,",
        "Trichant cum fl prezicaire :",
        "Facha s'a'l corona raire.",
        " Rogier fraire,",
        " Colom vaire,",
        "Per vos vuelh un sonet braire.",
        " No prs gaire",
        " Mon vejaire",
        "Si vertat no'us puesc retraire.",
        " Anc bilhaire",
        " Vstre paire",
        "Non issic tal coart d'aire.",
        "Per tot dizon qu'tz bauzaire",
        "Contra'l servizi Dieu faire.",
        " La mesquina",
        " Flaira e grina,",
        "Que maistre Rogier enclina,",
        " Tan festina",
        " E s'aisina",
        "Tro sent la douor conina ;",
        " De s'orina",
        " Fai mezina,",
        "E'l con non cessa ni fina,",
        "Qu'en la ciutat peitavina",
        "Se rompt fotent l'esquina.",
        " Disciplina",
        " Fai en tina,",
        "Quan la pt tener sobina",
        " Ab sa pina",
        " Qu'el trana",
        "Josta la coa seguina,",
        " Sa cosina",
        " Vl vezina",
        "Mais que'l mar Santa Crestina,",
        "Qu'ab son grat ser ni matina",
        "Sos viechs non es ses gana.",
        " Res aurana",
        " Dieus engana",
        "Cum desfaa'l lei romana,",
        " Crestana",
        " Fot sotz vana",
        "Quaranta vetz la setmana.",
        " Que vilana",
        " Tenc Guiana",
        "Si la colha non l'aplana.",
        "Quan ditz sa leon trefana",
        "Sembla mula quan regana.",
        " A Serana",
        " Par Vana",
        "Fon pres ab una putana.",
        " D'aital mana",
        " Cerqut Trana,",
        "Sur e Bar e Corrozana.",
        " Pueis de Grana",
        " La mejana",
        "Tornt en Valh Sotirana,",
        "Fotent per terra d'Ossana,",
        "Qu'anc non la vi mas aurana.",
        " ai venc savis",
        " Colhons blavis",
        "Per saber quals es peitavis.",
        " Anc clergavis",
        " Ni gramavis,",
        "Sarrazins ni Amoravis,",
        " Non donavis",
        " Tals culavis",
        "Dessobre frt de cons cavis.",
        "Rogier, grieu auretz bons avis",
        "Si la colha no'us tl clavis."
    ],
