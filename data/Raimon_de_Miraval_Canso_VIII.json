{
    "Author": [
        "Raimon_de_Miraval"
    ],
    "Genre": "Canso",
    "Title": "Lonc tems ai agutz consiriers ",
    "FullText": [
        "Lonc tems ai agutz consiriers",
        "De maintas guizas et afars",
        "C'anc mos solatz ni mos chantars",
        "Non mermet ni mos alegriers.",
        "Mas er ai camjat uzatge ;",
        "Aissi m'a desviat Amors",
        "C'a penas chans ni tems ni flors",
        "Mi pot donar alegratge.",
        "Si d'amor mi ven destorbiers,",
        "No m'en tanh clams ni rancurars ;",
        "Que denan era mieus l'esguars,",
        "Et ieu de totz mos deziriers",
        "Ai segut lo plus salvatge ;",
        "Que ves tal don'ai mos precs sors",
        "Quel joi, que marves preir'aillors,",
        "Aten de lieis ses tot gatge !",
        "E conosc qu'i fauc que leugiers ;",
        "Mas beutatz, don mais sobramars,",
        "E l'acuillirs el douz parlars",
        "El rics pretz, qu'es a totz sobriers,",
        "M'an mes en aquest viatge,",
        "Don ieu meteis sai qu'es folors",
        "Mas foudatz vai entr'amadors",
        "Per sen e sens per folatge.",
        "Vers es qu'en autres cavaliers",
        "Pot cauzir e qu'ieu noill sui pars ;",
        "Tant es sos pretz valens e cars.",
        "Mas tant ha d'avinens mestiers",
        "C'obs es qu'el sieu senhoratge",
        "Ai' un dels adreitz trobadors,",
        "Oue sapch' enansar sas lauzors",
        "Eill serva de bon coratge.",
        "Molt li servirai volentiers,",
        "E si tot noill platz mos preiars,",
        "Ja nous cuidetz queill si'avars",
        "En faitz ni en digz plazentiers.",
        "C'al sieu menoret mesatge",
        "Volria far tan grans honors",
        "C'al plus ric de totz mos senhors",
        "Non fis tant per homenatge.",
        "Dona, la dousors dels vergiers",
        "Es era vengud'el tems clars,",
        "Don totz lo mons es vertz e vars",
        "E paron las flors els roziers.",
        "Hueimais devon far barnatge",
        "Celas, c'an leials preiadors",
        "E contrals mais castiadors",
        "Demostrar lor vasalatge.",
        "Chanso, ton premier viatge",
        "Faras vas n'Azalais de cors ;",
        "Quar si pueis vols anar aillors,",
        "Plus en seras d'agradatge.",
        "Don', el vostre senhoratge",
        "S'es mes Miravals e m'amors",
        "E nous hi cal plus gardadors",
        "Mas un cordo per guidatge.",
        "Mantel, s'ieu ai fag folatge,",
        "Quar ai chauzit en las gensors,",
        "En cela, que mais vol valors,",
        "A tort en penrai dampnatge !"
    ],
