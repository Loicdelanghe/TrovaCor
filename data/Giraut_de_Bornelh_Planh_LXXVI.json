{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Planh",
    "Title": "S'anc jorn agui joi ni solatz",
    "FullText": [
        "Sanc jorn agui joi ni solatz,",
        "  Er sui iratz",
        "E per totztems dezesperatz;",
        "Car maventura nom retra",
        "  Ja cobre jai,",
        "Cades me desfui em trasvai,",
        "Queram repairal consirers,",
        "Quem fetz ja doler, dams ladrers.",
        "Car entraspres cre que fui natz",
        "  Ca Deu no platz",
        "Que nuls mos bos amics privatz",
        "Viva tan com laltra gens fai;",
        "  Aissi mescha",
        "Per mo Linhaure quenoi nai,",
        "Pos Mos-Jois me falhi primers,",
        "En cui comenset lencombrers.",
        "Mas eram alques conortatz",
        "  Com om forsatz,",
        "Car vos, Linhaures, mamavatz;",
        "Mas eram desconortarai,",
        "  Car nous veira",
        "Ni ja mais nom venran de la",
        "Salutz ni cortes messatgers,",
        "Don jois me sol venir enters.",
        "A! bels amics ben ensenhatz,",
        "  Nescis als fatz",
        "E drechs e savis als membratz,",
        "Per vos tenh vil abril e ma",
        "  El dolz tems ga",
        "Ni ja mais no malegrara",
        "Ni no chantarai volonters,",
        "Mas nous posc be planher esters!",
        "A! tans bels sabers en portatz,",
        "  Cun non laissatz!",
        "Ja mais vostre pars ner trobatz?",
        "Canc no vi ni ja no veirai,",
        "  Tan non irai,",
        "Dun sol ome tan bel assa",
        "Ni no deu dire chavalers",
        "Que tans en agues olivers!",
        "Eres morta bela foldatz",
        "  E jocs de datz",
        "E dos e domneis oblidatz.",
        "Per vos se pert pretz e dechai;",
        "  Trol port Vela",
        "Man pro esdevenran savai,",
        "Cui vos fotz guitz e companhers",
        "E melhs apres de bos mesters.",
        "Dels vostres trobars esmeratz,",
        "  De las bontatz,",
        "Del pretz, del sen, de las rictatz",
        "En degran esdevenir ja",
        "  Celh cui peitz vai.",
        "Ja dels vostres bes nom gicra",
        "Quel bos maestres Berengers",
        "En ressemblera lauzengers!",
        "Ja dizon que per vos sestra",
        "Proensa de fachs galaubers,",
        "Cus lai no nes tan fazenders!",
        "Mos Sobre-Totz, sim fos acers,",
        "Lo cor sem degra far carters!"
    ],
