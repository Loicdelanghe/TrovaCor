{
    "Author": [
        "GaucelmFaidit",
        "Perdigon"
    ],
    "Genre": "Tenso (Partimen)",
    "Title": "Perdigon, vostre sen digatz",
    "FullText": [
        "Perdigon, vostre sen digatz :",
        "qe-us par de dos maritz gelos ?",
        "uns ha moiller qes bell e pros,",
        "francha, cortesa e chausida ;",
        "autres, laida e marrida,",
        "vilana, e de brau respos ;",
        "qecs es gardaire damdos ",
        "pois tant fols mestiers lor platz",
        "or voluntatz,",
        "u esser meins blasmatz ?",
        "Gaucelm Faidit, ben vuoill sapchatz",
        "que, de dompn ab bellas faissos",
        "on totz lo mons es envejos,",
        "qui la, pres de si, aizida,",
        "on fai ges tant grand faillida,",
        " e nes cobeitos,",
        "um lautres desaventuros,",
        "qes tant de totz mals aips cargatz,",
        "qen gardar no-l forssa beutatz,",
        ", mas laidesa e cors fatz.",
        "Perdigon, en fol razonatz !",
        "um auzetz anc dire vos",
        "om tenga so qes bel rescos,",
        "op dompn eissernida,",
        "bella, de valor complida ?",
        "oncs no la garda sos sens bos ?",
        "Mas la laid ab digz enoios",
        "u gardar lo maritz senatz,",
        "om non conosca sas foudatz,",
        "um el es mal moilleratz.",
        "Gaucelm, entre-ls nescis, agratz",
        "obert blasme vergoignos ;",
        "pero mal conseillatz lespos,",
        "qan dizetz caja tal vida",
        "qe gart sa malescarida",
        "fassa dun malastre dos ;",
        "mieils a de gardar ochaizos",
        "bona dompn on es grans beltatz,",
        "on par com sia enamoratz,",
        "u esser meins encolpatz.",
        "Perdigon, on plus en parlatz,",
        "plus desmentetz vostras chansos,",
        " que gelosies fols ressos,",
        "on totz lo mons brai e crida, ",
        "qe hom gart dompn grazida,",
        "z blasmes entre nos ;",
        "mas lautres gardars es razos,",
        "osia, e sens prezatz,",
        "quom resconda so ques malvatz,",
        "mostre so don es honratz.",
        "Gaucelm, savol aver gardatz",
        "avol aver etz poderos,",
        "o-m par ges sens cabalos",
        "qui pretz pert, ni joi oblida,",
        "per malvasa caus aunida ;",
        "mas qui, per bel aver joios,",
        "faill e sen espert a sazos,",
        "amor par que sia forsatz ;",
        "aiso-us meravillatz",
        "be-m meravill si vos amatz !",
        "Totz temps duraria-ill tensos,",
        "Perdigon, per qieu vuoill e-m platz",
        "qal Dalfin sia-l plaitz pauzatz,",
        "qe-l jutge, o-ns acord en patz.",
        "Gaucelm, tan es vera-il razos",
        "qieu deffen, et el tant senatz,",
        "qe, sa lui es lo plaitz pauzatz,",
        "vuoill que per lui sia jutjatz."
    ],
