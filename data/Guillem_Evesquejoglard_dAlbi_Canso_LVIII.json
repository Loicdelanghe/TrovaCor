{
    "Author": [
        "Guillem_Evesquejoglard_dAlbi"
    ],
    "Genre": "Canso",
    "Title": "Valors e beutatz e dompney ",
    "FullText": [
        "Valors e beutatz e dompney . . .",
        ". . . . . . . . . . .",
        ". . . . . . . . . . . . .",
        "quem fai penar ab greus turmens",
        "style=\"margin-left: 80px;\">lo cor em vens,",
        "be's dregz quel sia fis sufrens;",
        "e non a cor quem porte bevolensa",
        "ni ylh no vol me per son amador. ",
        "las, en trop aut luec chauzi per amor!",
        "En aut loc chauzi a mon dan,",
        "style=\"margin-left: 80px;\">si merceyan",
        "style=\"margin-left: 80px;\">midons nom val,",
        "quar merce deu trobar preyan",
        "style=\"margin-left: 80px;\">tot fin aman",
        "style=\"margin-left: 80px;\">ab cor coral,",
        "cum yeu sui, et ab gran doussor,",
        "style=\"margin-left: 80px;\">senes error.",
        "us que Floris ab Blancaflor",
        "suy eu amans de midons ses fallensa;",
        "et ylh no vol mi per son amador; ",
        "las, en trop aut loc chauzi per amor!",
        "Mas si al ondrat cors prezan",
        "style=\"margin-left: 80px;\">belh ben estan",
        "style=\"margin-left: 80px;\">de mi no cal,",
        "on guay cors prezan,",
        "style=\"margin-left: 80px;\">que puey seblan,",
        "style=\"margin-left: 80px;\">si dieus mi sal,",
        "om fes d'amar ni n'ac sabor;",
        "style=\"margin-left: 80px;\">don ai temor",
        "'arma en sia en tristor",
        "(e volgra mais m'arma n'agues sufrensa),",
        "que, quar no vol mi per son amador,",
        "las, en trop aut loc chauzi per amor!",
        "Amors mi pot enamorar",
        "style=\"margin-left: 80px;\">lo gent cors car",
        "style=\"margin-left: 80px;\">a plazent port",
        "ons, e leu acordar",
        "style=\"margin-left: 80px;\">ses mal estar",
        "style=\"margin-left: 80px;\">el dreg d'acort",
        "oy d'amor, quel vengues",
        "style=\"margin-left: 80px;\">totz sieus sotzmes,",
        "untas, e m'agues merces;",
        "e si nom val, ma mort vey quel agensa.",
        "quar ylh non vol mi per son amador,",
        "las, en trop aut loc chauzi per amor!"
    ],
