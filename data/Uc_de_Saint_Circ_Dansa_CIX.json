{
    "Author": [
        "Uc_de_Saint_Circ"
    ],
    "Genre": "Dansa",
    "Title": "Una danseta voil far ",
    "FullText": [
        "Una danseta voil far,",
        "Jogan, risen,",
        "De Ma Vida, cui Dieus gar",
        "Son gentil sen,",
        "A queil farai alegrar",
        "Son cor dolen.",
        "Ab dous chan,",
        "En dansan,",
        "Voil que sanes conortan,",
        "Baratan",
        "E trichan",
        "Las domnas e galian.",
        "Sos bons sens li fai canjar",
        "Alberg soven:",
        "Car es venguz sai estar",
        "E vai qeren",
        "Autra que puesc enganar",
        "Caja argen.",
        "Ab dous chan &amp;c.",
        "Mantoana e Verones,",
        "Perdut lai,",
        "E Trevise Senedes",
        "Atresi sai;",
        "E, sel perc Visentines,",
        "Ol menerai?",
        "Ab dous chan &amp;c.",
        "En Alvergne et en Fores",
        "Et en Veslai,",
        "Lai on no sabon qi ses",
        "Nils trag qel trai;",
        "Pueis me trai len Vianes,",
        "A Anonai.",
        "Ab dous chan &amp;c."
    ],
