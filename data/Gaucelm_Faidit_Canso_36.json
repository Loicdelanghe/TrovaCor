{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Lonratz, jauzens sers ",
    "FullText": [
        "Lonratz, jauzens sers,",
        "on ab bela parvenssa,",
        "enc mos Bos Espers",
        "gen complir mentendenssa,",
        "mi torn en plazers",
        "ab doussa sovinenssa,",
        "e-m fai chansos faire,",
        "on mi cujav estraire ;",
        "car ben es razos",
        "qieu chant, gais e joios,",
        "pois cill cui sui amaire,",
        "ques la genser canc fos,",
        "vol me e mas chansos.",
        "Qe-l sieus gentils, pros",
        "cos cortes, de bon aire,",
        "francs e cars e bos,",
        "humils e daut afaire,",
        "e lhuoill amoros,",
        "mi saubon gen atraire",
        "as sa benvolensa,",
        "on soplei vas Proenssa ;",
        "man tan aut aders",
        "qe rics sui et enders,",
        "sol ca nostra plazenssa",
        "sia complitz lezers,",
        "que no-i failla poders !",
        "Car adreitz sabers",
        "e valens conoissenssa,",
        "et homils parers",
        "e pretz ab gran valenssa,",
        "honratz, gens teners,",
        "son en lieis, on magenssa",
        "ui gais chantaire",
        "per sa valor retraire ;",
        "e grazisc los dos",
        "e-ls plazers saboros,",
        "e lafan qe-il vi traire",
        "al greu comjat doptos",
        "ospirs angoissos.",
        "Per qe i taing perdos,",
        "car tarziei pauc ni gaire,",
        "que, vas lieis coitos,",
        "non vinc en son repaire,",
        "on de genoillos",
        "li sui leials prejaire",
        "que Merces la venssa,",
        "e-m perdon la faillenssa ",
        "conors ni jazers,",
        "ni prejars ni valers",
        "no-m tenon en bistenssa :",
        "oncs no-il sia temers",
        "qe-is camje mos volers.",
        "Pero, si-l movers",
        "queu fau per penedenssa,",
        "lai on Dieus lo vers",
        "pres veraia naissenssa,",
        "les al cor dolers,",
        "no-il deu aver tenenssa ",
        "ca tot bon vejaire,",
        "es de tot pretz lo maire",
        "qui sans, deleitos,",
        "ai al Rei glorios",
        "servir, qui les Salvaire ;",
        "qel cel, e sai jos,",
        "ner rics lo guizerdos !",
        "Oimais es sazos",
        "anaronDieuslo paire,",
        "qi pres mort per nos,",
        "si anoschapdelaire,",
        "ez als compaignos",
        "qi son nostre cofraire",
        "per obediensa,",
        "aid er me lor crezensa",
        "els cors els avers,",
        "cares sosservirsders ;",
        "teinha en sa prezensa",
        "e-il sia douz vezers",
        "affanzdels mals poders !",
        "Na Maria, vos",
        "etz tant bella, e pros,",
        "que non es emperaire",
        "el mon que non fos",
        "onratzpels vostres dos."
    ],
