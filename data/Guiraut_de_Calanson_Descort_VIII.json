    "Genre": "Descort",
    "Title": "Ab la verdura ",
    "FullText": [
        "Ab la verdura",
        "Del temps qui meillura",
        "Per bon aventura",
        "Mi pren ades cura",
        "De joi e damor ;",
        "Car quis rancura",
        "Ni trop mal saura,",
        "Totz temps li pejura ;",
        "Doncs sieu ai ardura",
        "Cobri ma dolor",
        "E mostr el gaug e rescondi lo plor.",
        ". . . . . . .",
        "Quel fassa centura",
        "Sotz sa vestedura",
        "De mos bratz, mas dura",
        "Mes del joi meillor,",
        "Don ai frachura.",
        "Mas pos masegura",
        ". . . . . . .",
        "Mos cors que satura",
        "Que nom vir aillor ;",
        "Car trop es grieu qui perlonga labor",
        "Preisan",
        "Ploran,",
        "Quans a perduda sa vida",
        "Cercan",
        "Mudan",
        "Cautra noll es escarida.",
        "Mas dan",
        "Noi blan",
        "Car si tot no mes aizida,",
        "Pensan",
        "Nai tan",
        "Cautra no mes encobida.",
        "E so quen a",
        "Ten mon cor gai,",
        "Per so car sa",
        "Quel mon non a plus chausida ;",
        "E doncs, sil plai,",
        "Tollam desma",
        "Ab joi vera",
        "E senes tota gandida.",
        "Quar seum f",
        "En sa bella semblansa",
        "Membres l",
        "Sol de la benenansa ;",
        "Si mauc",
        "Sera desmesuransa ;",
        "Quen aiss",
        "Ai en leis mesperansa",
        "Con pelegr",
        "Outramar",
        "Crezon en lom de perdonansa ;",
        "Donc sels es",
        "Anc mala",
        "Mon Sen ni sa gaia semblansa ?",
        "Mas non crei mia",
        "De ma dous amia",
        "Que tan mala sia",
        "Quem laisses morir,",
        "Cab bon seignor se deu om enriquir.",
        "E sieu navia",
        "So que plus volria,",
        "Ja mais non auria",
        " De mort nuill consir,",
        "Ni pueis nuill mal nom poiria avenir ;",
        "E sim crezia,",
        "Ja mais nom calria",
        "Faire romaria",
        " Per marma guerir,",
        "Sol que maizis so queu plus en desir.",
        "Mas del vezer",
        "Non ai poder",
        "Soven",
        "Que mon coragel dia ;",
        "E qui de ser</em",
        "Part son voler",
        "Fugen,",
        "Greu cobra pueis el dia ;",
        " Doncs sieun esper",
        "Loc de lezer",
        "Sufren,",
        "Ma dousa car amia,",
        "Ja pueis doler",
        "Per noncaler",
        "Nom ren,",
        "Nim fezes, sius plazia ;",
        "Car sitot non ai lo dever,",
        "Con de vos prezatz sia,",
        "Fin amor majud a valer :",
        "Per totz jorns me castia",
        "Que nom vire</em",
        "Nim nare,",
        "Car bos sufrire",
        " Es leu gauzire",
        "Ab le rire",
        "Prenden,",
        "  Sieu consire.",
        "Mais nattire,",
        " Mi dons, martire",
        "Ab greu dezire,",
        "Can remire",
        "Vezen",
        "Vostre cors, que deus conquerer.",
        " Car Amors mo afia,",
        "Dompn, ab merce voil remaner",
        " En vostra seignoria :",
        "Cunz de comensar ses aver</em",
        " En vos creis chascun dia."
    ],
