    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Lo gens cors honratz ",
    "FullText": [
        "Lo gens cors honratz,",
        "complitz de grans beutatz,",
        "e lieis que plus magenssa",
        "e qe mais mi platz,",
        "on es plazens solatz",
        "e franch humilitatz,",
        "e doussa captenenssa,",
        "e gais pretz prezatz,",
        "mi fai chantar soven,",
        "ses so quil non consen",
        "qieu ja-n sia jauzire",
        "aver joi plazen ;",
        "ni de lieis non aten",
        "mas lenvej e-l desire",
        "qai del sieu cors gen,",
        "utre jauzimen.",
        "Per aisso li-m ren",
        "far son mandamen;",
        "e si-s vol, pot maucire,",
        "qieu no li-m defen ;",
        "pero be mes parven",
        "que fos plus avinen,",
        "car li sui francs sofrire",
        "e lam finamen,",
        "que fos sa voluntatz",
        "qe-il plagues mamistatz,",
        "si cab doussa parvenssa",
        "men fos jois donatz,",
        "anz que fos car compratz ;",
        "qenaissi, ses faillenssa,",
        "fora-l dos e-l gratz",
        "obles doblatz.",
        "E pois auziratz",
        "gais sons enamoratz,",
        "e fina benvolenssa,",
        "si-n fos gent pagatz ;",
        "mas, pels vilans baratz",
        "els fals prejadors fatz,",
        "ei metr en mescrezenssa",
        "e mal encolpatz",
        "cels qamon francamen !",
        "per qeu prec doussamen",
        "midonz, cui sui servire,",
        "amar leialmen ",
        "cautrui galiamen",
        "en dampnatge no-m vire,",
        "qa dreig jutjamen",
        "ortz si mal men pren.",
        "Dautre faillimen,",
        "reignon vilanamen",
        "ompnas, per qie-m nazire",
        "e las en repren,",
        "qe, suna a drut valen",
        "adreich ni conoissen",
        "on puosc om gran ben dire,",
        "greu er longamen",
        "car tengutz ni amatz ;",
        "mas us mal enseignatz,",
        "ab gran desconoissensa,",
        "er seigner clamatz !",
        "qie-n sai de rics malvatz,",
        "senes tota valensa,",
        "en aut loc pojatz,",
        "maniers e privatz.",
        "Tant nes pretz baissatz",
        "qie-n fora plus iratz,",
        "mas per lieis nai tenensa",
        "e-m tenc afrenatz",
        "a cui non plai foudatz,",
        "ni faitz desmesuratz,",
        "ni malvaz entendenssa,",
        "ni avols percatz.",
        "Tant val, qie-m nespaven",
        "e nai meins dardimen",
        "per lieis, qan be-m cossire",
        "son afortimen ;",
        "si merces no-i dissen,",
        "pro ai de que sospire,",
        "qen als no-m nenten",
        "o cor ni-l sen.",
        "Per quad escien",
        "cobri mon marrimen",
        "e sai de mon dan rire",
        "amorosamen ;",
        "e, sagues cor jauzen,",
        "saubra-l celadamen",
        "grazir et escondire",
        "qen luoc, per un cen,",
        "al gen mentirs assatz",
        "mais qe folla vertatz,",
        "e mais genta suffrensa",
        "corguoills eslaissatz ;",
        "qieu nai vist, so sapchatz,",
        "enir mainta eschasenssa",
        "e rics dos honratz",
        "per gen sofrir en patz.",
        "Dompnab finas beutatz,",
        "pros e de gran valensa,",
        "Na Maria, gratz",
        "os es tals dos donatz",
        "que, segon ma crezenssa,",
        "os vei acordatz",
        "otz, los pros e-ls malvatz.",
        "Dels bels digz honratz",
        "bens dirs es vertatz."
    ],
