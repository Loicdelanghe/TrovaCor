    "Genre": "Canso",
    "Title": "Pois preyatz me, senhor ",
    "FullText": [
        "Pois preyatz me, senhor,",
        "queu chan, eu chantarai ;",
        "e can cuit chantar, plor",
        "a lora co essai.",
        "greu veiretz chantador,",
        "be chan, si mal li vai.",
        "ai me doncs mal damor ?",
        "ans melhs que no fetz mai !",
        "e doncs, per que mesmai ?",
        "Gran ben e gran onor",
        "conosc que Deus me fai,",
        "queu am la belazor",
        "et ilh me (queu o sai).",
        "mas eu sui sai, alhor,",
        "e no sai com lestai !",
        "so mauci de dolor,",
        "car ochaizo non a",
        "e soven venir lai.",
        "Empero tan me pla",
        "can de leis me sove,",
        "que quim crida nim brai,",
        "eu non au nula re.",
        "tan dousamen me tra",
        "la belal cor de s,",
        "que tals ditz queu sui sai,",
        "et cuid, et o cre,",
        "que de sos olhs nom ve.",
        "Amors, e quem farai ?",
        "si guerrai ja ab te ?",
        "ara cuit quen morra",
        "el dezirer quem ve,",
        "silh bela lai on ja",
        "no maizis pres de se,",
        "queu la manei e ba",
        "et estrenha vas me",
        "so cors blanc, gras e le.",
        "Ges damar nom recre",
        "per mal ni per afan ;",
        "e can Deus mi fai be,",
        "nol refut nil soan ;",
        "e can bes no mave,",
        "sai be sofrir lo dan,",
        "ca las oras cove",
        "com san entrelonhan",
        "per melhs salhir enan.",
        "Bona domna, merce",
        "el vostre fin aman !",
        "queus pliu per bona fe",
        "canc re non amei tan.",
        "mas jonchas, ab col cle,",
        "os mautrei em coman ;",
        "e si locs sesdeve,",
        "os me fatz bel semblan,",
        "que molt nai gran talan !",
        "Mon Escuder e me",
        "on Deus cor e talan",
        "camdui nanem truan ;",
        "Et el en men ab se",
        "so don a plus talan,",
        "et eu Mon Aziman !"
    ],
