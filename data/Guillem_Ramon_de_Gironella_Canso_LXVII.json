{
    "Author": [
        "Guillem_Ramon_de_Gironella"
    ],
    "Genre": "Canso",
    "Title": "Pos l'amors s'ensen ",
    "FullText": [
        "Pos l'amors s'ensen",
        "quel cor me destrencha,",
        "quan no men defen",
        "sill a cui m'aten,",
        "c'ab petit d'aiuda",
        "m pot leu far iauzen",
        "ab gentil semblan d'amia,",
        " e se i dic fulia",
        "ni ergueill,",
        "ia repres non sia,",
        "c'ades men tueill. ",
        "Si<sup>.</sup>l gai covinen",
        "no<sup>.</sup>m franh ni destrencha,",
        "queill vau als quiren?",
        "ar diran rizen",
        "qu'ill aital aiuda",
        "nom fes anc per sen;",
        "per merce, sill platz, n'estia!",
        " e se i dic fulia",
        "ni ergueill,",
        "ia repres non sia,",
        "c'ades men tueill. ",
        "Pos del pensamen",
        "quim fen em destrencha,",
        "no sai com m'esten,",
        "irai folamen",
        "cridan: dieus, aiuda!",
        "qu'ill m'ausi languen,",
        "s'ar nom blan sa senhoria.",
        " e se i dic fulia",
        "ni ergueill,",
        "ia repres non sia,",
        "c'ades men tueill. ",
        "La pena qu'ieu sen,",
        "plus fort mi destrencha",
        "que no fes parven,",
        "quar selan sufren",
        "deziran s'aiuda",
        "m'agreuial turmen.",
        "ai! Tan leu men lauzaria!",
        " e se i dic fulia",
        "ni ergueill,",
        "ia repres non sia,",
        "c'ades men tueill. ",
        "Ges nom n'espaven,",
        "si tot mi destrencha,",
        "tan l'am finamen",
        "c'al sieu pretz valen",
        "querrai men aiuda,",
        "car m'esiau . . . . ."
    ],
