    "Genre": "Sirventes",
    "Title": "... [a]pellatz | heretge que non jura",
    "FullText": [
        ".......... [a]pellatz",
        "heretge que non jura",
        "...........................",
        "[d'] engan e de falsura",
        "...........................",
        "la sainta escriptura",
        "...........................",
        "[l]aidamen, ses mesura",
        "...........................",
        "et deuria confondre",
        "............... gran",
        "que non lo potescondre",
        "...........................",
        "que noi denhon respondre",
        "...........................",
        "nol pot raire o tondre",
        "...........................",
        ".........................",
        "cela falsa clergia",
        "...........................",
        "ni la Verge Maria",
        "...........................",
        "son pejor cascun dia",
        "......... que los cre",
        "ni que en lor se fia",
        "...... voig de merce",
        "... son ple de folor",
        "e d'orguelh e d'ufana",
        "... nostre pastor",
        "de la gleiza romana",
        "e son fals etrachor</em",
        "ves la gent crestiana",
        "........... entre lor",
        "ab volontat trefana",
        "... trop mal labor",
        "... mal labor fan tug",
        "en digz et en parvensa",
        "[a]quil gasta-condug,",
        "filhols de descrezensa :",
        "que lialtatz s'en fug",
        "e vera penedensa ;",
        "en lor troban redug",
        "tug mal e mantenensa,",
        "e tug ben son destrug"
    ],
