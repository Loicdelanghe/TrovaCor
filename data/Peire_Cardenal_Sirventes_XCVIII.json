{
    "Author": [
        "Peire_Cardenal"
    ],
    "Genre": "Sirventes",
    "Title": "Maint baro ses lei ",
    "FullText": [
        "Maint baro ses le",
        "oloiros sava",
        " sai,",
        "que, can eu lo vei,",
        "a mi desplai,",
        " ai!",
        "'un gran malavei.",
        "per que no sen va",
        " la",
        "onn'aten plaidei,",
        "trop malvas issa",
        " fai.",
        "Mortz, que los plazens",
        " prens",
        "els proz els prezanz",
        " tans,",
        "els malvas dolens",
        " lens",
        "messongieirs truans",
        " blans,",
        "non es chauzimens",
        " gens;",
        "ans es dols e dans",
        " grans,",
        "qui cortezas gens",
        " vens",
        "els crois sofre tans",
        " ans.",
        "Que puesc dire,",
        "can mentire",
        "si fai apelar",
        " bar,",
        "escharnire",
        "ab dezire",
        "e tot mal istar",
        " far?",
        "can cossire",
        "e remire",
        "lo fait el parlar",
        " var,",
        "eu arbire",
        "que traire",
        "lai pot encontrar",
        " par."
    ],
