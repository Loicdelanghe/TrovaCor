{
    "Author": [
        "Guionet",
        "Cadenet"
    ],
    "Genre": "Tenso (Partimen)",
    "Title": "Cadenet, pro domna e gaia ",
    "FullText": [
        "Cadenet, pro domna e gaia",
        "pregan dui fin amador,",
        "e leis non platz que drut aia,",
        "per que lus pert sa valor,",
        "quera pros, tan greus pensansa",
        "len ven, car non es jauzens.",
        "lautren meillur et enansa,",
        "quera enans recrezens.",
        "gatz m, al vostrescien :",
        "quals ama plus finamen ?",
        "Guionet, cel que sesmaia",
        "tant qen pert pretz e valor",
        "per leis ques pros e veraia,",
        "que nol ten a servidor,",
        "ama meils, noi ha doptansa :",
        "que sapchatz quel pesamenz",
        "li tol tota la membransa",
        "e sos bels captenemens,",
        "que tant pliul cor el talen",
        "mor coblidal sen.",
        "Cadenet, sieu vos dizia",
        "que conogut vos avetz,",
        "eu sai ben queu failliria",
        "atressi cum vos failletz ;",
        "car, sieu quec jorn peiurava,",
        "oncs queria ieu son dan",
        "e midons, sieu la preiava.",
        "onc non ama sidons tan",
        "cel cades es plus savais",
        "om cel qui totz jorns val mais.",
        "Guionet, si retenia",
        "la bella cel qui pert pretz.",
        "en sa valor tornaria",
        ". . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . .",
        "cel ques avols, tant ni quan,",
        "ja nous cujetz queill menbrava",
        "e pretz plus qua un enfan ;",
        "el pros es fels quant sirais,",
        "espert, non pot mais.",
        "Cadenet, senaisi era,",
        "com fos per esser malvatz",
        "rutz, ja mais hom non penssera",
        "e ren, mais de malvestatz ;",
        "car qui non puingna que vailla",
        "mais quenans non a valgut",
        "sos pretz, cujatz que non failla",
        "omna, sil reten per drut ?",
        "si fai, car non ama be,",
        "per leis meils nois capte.",
        "Guionet, ja non laissera",
        "son pretz lo pros nil prezatz ;",
        "ans sapchatz que meillurera ;",
        "mas del tot es oblidatz,",
        "sil turmenta el trebailla",
        "Amors, que de so vengut",
        "li son tuit sei faig, ses failla,",
        "on el mais non a pogut,",
        "quom enamoratz no ve",
        "u ni enten fort be."
    ],
