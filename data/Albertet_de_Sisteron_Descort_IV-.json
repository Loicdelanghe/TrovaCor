{
    "Author": [
        "Albertet_de_Sisteron"
    ],
    "Genre": "Descort",
    "Title": "Bel m'es oimais ",
    "FullText": [
        " Bel m'es oimais",
        "ab la douza sazon gaia",
        " qe sia gais",
        "e q'un gai descort retraia,",
        " c'uns iois verais",
        "m'alegral cor et apaia,",
        " qim ven e nais",
        "e lei cui ioi e ben aia.",
        " Per q'eu voil faire",
        "e dir e retraire,",
        " si com fis amaire,",
        "tot quant a lei plaia ;",
        " c'al meu veiaire",
        "bell'e de bonaire",
        "es, e noil platz gaire",
        "avols gentz savaia ;",
        " ni lauzeniaire",
        "lan[s] mal parlaire",
        "no pot dir ni braire :",
        "es de null repaire.",
        ". . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . .",
        "Tal ioi don m'esclaire",
        "voilla Dieu[s] q'eu n'aia :",
        " q'e mos braz la tegna",
        " un ser a ma guiza",
        " e ver mi l'estregna",
        "tota nua ses camiza.",
        " Aquest ioi m'avegna,",
        " que tan l'ai enqiza",
        " e s'amar mi degna",
        "mout ai bon'amor conqiza.",
        " Q'ell'es valenz",
        "bell'e gai'e corteza,",
        " douc'e plazenz",
        "e de tot ben apreza",
        " e conoisent[z],",
        "per qei ai amor meza",
        " mas non es gent[z]",
        "l'amor[s] egal devisa.",
        "    Q'eu mor aman",
        " per lei tant la dezire,",
        "    e il non blan",
        " mon mal ni mon martire,",
        "    ni fai semblan",
        " que ren l'enueg nil tire,",
        "on sui ben fols q'eu i ai m'amor miza.",
        " Mas il o fa",
        "    per essai,",
        " per semblanza ;",
        " e non partra",
        "    del seu pla",
        " m'esperanza ;",
        " anz l'atendra",
        "    tro qe n'ai'",
        " alegranza,",
        "car genzer es qe fos d'amor enqiza.",
        "    ... ten vai,",
        "    descortz, la",
        " e t'enanza",
        " al Marques gai,",
        "    car el fa",
        " senz doptanza",
        " son pretz verai,",
        "    de qem plai,",
        " e s'onranza",
        "a totz grazir d'Espagna tro q'en Franza."
    ],
