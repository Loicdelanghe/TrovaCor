{
    "Author": [
        "UcdeSantCirc",
        "GuillemdelBaus"
    ],
    "Genre": "échange de coblas",
    "Title": "Physica et astronomia / Liautatz ses tricharia ",
    "FullText": [
        "Physica et astronomia",
        "Eill planet superior",
        "E lartz de iomantia",
        "El cercles qe va e cor",
        "Vos an mes en la follia",
        "Votre sen et en error ;",
        "Per qe Lirons fai folor",
        "Qoimais no pren la bailia",
        "Dels fillos de sa seror",
        "Anz qeill perdan tot lo lor ;",
        "E puois agran bon tuor,",
        "Bon oncle e bon curador.",
        "GUIELLMS DEL BAUS.",
        "[L]iautatz ses tricharia",
        "E bona fes ses error",
        "E lart e la maiestria",
        "Desser verais vas seignor,",
        "Cavetz, an fait com se fia",
        "En vos be. Doncs se tuor",
        "Laisses al meu fill menor,",
        "En Liron nom fieria,",
        "Abanz feraill curador",
        "De vos ne defendedor ;",
        "Ni no pogra nuill tuor",
        "Aver al seu dan meillor.]"
    ],
