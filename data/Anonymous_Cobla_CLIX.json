    "Genre": "Cobla",
    "Title": "Tut lo mon vei reverdeiar",
    "FullText": [
        "Tut lo mon vei reverdeiar",
        "ls albres de fuoglla vestir,",
        "e ieu non mi puosc renverdir,",
        "a mal mon grat m'aven sechar.",
        "con ben e mal lioc sui plantat,",
        "car totesverd et ieu secat!",
        "cora renverdirai, seinhor,",
        "pois non renverdisc en pascor?",
        "be leu la nuot de San Giovan,",
        "",
        "",
        ""
    ],
