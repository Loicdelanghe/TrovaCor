    "Genre": "Canso",
    "Title": "Egan, res qu'ieu vis ",
    "FullText": [
        "Egan, res qu'ieu vis",
        "om det alegrier,",
        "m plac flors de lis",
        "fruz d'aiglentier;",
        "vau mieg ausis",
        "mieg desirier",
        "benvolenza,",
        "qu'e mala merce",
        "m'a tengut Amors,",
        "on mi ven l'esmais",
        "us dolors.",
        "Be m'a tot aquis",
        "per son domengier",
        "Amors, qu'iel so fis",
        "man sobrier,",
        "u aclis",
        "pejor guerrier,",
        "qu'ieu ai gran faillenza",
        "fait, car nol sove",
        "moros plors,",
        "q'era m'es esglais",
        "zo qem fon douzors.",
        "S'els huils abelis",
        "Amors de primier,",
        "mas li plor el vis",
        "l douz cossirier",
        "on al cor assis.",
        "D'envejos mestier",
        "om par malsabenssa,",
        "qu'ieu am mais de re",
        "on fatz clamors",
        ", can non pusc mais,",
        "usors.",
        "Tant jorn ai enqis,",
        "per talan leugier,",
        "q'ieu de leis auzis",
        "blasm'o reproier,",
        "mas cil del pais",
        "on gen vertadier",
        "ptenenza,",
        "qe so q'il fa be",
        "'es grazit e sors,",
        "o l'es re frais",
        "'a leis si'honors.<span style=\"display: none;\"></span",
        "D'aitan m'obezis,",
        "mais non sofier,",
        "volgues quel servis;",
        ", si trop li qier",
        "o seu gent cors lis",
        "'un joi plasentier",
        "humil, sa valenza",
        "'adouzis vas me",
        "'orguill; que sabors",
        "m'es que tot joi lais",
        "quem vir aillors."
    ],
