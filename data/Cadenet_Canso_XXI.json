{
    "Author": [
        "Cadenet"
    ],
    "Genre": "Canso",
    "Title": "S'ieu ar endevenia ",
    "FullText": [
        "Sieu ar endevenia",
        "en far chansson plazen,",
        "meravilla seria,",
        "tant mi vai malamen.",
        "voluntiers men sofrira",
        "de dire cossim vai,",
        "qieu no men descobrira,",
        "mas lamoros eil ga",
        "dirian : e que fai ?",
        "meravillas navem tuich gran,",
        "segon ques era gais antan,",
        "cossi pot esser que non chan.",
        "Cuna dompna servia",
        "de bon cor leialmen",
        "tant quen bon pretz lavia",
        "pojad. Era dissen.",
        "con o poirai far dira ?",
        "car liei cui servit a",
        "de bon cor, e servira,",
        "desam, car o forfai,",
        "car atressi seschai,",
        "naial blasme, qan fai engan,",
        "cum pretz an cellas que ben fan.",
        "per so iratz sui de son dan.",
        "style=\"text-align: center;\">III",
        "Dirai una feunia",
        "(com iratz non a sen)",
        "contra ma cortesia ?",
        "per so car no mes gen,",
        "si pogues, lan cobrira ;",
        "mas ja non lamarai,",
        "puois ill eissa sazira.",
        "sabetz cal conort na",
        "en quem conortarai ?",
        "eu naic de bels plazers enan. ",
        "quilh agues mas un sol talan ! ",
        "sa foudatz men fai dir aitan.",
        "Mi el bon pretz cavia,",
        "a perdut veramen",
        "el ben com li dizia.",
        "gardatz cum mal len pren !",
        "que qui la vi, s plevira",
        "antan e mais en la",
        "que ja mais non faillira.",
        "et ieu com o farai ?",
        "cossi men vengarai ?",
        "puois tant ma faich mentir lauzan",
        "que sieu dic de mal altretan.",
        "acom sera plus mal-estan.",
        "A dompnais taigneria",
        "grans viutatz donramen",
        "e de faitz carestia,",
        "tant cant ten son joven.",
        "vezer pot qand si mira,",
        "cum de beutat li vai ;",
        "pero si non cossira",
        "en valor, ill dechai,",
        "car sa beutatz sen vai,",
        "et ill reman ab pel ferran",
        "olenta, car a viscut tan",
        "ab plus simple sen dun enfan.",
        "Lausengador, deserenan",
        "gatz so queus er a talan,",
        "qieu noi puosc aver pro ni dan.",
        "Enueios, mais ai de talan",
        "e trobar dompna ses enian",
        "qe vos de prez, cui amaz tan !"
    ],
