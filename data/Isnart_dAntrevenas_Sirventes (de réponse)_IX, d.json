    "Title": "Trop respont en Blacatz ",
    "FullText": [
        "Trop respont en Blacatz",
        "A lei domen iros,",
        "E car di mal de nos",
        "Fai que mal-enseignaz ;",
        "E seria foldatz",
        "Seu meteis li dizia",
        "Que . . . . lo contraria ;",
        "Mas aitant li dira",
        "Que mais di que non fai.",
        "Chascuns enten mon chan,",
        "E lais men ab aitan,",
        "Qe mals dirs es folia.",
        "Quant es del tot armaz",
        "Es tant gaillarz e pros",
        "Per qen sui temeros",
        "E volria sos plaz ;",
        "Quarde Trans, o sapa,",
        "Vendet la seinoria",
        "Qe sa nezi tenia,",
        "De qe fez honrat plai ;",
        "E quant fo pres, cho sai,",
        "Qua un vilan truan",
        "Rendet lausberc el bran,",
        "Feiz grant cavalaria.",
        ". . . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . . .",
        "Dels diners queill devia",
        "NEspaza volc far pla",
        "Mais que metren assa",
        "Son valen cors prezan,",
        "Si ferel datrestan",
        "Ainz que nos combatria."
    ],
