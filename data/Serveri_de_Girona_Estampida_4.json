    "Author": [
        "Serveri_de_Girona"
    ],
    "Genre": "Estampida",
    "Title": "Pus chan era e s'esmera ",
    "FullText": [
        "Pus chan era E s'esmera",
        "D'amar mos fis cors enquera,",
        "Gen m'anera E m'estera,",
        "S'Amors nom fos dur'e fera ;",
        "Qu'eu obrera E planera",
        "Chan c'ab motz prims aponchera,",
        "m>Afinera E genera",
        "Qu'endreit midons m'embrivera.",
        "Tal lauzera E chantera",
        "Mos chans, que lam saludera",
        "E o don molt m'azautera ;",
        "Que ben leu d'amor l'amera.",
        "Mas ventura Sec'endura",
        "C'Amors de mi non a cura.",
        "Trop me dura La frachura",
        "m>De leys on beutatz s'atura ;",
        "C'anc natura Criatura",
        "No formet meylls per mesura ;",
        "Qu'il es pura, Mond'es mura",
        "Gen de color ses penchura.",
        "No piyura, Ans melura,",
        "Don las altras fan rancura ;",
        "Car totz homs, qui leys ve, jura",
        "Que fay lor beutat escura.",
        "Car m'azira, Ay gran ira,",
        "Don mos cors playn e suspira ;",
        "Mas nos vira, Ans s'albira,",
        "Per que tot son dan dezira.",
        "Gen sofrira E grazira,",
        "Car tan bes com mals sentira,",
        "Espandira, Enantira",
        "Sos laus que no s'en partira,",
        "m>La servir E blandira,",
        "Car es la gener ques mira.",
        "Sis fay qu'en re sol noy tira,",
        "Er, on pus penan cossira.",
        "Dona mia, Sius plazia",
        "Qu'eu moris, morir volria.",
        "Sius valia Ous sabia",
        "Bo, ma mortz molt me playria.",
        "Si moria, Nous seria",
        "Honors ne bes, bela mia,",
        "E diria, Sius dizia,",
        "Mels ver, ma bel' enemia :",
        " Can un dia No-paria",
        "Nous pla, per c'aucir, m'enia ?",
        "Si tracio nous fazia,",
        "Mas un vostr'om auciria ? ",
        "V. Jay'ria, Sius vezia,",
        "Na Sobrepretz, eus plazia,",
        "E si valen don'avia",
        "A Cardona, bem playria.",
        "Nos desvia, Ans sec via",
        "De pretz e de cortezia",
        "E fay o, don dreitz l'aguia,",
        "Lo reys Peyres, on ques sia."
    ],
