{
    "Author": [
        "Guiraut_Riquier"
    ],
    "Genre": "Canso",
    "Title": "Ajssi quon es sobronrada ",
    "FullText": [
        "Ajssi quon es sobronrada",
        "la maire del salvador,",
        "eu esser honran lauzada;",
        "quar singulars de valor",
        "o et es,",
        "otz bes",
        "style=\"margin-left: 80px;\">complida,",
        "claus de vera vida,",
        "style=\"margin-left: 80px;\">grazida.",
        "E donc sobiras devers",
        "mes que sesfors mos sabers",
        "tant quel sia dagradatge",
        "sos laus que tenc en coratge,",
        "quab sobrevoler comensa.",
        "Regina verge, clamada",
        "evetz esser ab lauzor,",
        "e temsuda et amada;",
        "quar Dieus vos fe tant donor",
        "quant se mes",
        "os pres",
        "style=\"margin-left: 80px;\">perida",
        "gens port de gandida,",
        "style=\"margin-left: 80px;\">chauzida",
        "flors e nasc de vos hom vers,",
        "ers Dieus, on es mos espers;",
        "onc beus det gran avantatge,",
        "quanc no fon duman linhatge",
        "tro que de vos pres nayssensa.",
        "Tota flors don frutz saizina",
        "pert apres son frug beutat;",
        "os remazes fresque fina",
        "erges creyssens de rictat:",
        "us olens,",
        "us plazens,",
        "style=\"margin-left: 80px;\">pus clara",
        "flors etz quel mon para",
        "style=\"margin-left: 80px;\">e guara;",
        "flors de tot frug saboros,",
        "flors de gaug, redemptos",
        "etz del mon; quar lo salvaire",
        "fon fils de vos, vostre paire,",
        "on etz sa maire sa filla.",
        "De paradis etz regina,",
        "maire Dieu, per gran bontat;",
        "et etz restaurans mezina,",
        "fons de vera petat;",
        "z guirens",
        "style=\"margin-left: 80px;\">damara",
        "mort; quar vostra cara",
        "style=\"margin-left: 80px;\">esguara",
        "pregan lo rey gloros",
        "ques paires e filhs de vos,",
        "filla del vostre filh, maire",
        "el vostre paire: com faire",
        "sos poc es grans meravilla.",
        "Pero ma fes nos balansa;",
        "quar Dieus per nos restaurar",
        "o fe, que pot ses erransa",
        "far mil tans qe hom pessar,",
        "l poder",
        "b voler",
        "style=\"margin-left: 80px;\">capdelha;",
        "donc, maire piucella",
        "style=\"margin-left: 80px;\">mout bella,",
        "creyssensa prezes daon:",
        "quelh, ques mais de tot lo mon,",
        "caup en vos, verges certana,",
        "e visc en pres carn humana",
        "en nasc senes tota taca.<span style=\"display: none;\"> </span",
        "Enquer vos fa mais donransa,",
        "queus obezis, doneus par:",
        "per queus prec aiatz membransa",
        "quel denhetz per mi pregar;",
        "quab lezer",
        "orn e ser",
        "style=\"margin-left: 80px;\">apella",
        "marma e gragella,",
        "style=\"margin-left: 80px;\">sembella",
        "us greus peccatz que m cofon;",
        "e vos podetz men far mon.",
        "Sil vostre filh, sobirana",
        "maire,n pregatz, tost er sana",
        "marma que de mort se raca.",
        "Dona, estela del mon",
        "ab clardat que nos rescon",
        "es per nos, gent crestana:",
        "onc preguatz Dieu que de vana",
        "a nos gar e de braca."
    ],
