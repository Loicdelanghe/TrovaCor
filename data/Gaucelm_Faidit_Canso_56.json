{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Del gran golfe de mar ",
    "FullText": [
        "Del gran golfe de mar",
        "oisdelsportz,",
        "perillos far,",
        "oi, merce Dieu, estortz !",
        "on posc dir e comdar",
        "qe mainta malanansa",
        "hai suffert, e maint turmen !",
        "pos a Dieu platz que torn men",
        "Lemozi, ab cor jauzen,",
        "on parti ab pesansa,",
        "o tornar e lonransa",
        "zisc, pos el mo cossen.",
        "Ben dei Dieu mercejar,",
        "pos vol que, sanse fortz,",
        "puesc el pas tornar,",
        "m>on val mais uns paucsortz,",
        "qe dautra terr estar",
        "b grau benanansa !",
        "qar sol li bel acuillimen,",
        "onrat fag e-il dig plazen",
        "ostra domne-il prezen",
        "amorosa coindansa,",
        "oussa semblansa,",
        "val tot can autra terra ren.",
        "Ar hai dreg de chantar,",
        "pos vei joi e deportz,",
        "olatz e domnejar,",
        "qarso es vostracortz",
        "m>sfont e-l riuclar",
        "fan mal cor alegransa,",
        "prat e vergier, qar tot mes gen !",
        "qera non dopti mar ni ven,",
        "bi, mastre ni ponen,",
        "ma naus no-m balansa,",
        "o-m fai mais doptansa",
        "orsier corren.",
        "Qi, per Dieu gazaignar,",
        "pren daitals desconortz,",
        "per sarma salvar,",
        "ben es dregz, non ges tortz ;",
        "mas cel qi, per raubar",
        "per mal acordansa,",
        "vai per mar,on hom tan mal pren",
        "m pauc dora, saven soven",
        "qe, qan cujom pujar, deissen ;",
        "ab desesperansa",
        "ot enlansa",
        "arm e lo cors, laur e largen !"
    ],
