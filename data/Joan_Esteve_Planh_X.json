{
    "Author": [
        "Joan_Esteve"
    ],
    "Genre": "Planh",
    "Title": "Aissi quol malanans ",
    "FullText": [
        "    Aissi quol malanans",
        "    quant a sas grans dolors",
        "    e treballas e plors,",
        "    que solatz ni bobans",
        "    nol fan gaug, tant es grans",
        "    sos dols e sa tristors,",
        "    suy eu, els ay peiors,",
        "    per lo vescoms prezans",
        " ques mortz, per quen deu aver",
        "tot narbones ira e dol jorn e ser,",
        "quar perdut an lur senhor natural;",
        "Dieus li fassa, sil platz, lay bon ostal.",
        "    Qui cassara engans",
        "    ni mals faitz ni folhors",
        "    ni falses ni trachors",
        "    ni qui ner ta membrans,",
        "    hueymais, dera enans,",
        "    quol vescoms caps donors,",
        "    quera de pretz senhors",
        "    e capdels e gardans?",
        " Aras la volgut aver",
        "Nostre Senhors ez ab se retener,",
        "que say mest nos non a laissat aital",
        "Fransa trol rey de Portogal.",
        "    Greu mortz, tu fas plorans",
        "    estar ab grans dolors",
        "    ducx ez emperadors,",
        "    cavaliers e sarjans",
        "    e donas malestans,",
        "    quer bayssatz lur valors,",
        "    quel mielhs dels pus melhors",
        "    nas menat, don es dans",
        " e grans talas per ver;",
        "tan de dol nay qua pauc nom lays chazer,",
        "e nueg e jorn el cor ira mortal",
        "que si soan sai tug li provensal.",
        "    E qui fara mais tans",
        "    de plazers ni damors",
        "    ni er tam bo secors",
        "    a paupres vergonhans,",
        "    quelh non era duptans",
        "    ni eygarava ricors",
        "    ez era dels mellors",
        "    paires e capdelhans",
        " en tug avia poder;",
        "e quelh sia mortz, las! e quis pot tener",
        "que nos plore ab gran dolor coral",
        "quar en sa mort prendem tug dan e mal?",
        "    Hueymais en mos afans",
        "    dolens ab grans freiors",
        "    quan no veirai la flors",
        "    dels frugz ben afruchans,",
        "    el mielhs el pus amans",
        "    ez ab mais de dossors",
        "    ez ab mais de lauzors",
        "    el pus humilians",
        " ez ab mai de plazer",
        "que, mil ans a, luns hom pogues vezer:",
        "eral vescoms nAmalricx dous lial,",
        "que de maire non nasquet pus cabal.",
        " Pus Dieus nos vol dechazer",
        "ez a luy platz, ben deu a nos plazer;",
        "mas preguem lo tug ensems a jornal",
        "quelh lo meta al regne celestial."
    ],
