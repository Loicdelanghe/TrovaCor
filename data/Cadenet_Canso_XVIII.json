{
    "Author": [
        "Cadenet"
    ],
    "Genre": "Canso",
    "Title": "S'ieu oi mais deserenan ",
    "FullText": [
        "Sieu oi mais deserenan",
        "non chantava voluntiers,",
        "os, a cui platz alegriers,",
        "men deuriatz far deman,",
        "style=\"text-align: center;\">5",
        "qieu sui ben tengutz",
        "per mon joi, si lai,",
        "que no sia mutz",
        "la",
        "on serant li gai.",
        "e vos cui chans platz,",
        "aujatz e chantatz",
        "oi mais novellas chanssos",
        "que farai ab coindetz sos.",
        "Sieu fos de leugier talan",
        "ni temses los cossiriers",
        "camors mi donet sobriers,",
        "enqera non for en tan.",
        "mas nom sui mogutz",
        "ni ges nom mourai,",
        "anz sui remazutz",
        "la",
        "on fui e serai.",
        "e vuoill qem crezatz",
        "vos autre camatz,",
        "catressin penra a vos",
        "ab un cor, e mal ab dos.",
        "Sabetz vos que doi cor fan ?",
        "certas, homnes messongiers ;",
        "e fals daquestz dos mestiers",
        "ei que son aquil quels an.",
        "mas sien fos crezutz",
        "(so que non serai),",
        "ja non fora drutz",
        "lai",
        "fals on non seschai.",
        "dompnas ab beutatz,",
        "chascunaus gardatz",
        "que non aia part en vos",
        "qui mais a mals aips que bos.",
        "A dompnes pro ben-estan",
        "que lam us sols cavalliers,",
        "e mal pus i met pariers.",
        "mas dun taing, . . . . . . . .",
        ". . . . . . . . . . . . . . . . . .",
        ". . . . . . . . . . . . . . . . . .",
        "e pus car tengutz",
        "la",
        ". . . . . . . . . . . . . . . . . . . ;",
        " e si es malvatz",
        "ni mal enseignatz,",
        "ja bella dompna ni pros",
        "nois taing quel fassa joios.",
        "Dompna sai ieu ses engan,",
        "on non troba lausengiers",
        "ren de que sia parliers",
        "mas de ben, si na talan,",
        "ni non sortz mals brutz",
        "(car non o forfai)",
        "ni nuills avols cutz",
        "la",
        "on ill es, ni sai,",
        "bellab gai solatz",
        "ses avol percatz,",
        "e sin fora ieu gilos",
        "sil sens qes en lieis, no fos.",
        "Lausengier, digatz",
        "de mi qeus voillatz,",
        "qiem teing per pagatz de vos,",
        "e mos amics per un dos."
    ],
