{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Gen  M'aten",
    "FullText": [
        "    Gen Maten",
        " Ses falhimen",
        "En un chan valen;",
        "       Caiuda",
        "    Mes creguda",
        "       De la",
        " On cilh esta",
        "Queu am mais que re!",
        "       Neis me",
        "    Non am tan,",
        "Per queu vauc pensan",
        "Com so quelh plagues",
        "    Li disses",
        "      Chantan;",
        "Questers no laus dir",
        "Cossim fai languir",
        "       Jauzen",
        " Que mal no sen",
        "Mas del pensamen",
        "    Quem destrenh.",
        "Pero sil chaptenh",
        "Quem promes nom fai,",
        "De ben e de ja",
        "Mesdui e mempenh.",
        "    Quen Rizen",
        " Me fetz parven",
        "Al comensamen",
        "       De druda",
        "    Chartenguda",
        "       Quesma",
        " Ni dol no na",
        "Pel joi que men ve.",
        "       Cancse",
        "    Cut quenan",
        "Sira melhuran",
        "Lesperansel bes,",
        "    E pos ses",
        "       Engan",
        "Lai cor a servir,",
        "Sim denhacolhir",
        "       Nim pren",
        " A chauzimen,",
        "Dazai qui nom pen,",
        "    Seu jam fenh",
        "Ca so sen no renh",
        "Segon que sabrai,",
        "Pos conoissera",
        "Que noi a malgenh!",
        "    Den, No men",
        " Me vauc meten",
        "Per sobrardimen",
        "       En bruda",
        " Mentaguda;",
        "    Quem tra",
        " Vas tal assa",
        "Ca la mia fe",
        "     Be cre",
        "   Ca mo dan",
        "Me vauc esforsan,",
        "Tan sui fola res!",
        "   E com es",
        "      Queu chan",
        "Em sapcha cobrir",
        "Qui mo deu grazir?",
        "       Soven",
        " Falh e mespren",
        "E pois no macen",
        "    Ni nom tenh",
        "A dan, sim destrenh",
        "Amors nim dechai;",
        "Cuna vetz naura",
        "Mo bon esdevenh!",
        "    Len Me ren",
        " Que quem prezen,",
        "Mas leugeramen",
        "      Se muda;",
        "   Ca saubuda",
        "      Mestra",
        " So quem fetz gai",
        "E men deschapte.",
        "      Merce",
        "    Nolh deman,",
        "Mas vauc malegran",
        "Com no conogues",
        "    Ni saubes",
        "      Lafan",
        "E cut men partir.",
        "Pois en leis chauzir",
        "     Enten",
        " Gran jauzimen",
        "Que naurai breumen",
        "    E revenh",
        "Pel bon entresenh",
        "Quem mene matra",
        "Los bous Bertalai!",
        "Ca plus noi atenh.",
        "    Men - taven",
        " Vauc drech venen",
        "Pro vetz: Si bes pen?",
        "      Quen cuda",
        "    Recrezuda",
        "      Sescha",
        " Ques en afra",
        "Com cobre reve;",
        "      Per que",
        "    Vauc tarzan",
        "La guerrel deman",
        "E sui tan cortes",
        "   Que merces",
        "      Claman",
        "Cut esdevenir",
        "En so que dezir",
        "      Parcen",
        " Forsadamen",
        "Ca ver recrezen",
        "    Men depenh.",
        "Pero, si jam senh,",
        "Tan o sofrira",
        "Que tot proarai,",
        "Si pert retenh.",
        " Sim destrenh",
        "Lo cor que lengenh",
        "Cavia perdrai,",
        "Sans que veia ma",
        "Al plus no natenh.",
        "Plus a drech greu ma",
        "Cut que passarai,",
        "Sans de vos nom venh!"
    ],
