{
    "Author": [
        "Bernart_de_Ventadorn"
    ],
    "Genre": "Canso",
    "Title": "Tant ai mo cor ple de joya ",
    "FullText": [
        "Tant ai mo cor ple de joya,",
        "    tot me desnatura.",
        "flor blancha, vermelh e groya",
        "    me par la frejura,",
        "cab lo ven et ab la ploya",
        "    me creis laventura,",
        "per que mos pretz mont e poya",
        "    e mos chans melhura.",
        " tan ai al cor damor,",
        "style=\"text-align: center;\">10",
        " de joi e de doussor,",
        "perquel gels me sembla flor",
        "    e la neus verdura.",
        "style=\"text-align: center;\">II",
        "Anar posc ses vestidura,",
        "    nutz en ma chamiza,",
        "style=\"text-align: center;\">15",
        "car fin amors masegura",
        "    de la freja biza.",
        "mas es fols quis desmezura,",
        "    e nos te de guiza,",
        "per queu ai pres de me cura,",
        "style=\"text-align: center;\">20",
        "    deis cagui enquiza",
        " la plus bela damor,",
        " don aten tan donor,",
        "car en loc de sa ricor",
        "    no volh aver Piza.",
        "style=\"text-align: center;\">III",
        "style=\"text-align: center;\">25",
        "De samistat me reciza !",
        "    mas be nai fiansa,",
        "que sivals eu nai conquiza",
        "    la bela semblansa ;",
        "et ai ne a ma deviza",
        "style=\"text-align: center;\">30",
        "    tan de benanansa,",
        "que jal jorn que laurai viza,",
        "    non aurai pezansa.",
        " mo cor ai pres dAmor,",
        " que lesperitz lai cor,",
        "style=\"text-align: center;\">35",
        "mas lo cors es sai, alhor,",
        "    lonh de leis, en Fransa.",
        "style=\"text-align: center;\">IV",
        "Eu nai la bon esperansa.",
        "    mas petit maonda,",
        "catressim ten en balansa",
        "style=\"text-align: center;\">40",
        "    com la naus en londa.",
        "el mal pes quem desenansa,",
        "    no sai on mesconda.",
        "tota noih me vir em lansa",
        "    desobre lesponda :",
        "style=\"text-align: center;\">45",
        " plus trac pena damor",
        " de Tristan lamador,",
        "quen sofri manhta dolor",
        "    per Izeut la blonda.",
        "style=\"text-align: center;\">V",
        "Ai Deus ! car no sui ironda,",
        "style=\"text-align: center;\">50",
        "    que voles per laire",
        "e vengues de noih prionda",
        "    lai dins so repaire ?",
        "bona domna jauzionda,",
        "    mor sel vostr amaire !",
        "style=\"text-align: center;\">55",
        "paor ai quel cors me fonda,",
        "    saissim dura gaire.",
        " domna, per vostr amor",
        " jonh las mas et ador !",
        "gens cors ab frescha color,",
        "style=\"text-align: center;\">60",
        "    gean mal me faitz traire !",
        "style=\"text-align: center;\">VI",
        "Quel mon non a nul afaire",
        "    don eu tan cossire,",
        "can de leis au re retraire,",
        "    que mo cor no i vire",
        "style=\"text-align: center;\">65",
        "e mo semblan nom nesclaire,",
        "    que quem naujatzdire,",
        "si cades vos er vejaire",
        "    cai talan de rire.",
        " tan lam de bon amor",
        "style=\"text-align: center;\">70",
        " que manhtas vetz en plor",
        "per o que melhor sabor",
        "    men an li sospire.",
        "style=\"text-align: center;\">VII",
        " Messatgers, vai e cor,",
        " e dim a la gensor",
        "style=\"text-align: center;\">75",
        "la pena e la dolor",
        "    quen trac, el martire."
    ],
