{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Los aplechs",
    "FullText": [
        "   Los aplechs,",
        "   Ab queu solh",
        "Chantar, el bo talan",
        "Ai eu, caviantan;",
        "Mas car no trop ab cui,",
        "Nom deport nim desdu",
        "Ni no sui benanans.",
        " Ai Deus! cals dans",
        "Sen sec e cals damnatges,",
        "Car cortz e bos uzatges",
        "Aissi menuze falh,",
        "Noi a nulh refrenalh!",
        "Mas, car mo senhor platz",
        "Jois e chans e solatz,",
        "Mesjau ab sos privatz",
        "E, can men sui lonhatz,",
        "Irasc mab los iratz.",
        "   Mas destrechs",
        "   Men destolh,",
        "Per quem vauc regaran",
        "Si ja salegraran?",
        "Car ges a joi no fu",
        "Quils plazers non esdu",
        "Ca me platz ades chans",
        " E bels mazans",
        "E cortz e vassalatges,",
        "Ja perdels rics linhatges",
        "Paire pros so miralh;",
        "Coi ses esperonalh",
        "No sesmera barnatz",
        "E, sil pair fo lauzatz",
        "El filhs se fai malvatz,",
        "Semblam tortz e pechatz",
        "Caia las eretatz.",
        "   Donc cals drechs",
        "   O acolh",
        "Quel filhs aiatretan",
        "De rendel pretz soan",
        "Ni cals razos adu",
        "Que melhs no tanhaltrui?",
        "Queu cre que fos enans",
        " Oltra mil ans",
        "Conors e senhoratges",
        "Davon pretz e coratges",
        "E costas e trebalh,",
        "El filhs, sil melhs trassalh,",
        "Non es donc forlinhatz?",
        "Era com no mostratz,",
        "Vos savis, que jutjatz,",
        "Sals pros fol dos donatz,",
        "Com er dels desprezatz?",
        "   Mas nelechs",
        "   Er, sim tolh",
        "De solatz ni de chan",
        "Per cels qui falhiran!",
        "Que fol tenhatz celu",
        "Que se mezeis destru",
        "Nis vira malanans",
        " Per no sai cans",
        "Cui jois par nesciatges;",
        "Coi sabers ni paratges",
        "Non es que no nualh,",
        "Pos alegransai falh,",
        "E nos chamje viatz,",
        "E queus valra rictatz,",
        "Si ja nous alegratz?",
        "Quemperis e renhatz",
        "Es ses joi paubretatz.",
        "   Mas ladrechs",
        "   Cors queu volh",
        "E dezir e reblan",
        "Ma trach dire dafan",
        "E, si jois lam condui,",
        "Ja no sabran mas du",
        "Los entresenhs nils mans;",
        " Quenois es grans",
        "E sobeiras folatges,",
        "Can per nescis messatges",
        "Vilas ni davol talh",
        "Eschapa del guinsalh",
        "Ni fui bonamistatz.",
        "Mas eum sui be gardatz",
        "Canc non fui encolpatz;",
        "Coi non es vius ni natz",
        "Per queu en fos proatz!",
        "   E lesplechs,",
        "   Silh macolh,",
        "So quelh querrai chantan,",
        "Remanhal seu coman;",
        "Cab bels plazers redui,",
        "Can nos volf nis defu",
        "Ladrechs cors benestans",
        " Nil bels semblans",
        "Ni lamoros vizatges,",
        "Cavinens es lo gatges",
        "Que dels olhs al cor salh,",
        "Per queu, qui ques baralh",
        "Ni sapele forsatz,",
        "Me tenh a be menatz,",
        "Can trop ben acordatz",
        "Lo coratge la fatz",
        "Els dichs ben ensenhatz.",
        "E pos enans no valh",
        "Ni no sui aizinatz,",
        "Bels-Senher, sofertatz",
        "Queu chan! Ab co sofratz,",
        "Conosc be quel comjatz",
        "Porta plus de mil gratz.",
        "An Sobre-Totz diatz,",
        "Vos que mo chan portatz,",
        "Que sai ses tan tarzatz",
        "Quel en semblara fatz."
    ],
