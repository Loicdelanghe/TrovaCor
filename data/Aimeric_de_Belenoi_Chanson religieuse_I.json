{
    "Author": [
        "Aimeric_de_Belenoi"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Domna, flor ",
    "FullText": [
        "Domna, flor,",
        "[frug] damor,",
        "domna senz vilania,",
        "resplandor",
        "e color",
        "de tota cortezia:",
        "vostramor,",
        "sai, socor",
        "aicel qen vos sen fia,",
        "tal qe plor",
        "ne dolor",
        "non sen, Verges Maria;",
        "car de vos pres charn humana",
        "Jesus Christz, qi lave sana",
        "otz vostres amics de mal,",
        "per confesson leial.",
        "Ric iornal",
        "aven tal,",
        "beneita, glorosa,",
        "qa Nadal",
        "fos engal",
        "maire, filhe espoza,",
        "de reial",
        "cort captal,",
        "dona [molt] poderoza,",
        "un logal",
        "mi faitz sal",
        "misericordoza.",
        "Qenois mes daqesta vida,",
        "car noi trop  tant es marrida",
        "cort ni donna ni segnior",
        "senz trebail ni senz dolor.",
        "Qui honor",
        "vol damor,",
        "en vos, domna, entenda;",
        "qe daillor",
        "ven en plor",
        "tot ioi qe hom natenda;",
        "eil meillor",
        "fan folor:",
        "cuidon qe miels lur prenda",
        "cab sabor",
        "dans maior",
        "e pert cascus sa renda.",
        "Mas la vostra amistanza",
        "ona ioi e alegranza,",
        "e tol ire pensamen,",
        "e fai de paubre manen.",
        "Ben i pren",
        "qi enten",
        "en vos, dousa rena:",
        "cab iauzen",
        "pensamen",
        "son dezirer afina;",
        "cor e sen",
        "e talen",
        "mi donatz e aizina,",
        "qe viven",
        "peneden",
        "ab vera disciplina,",
        "ona, mos pechatz fenisca",
        "e tal guiza e delisca,",
        "cal iorn derrer mi [men plait]",
        "ab aicels cauran ben fait.",
        "Seignier, en vos non perisca",
        "vostre prez e non delisca:",
        "qe, cant la mortz eis dagait,",
        "uit li cuidar son desfait."
    ],
