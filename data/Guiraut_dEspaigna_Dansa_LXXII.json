{
    "Author": [
        "Guiraut_dEspaigna"
    ],
    "Genre": "Dansa",
    "Title": "Ges ancara ",
    "FullText": [
        "Ges ancara",
        "na Cors-car",
        "nom ampara;",
        "ni nom par",
        "quel ioi d'ara!",
        "vueillam dar,",
        "tan pauc guara",
        "l mieu esgar.",
        "Car si gardava",
        "mos esgars ni pensava",
        "l'amor qu'ieu l'ai nil leial cor,",
        "trop seria brava,",
        "si non s'umeliava",
        "'est mal, don est sieus amans mor;",
        "qu'ieu cuiava",
        "amatz amar,",
        "e semblava",
        "s degues far,",
        "sim n'auzava",
        "arazonar",
        "nim iutgava",
        "l mieu cantar.",
        "Razo semblaria,",
        "si az amor plazia,",
        "quill m'amenes a portal",
        "que fos meils amia",
        "midons, e tanheria.",
        "e  salut, mon bel Proensal",
        "non diria",
        "mon Cor-clar;",
        "ans sabria",
        "l ioi selar,",
        "s'ieu l'avia,",
        "e tener car,",
        "e volria",
        "aissi finar.",
        "Aital fi vueill pendre,",
        "si vol midons entendre",
        "lo ric ioi queill quier en cantan.",
        "anc nom deu mespendre",
        "nuils hom, s'ieu vueill atendre",
        "al sieu bel cor nou benestan,",
        "quem fai atendre,",
        "e tremblar",
        "e contendre",
        "sols ses par",
        "e cor fendre",
        "et esglandar",
        "et atendre",
        "edezirar,",
        "na Belengueira, ses par."
    ],
