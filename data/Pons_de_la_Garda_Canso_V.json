{
    "Author": [
        "Pons_de_la_Garda"
    ],
    "Genre": "Canso",
    "Title": "Tant soi apessatz ",
    "FullText": [
        "Tant soi apessatz",
        "et en gran esmai,",
        "que ben cre e sa",
        "que nom plagr'oguan",
        "solatz ni deport ni chan.",
        "Mas On-tot-mi-plaz",
        "ol qu'ieu chan, et es mi gen",
        "que fassa son mandamen.",
        "Qu'estiers nuill solatz",
        "ni gran joi non ai.",
        "De trop peitz me va",
        "que no fes antan.",
        "E s'aisim vauc meilluran,",
        "foram meils assatz",
        "que fos mortz ab cor jauzen",
        "que s'ara viu malamen.",
        "Sau et em patz",
        "u, e[n] meins d'esglai,",
        "sel que per assa",
        "am' e non ges tan",
        "qu'en puesca morir aman.",
        "Mas tant enlassatz",
        "mi soi ieu joguan, rizen,",
        "'ueimais non puesc aver sen.",
        "Que las grans beutatz",
        "el cors cueind' e ga",
        "el ric pretz vera",
        "e la valor gran",
        "c'a midons, qu'ieu dupt' e blan,",
        "m'a[n] mes en tal latz",
        "on molt dur trebaill aten",
        "o me val chauzimen.",
        "Tant hi fui onratz",
        "quel coven mi pla",
        " sitot no m'estrai ",
        "quem fes en baizan.",
        "Del bel mensongier semblan",
        "es mos cors pagatz,",
        "c'aisi m'o dis avinen",
        "que ver me par quan me men.",
        "Mas molt soi iratz",
        "e marritz d'un pla",
        "en que nos, de sai,",
        "avem pres gran dan",
        "en la comtessa prezan,",
        "ona de Burlatz,",
        "que perdem, so m'es parven,",
        "Dieus encar no lans ren.",
        "Mas nos avem conort gran",
        "en On-tot-mi-platz,",
        "que sel que la ve soven",
        "on pot aver marrimen."
    ],
