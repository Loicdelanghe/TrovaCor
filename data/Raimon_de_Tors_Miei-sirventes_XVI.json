{
    "Author": [
        "Raimon_de_Tors"
    ],
    "Genre": "Miei-sirventes",
    "Title": "A totz maritz man e dic ",
    "FullText": [
        "A totz maritz man e dic",
        " Qu'ab maires estn,",
        "Que ses trebalhs ab fastic",
        " Ja non estarn,",
        " Ni ja ses tenon ;",
        "Per qu trai pieg de prison,",
        " al mieu albir,",
        "Maritz que ai vl sofrir :",
        "Car dl a dins e defra.",
        "Tant mal estn suegr'e nra !",
        "Totas las nras prezic",
        " Que son ni sern",
        "Que's gardon dels fals abric",
        " Que las sgras fan.",
        " E farn lur pron,",
        "Car ses tota uchason",
        " Sabon bastir",
        "Gran mal, gran dan e gran azir ;",
        "Per qu d'albrc geta fra",
        "Chascuna suegra sa nra.",
        "Tot li jove e l'antic",
        " Del mon que sens an",
        " Sabon que ab cr enic",
        " Suegra es tot l'an",
        " Ves nra, que non",
        "Esgarda drech ni razon.",
        " Per que pt dir",
        "Totz lo mons entiers, ses mentir,",
        "Que Na Bla Pros es fra",
        "De son albrc, car es nra.",
        " Mieg servents bon",
        "Tramet lai a Sestairon,",
        " Que'l deja dir",
        "Maistre Jacm'e far auzir",
        "Dins Sestairon e defra,",
        " Que o sapcha suegra e nra.",
        " Car averir",
        "Deu m ver, e mensonja delir :",
        " S'En Farautz ven, veirem fra",
        " La suegra e dins la nra.",
        " Rata pennada defra",
        " Er li suegr' e dins li nra."
    ],
