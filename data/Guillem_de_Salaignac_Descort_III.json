{
    "Author": [
        "Guillem_de_Salaignac"
    ],
    "Genre": "Descort",
    "Title": "Per solatz e per deport ",
    "FullText": [
        "Per solatz e per depor",
        "Me conor",
        "Em don alegransa,",
        "E ja non feira descor",
        "Sieu acor",
        "E bon acordansa",
        "Trobes ab lieys quam pus fort;",
        "Cautre tort,",
        "Vos dic ses duptansa,",
        "No lai mas lamor quel port;",
        "Pieitz de mor",
        "Me vol per semblansa.",
        "Mas de lausengiers mi lau,",
        "Quar fan cuydar queu am alhor",
        "E pueys demandom que fau,",
        "Ni on ai pauzada mamor;",
        "Et yeu, quar son mal e brau,",
        "Tem los tant que dirai la lor:",
        "La genser es quhom mentau,",
        "E la mielher de sa ricor.",
        "Francha, de bella paria,",
        "Gen parlan, de belh solatz",
        "La trobaretz quascun dia,",
        "E tot quan fai ni ditz, platz.",
        "Sens e pretz e cortezia,",
        "Guayez e fina beutatz",
        "Estan ab lieys nueg e dia,",
        "Sitot enuejals malvatz.",
        "Dal re no cossire,",
        "Mas samor dezire",
        "Quem des!",
        "Siey dols plazent rire",
        "Man donat martire",
        "Engres.",
        "On queu man nim vire,",
        "El cor la remire",
        "Ades;",
        "E pes e cossire",
        "E no laus ges dire",
        "Mames;",
        "Quel sobramors queu lai, men te",
        "E paors que lenueg dese;",
        "Mas en luec de clamar merce",
        "Lai finamor e bona fe;",
        "Quen tant quan mars ni terra te,",
        "Non a tan fin aman cum me.",
        "La valens reyna rete",
        "Dompney, fina beutat ab se",
        "Part totas las dompnas quom ve,",
        "E non ai sobredic de re:",
        "De Monferriol no dic re,",
        "Mas valor e fin pretz mante."
    ],
