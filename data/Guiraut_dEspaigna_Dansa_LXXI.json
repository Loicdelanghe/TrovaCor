{
    "Author": [
        "Guiraut_dEspaigna"
    ],
    "Genre": "Dansa",
    "Title": "Gen m'ausi ",
    "FullText": [
        "Gen m'aus",
        "midons,  e sill plazia",
        "c'apres s",
        "m'ausizes, bem plairia",
        "e tenria",
        "per fina ma fi ",
        "Quar sa fina",
        "valors no s'aclina",
        "tan c'aizin' a",
        "don mon cor s'afina,",
        "qu'en l'esquina",
        "mortal tenc l'espina,",
        "e muer mi,",
        "s'ela nom met en via",
        "qu'ieu lai sia,",
        "on mal anc la vi;",
        "Car sa cara",
        "nom manda ancara",
        "nova clara,",
        "don beutatz s'ampara.",
        "pero ara,",
        "dousa dona cara,",
        "faitz de m",
        "so que gen vos estia,",
        "c'obs m'auria,",
        "quar amors m'ausi.",
        "Gran enveia",
        "ai que midons veia,",
        "cui sopleia",
        "mon cor e s'autreia",
        "et esseia;",
        "e par qu'esser deia",
        "que de m",
        "si'ela calque dia",
        "tant amia",
        "cant ieu l'ai cor fi.",
        "Ses tot s",
        "ha beutat e coindia",
        "e pretz f",
        "na Belengueir' a tria,",
        "e parria",
        "az onor de si.",
        "Anc pos",
        "n'Autreiat, nueit ni dia",
        ". . . . . . . .",
        ". . . . . Nom parti."
    ],
