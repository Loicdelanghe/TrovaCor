    "Genre": "Descort",
    "Title": "Amors |dousors |mi assaia",
    "FullText": [
        "Amors,",
        "dousors",
        "mi assaia.",
        "valors,",
        "richors",
        "mi menaia.",
        "que flors",
        "e plus gaia",
        "es sil qu'aissi m'auci em plaia,",
        "per que non vuel qu'autra m'eschaia.",
        "mais il me tormenta et m'esglaia,",
        "don sovinent",
        "sent",
        "martire",
        "consire,",
        "car dire",
        "non aus mas qu'il m'aia",
        "cor convinent",
        "ient, . . . .",
        "traire,",
        "delire,",
        "qu'ab rire",
        "quen fai, mi menaia;",
        " et mi te en tal vistenca,",
        " que d'al non ai sovinenca",
        " mais de leis, qui toz iors ienca.",
        " et pois sim fai apervenca",
        " qu'aia de s'amor tenenca,",
        " per que m'o met a sufrenca?",
        "car ondranca",
        ". . . . . . . .",
        "e pesanca",
        "      mien lanca",
        "      ses doptanca,",
        "      qu'ab semlanca",
        "  . . . . . . . . . . .",
        "       . . que.n fai,",
        "       mi retra",
        "       que iama",
        " non don desesperanca,",
        "  per qu'atendra",
        "       e veirai,",
        "       si iama",
        "       trovara",
        " ab lei nulla acordanca,",
        "    si que l'esma",
        "       que ieu n'ai,",
        "       torn en iai,",
        "       dun murrai,",
        " si non l'en pren pizanca."
    ],
