    "Genre": "Cobla",
    "Title": "Ges non fail, quan s'aven",
    "FullText": [
        "Ges non fail, quan s'aven,",
        "qi di so que coven,",
        "qel fals fail ver dizen",
        "el leials fail menten,",
        "c'atressi faillen van",
        "fals lealtat menan",
        "com cel leials di enian."
    ],
