{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Era, sim fos en grat tengut",
    "FullText": [
        "Era, sim fos en grat tengut,",
        "    Preireu ses glut",
        "Un chantaret prim e menut",
        "    Quel mon non a",
        "Doctor que tan prim ni plus pla",
        "      Lo prezes",
        " Ni melhs lafines;",
        "    E quim crezes",
        "    Caissi chantes,",
        "         Polira,",
        "         Forbira",
        "         Mo chan",
        "      Ses afan",
        "           Gran.",
        " Mas, a lor veiaire,",
        " Car non sabon gaire,",
        " Falh, car no lesclaire",
        "      Daitan",
        "Que lentendesson neis lenfan.",
        "E ja magra del tot vencut,",
        "    Si Deus maiut,",
        "Ma belamia, mas del trut",
        "    Levet la ma,",
        "Per que mos melher chans rema;",
        "      Que non es",
        " Bo com prezentes",
        "    So que chamjes",
        "    Ni pejures",
        "         Per ira.",
        "         Que? Vira",
        "         Talan,",
        "      Quenganan",
        "           Van",
        " Trich- e galiaire",
        " Gentil de bon aire!",
        " No volhatz retraire",
        "         Dengan",
        "Vas celas que galiaran.",
        "E pos aissi ma retengut",
        "    Calhors nom mut,",
        "Volha caia joi e salut;",
        "    Caissi parra",
        "Si dic ver daisso don mi va:",
        "      Que, sil bes",
        " Caten nom tarzes,",
        "    Sol comenses,",
        "    Eu pois ades",
        "         Grazira,",
        "         Servira",
        "         Chantan",
        "      E lauzan",
        "           Lan",
        " Quem fo comensaire",
        " Desquivar maltraire.",
        " Tan sui fis amaire",
        "         Quenan",
        "Vai mamors ades esforsan.",
        "Pero ben ai lo tems agut",
        "    Quez a perdut",
        "Mo tengra, sagues tan volgut,",
        "    Ni mes en va",
        "Mo chantar, mas aissi sescha,",
        "      Tro merces",
        " O melhur apres.",
        "    E quim mostres",
        "    Com men lonhes,",
        "         Garira,",
        "         Gandira",
        "         Lonhan",
        "      Esperan",
        "           Man",
        " Deviro Belcaire;",
        " Car no posc de laire",
        " Mo fat cor estraire",
        "         Ni blan",
        "La perda que pris per lo gan.",
        "Aissi mes tot dessovengut",
        "    Can ai vezut,",
        "Car sol mapelet un jorn dru",
        "    E, si mestra",
        "So quem dis, malestan ser;",
        "      Canc, pos pres",
        " Aguem que mames,",
        "    Non cut proes",
        "    Quen rem vires.",
        "         Mentira?",
        "         Sofrira",
        "         Pensan",
        "      Sofertan,",
        "           Can",
        " Me volc amors faire;",
        " Mas, pel chap mo paire,",
        " No serai confraire",
        "         Denhan",
        "Damor quem prenda de lun pan.",
        "Canc nom plac amors per escut",
        "    A cors batut",
        "Dun privat e daltrescondut!",
        "    Mas quim volra,",
        "Tota laurai e tot maura.",
        "      No dic ges,",
        " Ans quel tot perdes,",
        "    Non esperes;",
        "    Que drutz engres",
        "         Sara,",
        "         Sospira",
        "         Cudan,",
        "      Menassan",
        "           Dan.",
        " Pero sofertaire",
        " Pren enans repaire",
        " Que glotz menassaire",
        "         Cridan",
        "Cals colps faria de so bran.",
        " Fols es domneiaire,",
        " Sab critz ni ab braire",
        " Vas se vol atraire",
        "         Preian",
        "Bona domna ni benestan."
    ],
