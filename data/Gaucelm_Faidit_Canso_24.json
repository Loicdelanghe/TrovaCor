{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Ben for oimai ",
    "FullText": [
        "Ben for oimai,",
        "segon ma conoissensa,",
        "plaitz avinens,",
        "sa ma domna plagues,",
        "que, pois non sa",
        "ses lei aver guirensa,",
        "cumiliens</em",
        "li mostres e-ill disses",
        "cuns jauzimens",
        "me vengues,",
        "e son cors ga",
        "qes, en valor veraia,",
        "bels e plazens ;",
        "que no-ill faill de totz bes,",
        "mas car li pla",
        "queu descaia !",
        "Tostemps penra",
        "en grat so que-m neschaia,",
        "cAmors, e sens,",
        "man en tal saber mes,",
        "cades serai,",
        "en sa franca manaia,",
        "obediens",
        "a son gen cors cortes ;",
        "quenaissi-m vens</em",
        "bona fes,",
        "can pietz me fa",
        "creis lamors e comensa,",
        "mas lo parvens",
        "ab que-m te sobrepes",
        "me don esgla",
        "ni temensa",
        "Ja non creira",
        "que merces no la vensa,",
        "mas espavens,",
        "car avengut non es,",
        "me don esmai,",
        "e la dura crezensa",
        "on sos cors gens",
        "ses fermatz et empres ;",
        "mas recrezens",
        "non soi ges,",
        "anz lamara",
        "tostemps  Dieus, que li plaia ! ",
        "que eissamens,",
        "ja grat no men saubes,",
        "poder non a",
        "que-m nestraia",
        "Ara ben sai,",
        "pois tan es pros e gaia,",
        "per pensamens",
        "tant viatz ma conques,",
        "quieu no mapa",
        "aillors, e sil mapaia",
        "enansamens,",
        "conques honor nagues,",
        "ler honramens ;",
        "mas eu pes",
        "que pauc viurai ;",
        "si socors ses bistensa,",
        "car bos atens,",
        "mi degr aver trames ;",
        "on non partra",
        "mentendensa",
        "E sil mestra",
        "sa valen mantenensa,",
        "greu mer guarens",
        "el mon nuill autra res,",
        "quen leis sesca",
        "caia toz jornz plevensa",
        "enves jovens,",
        "caillors no-m tira-l fres ;",
        "mas trop ven lens",
        "sa merces,",
        "caissi-m nesta",
        "si ja de lui ben aia",
        "lo cors sofrens ;",
        "mas ella, que-m ten pres,",
        "li pot dar jai",
        "si lassaia !"
    ],
