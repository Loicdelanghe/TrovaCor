{
    "Author": [
        "Arnaut_de_Maroill"
    ],
    "Genre": "Canso",
    "Title": "Aissi cum mos cors es ",
    "FullText": [
        "Aissi cum mos cors es",
        "francs e fins vas Amor,",
        "ab mais d'umilitat,",
        "m'a Jois a sa part pres,",
        "que maltraich ni dolor",
        "non planc ni m'es cozens,",
        "tant i conosc d'onor.",
        "Mas beus dic, ses amor,",
        "bona dompna valens,",
        "tant me vezes cochat,",
        "si Merces nom socor,",
        "em que n'auretz pechat.",
        "E si jam veigna bes",
        "ni gaugz de vostr' amor,",
        "tant fina voluntat",
        "non cre mais homs agues",
        "as dompna ni seingnor ;",
        "c'ab bels digz avinens",
        "enans vostra honor",
        "et am tant de doussor",
        "lo vostr' enseignamens",
        "em ven parlars per grat,",
        "la bocham n'a sabor,",
        "quant ai d'autras parlat.",
        "Dompn' ab cors gai, cortes,",
        "flors de joi e d'amor,",
        "e miraill de beutat,",
        "pros ni rics nom feing ges",
        "contra vostra valor ;",
        "mas pro sui conoissens",
        "quim fa ben ni honor,",
        "et en luoc de ricor",
        "sui vos obediens",
        "e tant fin' amistat",
        "c'ades i trob meillor",
        "mon fin cor esmerat.",
        "Amors, quels fis cors vens,",
        "sil noms es vers damor,",
        "merce e pietat,",
        "a lei d'ome conques",
        "cui son ops valedor,",
        "te clam, quels aturs vens,",
        "quem fassatz tant d'onor",
        "c'ab leis, vas cui ador,",
        "m'enrazon Chausimens ;",
        "quel cor hi ai pausat",
        "si qu'eu nol vir aillor",
        "en nuil autre pensat.",
        "E sius adui Merces,",
        "quem fassatz tant d'amor",
        "a lei d'aman amat... !",
        "Ai ! doussa, franca res,",
        "ar ai dich gran follor,",
        "car me pres ardimens",
        "qu'ieus quises tant d'onor !",
        "Mas a fin amador",
        "eu venir gauzimens",
        "e ric joi e d'onrat,",
        "gen sui el grat aussor",
        "e siam perdonat.",
        "Gen Conquis, la lauzor",
        "el bos esseignamens,",
        "que Dieus vos a donat,",
        "en un jorn de pascor",
        "no serion comtat."
    ],
