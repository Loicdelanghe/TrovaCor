{
    "Author": [
        "GaucelmFaidit",
        "Peirol"
    ],
    "Genre": "Tenso (Partimen)",
    "Title": "Gaucelm, diguatz mal vostre sen ",
    "FullText": [
        " Gaucelm, diguatz mal vostre sen",
        "qals drutz ha mais de son plazer ?",
        "ab sa bona dona jai",
        "ot una nueit, e non lo fai ;",
        "ho cel qui ve a parlamen,",
        "o a lezer gaire",
        "mas quant duna vetz faire,",
        "qui meteis torna sen ?",
        " Peirol, al meu conoisemen,",
        "una nueit hi pot jazer",
        "u ben aver dos tans de jai",
        "que sel quo fai e pueis sen vai ;",
        "quel jazer ha plazers tals cen,",
        "es qui be-ils sapcha traire,",
        "qinz es meiller amaire",
        "que-l fait com en tal cocha pren.",
        " Gaucelm, ben ha gran espaven",
        "quel ques en autrui poder,",
        "que trastot una nueit i jai",
        "onc cella que plus li plai,",
        "on pot aver son talen",
        "voluntat faire,",
        "on trai negus pecaire,",
        "fern, aital turmen.",
        " Peirol, molt vos razonatz gen,",
        "amor no faitz parer",
        "quen sapchatz tan con ieu en sai!",
        "zetz com ab sidons maltrai",
        "brassan et baizan sove;",
        "on lo mieu vejaire,",
        "on es cortes amaire",
        "ui tals maltraitz fai espaven.",
        " Gaucelm, aissi non a conten,",
        "a dreg lo poscatz mantener :",
        "faires non es, quant seschai,",
        "otz los autres plazers desfai ;",
        ", qui recep son joi breumen",
        "bans que repaire,",
        "quel jois don es laire",
        "ura pueisas longamen."
    ],
