{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Ans que venhal nous fruchs tendres",
    "FullText": [
        "Ans que venhal nous fruchs tendres",
        "Nil sobrefais brondels baisse,",
        "Plei mo coratge lamas",
        "Vas unamor e lassenh.",
        "Si tot lo maviespars",
        "Volh queras vir e sarenh",
        "Daltrobre daltre chaptenh.",
        "Et enaissi frescs es tendres",
        "Que per malpas ni per raisse,",
        "Si bem va len ni de pas,",
        "Nom lais a virar lengenh",
        "Si quelplus de mos afars",
        "Poscha tornar a nosonh !",
        "Que lai vir la forsel genh",
        "Ols olhs el coratge tenh.",
        "E si mest amics, non tendres",
        "Nit pes, qui que ten so daisse,",
        "So quera ves ni veiras :",
        "CAmors me cochem destrenh.",
        "E sim nerestranhs ni pars,",
        "Era, pos saivireponh,",
        "Convenra cal seu senh renh",
        "Els altres torn en desdenh. ",
        "Car de filhas a dos gendres,",
        "Pot om greu far no sabaisse",
        "Vas lunque chascu ser as ? ",
        "Si grans forsa no mempenh",
        "Calhors me fassamics chars. ",
        "E saissi fines, essonh",
        "Mostres volers !  Noi retenh,",
        "Mas quel me vendo mempenh.",
        "E sil malvatz crup-en-cendres",
        "Senardis quen lais seslaisse,",
        "Vils sia tengutz o bas;",
        "Dezafrenatz domneiars",
        "Quil pretz noi garda nil sonh.",
        "E seu a mos precs avenh,",
        "Nom vendra be qui bem penh ?",
        "Per trussar ni per divendres",
        "Nom destric que non engraisse,",
        "Sil seus cors delgatz e gras",
        "Mes de pres, caissi revenh,",
        "Si bem nave greus parlars ;",
        "Car ges monge de Cadonh",
        "Nos fion en entresenh,",
        "Ca ver nesci men depenh.",
        "E cui parra greus laprendres",
        "De mo chantar, no sen laisse,",
        "Si nol sui del dir eschas,",
        "Cab fi coratge lensenh,",
        "Si tot Mo-Senhor no mars,",
        "Si cuda que fassab onh ;",
        "Caissi lescurcomebenh :",
        "Mo trobar ab saber prenh!",
        "Can laltre sen van, eu venh,",
        "Si Deus lam salf e lam senh !"
    ],
