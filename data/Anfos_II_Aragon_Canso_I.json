{
    "Author": [
        "Anfos_II_Aragon"
    ],
    "Genre": "Canso",
    "Title": "Per manhtas guizas m'es datz ",
    "FullText": [
        "Per manhtas guizas m'es datz",
        "joys e deportz e solatz,",
        "que per vergiers e per pratz,",
        "e per foillas e per flors,",
        "e pel temps qu'es refrescatz,",
        "aug alegrar chantadors;",
        "mas al mieu chan neus ni glatz",
        "nom notz, ni m'ajud'estatz",
        "ni re, for Dieu et Amors.",
        "E pero ges nom desplatz",
        "lo belh temps ni la clardatz,",
        "nil dous chans qu'aug pels playssatz",
        "els auzelhs, ni la verdors,",
        "qu'ayssim suy ab joy lassatz",
        "ab una de las melhors :",
        "en lieys es sens e beutatz,",
        "per qu'ieu li do tot quan fatz,",
        "e joys e pretz et honors.",
        "En trop ricas voluntatz",
        "s'es mos cors ab joy mesclatz!",
        "Mas no sai si s'es foudatz",
        "o ardimens o paors,",
        "o grans sens amezuratz,",
        "o si s'es astre d'Amors,",
        "qu'anc, de l'hora qu'ieu suy natz,",
        "mays nom destreys amistatz",
        "nim senti mals ni dolors.",
        "Tan mi destrenh sa bontatz",
        "sa proez'e sa beutatz",
        "qu'ieu n'am mais sofrir em patz",
        "penas e dans e dolors",
        "que d'autra, jauzens amatz,",
        "grans bes faitz e grans secors;",
        "sos homs plevitz e juratz",
        "serai ades, s'a lieys platz,",
        "avan totz autres senhors.",
        "Quan mi membra dels comjatz",
        "que pris de lieys, totz forsatz,",
        "alegres suy et iratz,",
        "qu'ab sospirs mesclatz de plors",
        "me dis : Belhs amicx, tornatz,",
        "per merce, vas me de cors!",
        "Per qu'ieu tornaray viatz",
        "as lieys, quar autr'embayssatz",
        "no m'es delietz ni sabors."
    ],
