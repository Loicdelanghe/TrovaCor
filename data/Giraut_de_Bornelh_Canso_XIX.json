{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Nom platz chans de rossinhol",
    "FullText": [
        "Nom platz chans de rossinhol.",
        "Tan ai mo cor morn e trist !",
        "E pero sim meravilh,",
        "Car no malegret abrils ;",
        "Canc mais no fo negus ans",
        "De joi nom dones dos tans.",
        "Mas ogan nom platz la flors",
        "Nil fruchs del ram no magrada.",
        "Morir me faran de dol",
        "Ist messatger que man quist.",
        "Ai ! car se saubesson ilh",
        "Com saim valgrus paucs cortils",
        "Mais que lai us palais grans !",
        "Trop mes lor solatz pezans",
        "E parra me dezonors,",
        "Sab lor torn en mencontrada.",
        "Pauc save daisso que sol,",
        "E no cre canc mais fos vis",
        "Com vas sa terra seissilh ;",
        "Mas me es salvatge vils",
        "El repairars mes afans !",
        "Peitz trac on plus lai menans",
        "Si que vergonhe paors",
        "Men dobla quega vegada.",
        "Qui mo lauza, be nom vol,",
        "E tu, flac cor, com volguist",
        "Que tan claramors rolh,",
        "Anc noi fezist que gentils ;",
        "Canc cors de dos fis amans",
        "No vi om melhs dus semblans.",
        "Mas cor quet sobres Amors,",
        "Tu las erapoderada !",
        "Ja per aisso no macol,",
        "Seu lai vauc, celha ni cist,",
        "Que del tornar mavolpilh ?",
        "Cus jois sobresenhorils,",
        "On estai ferms mos talans,",
        "Es, tals, per queu no balans,",
        "Don nom pot lonhar valors,",
        "Sim venien plana bada.",
        "Mas pero pel fort lassol",
        "De la man ab quem prezist",
        "Velh la noch e mestendilh",
        "E no taturs ni tapils ! ",
        "Bela domna benestans,",
        "Cest anars nom sia dans ;",
        "Quez eu tornarai de cors,",
        "E vos nom siatz chamjada !",
        "Anc pairis contra filhol",
        "No fetz tal falha, per Crist,",
        "Ni paire contra so filh",
        "De lai on sabrival Nils",
        "Tro sai on sols es colgans ;",
        "Per que deu esser mos chans",
        "Sobrels autres chantadors",
        "Per vos, domna, cai amada !",
        "Era nom platz chans ni flors",
        "Per vos, domna, cai laissada."
    ],
