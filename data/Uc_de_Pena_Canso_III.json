{
    "Author": [
        "Uc_de_Pena"
    ],
    "Genre": "Canso",
    "Title": "Uns novels jois m'adutz ",
    "FullText": [
        "Uns novels jois madutz",
        "Conort don sui jauzenz,",
        "Qar novels jauzimens",
        "Mes douzamen vengutz",
        "Per tal qes flors e frutz",
        "Sobre totas beutatz;",
        "E quar ses esmeratz",
        "Mos fiz cors vas samor,",
        "Dei anantir lauzan",
        "Sos prez e sa valor,",
        "justif",
        "Ques caps de cortezia.",
        "Ab joi sui retengutz",
        "Qe mes douz e plazenz,",
        "E sui traitz de turmenz",
        "On trop era tengutz;",
        "Pero ges non sui dru[t]z,",
        "Mas tan sui aut pojatz",
        "Qem sembla gran[s] foudatz:",
        "Mas qan mi pens lonor",
        "El joi qieu nai baizan,",
        "Mos cor[s] en gran [doussor]",
        "justif",
        "Estai la noig el dia.",
        "E car non es saubutz",
        "Mos jois ni mos talenz",
        "Per las malvaizas genz,",
        "Sui del tot ereubuts,",
        "Qels an de tal lor cutz",
        "On non es mos pessatz,",
        "E sui de tal privatz",
        "Dont nul lauzenjador",
        "Non podon tener dan:",
        "Pero per servidor",
        "justif",
        "Maura tant cant vius sia.",
        "Ai, Deus! Com es cregutz",
        "Lo focz qes tant ardenz!",
        "Qe la noig en durmenz",
        "Li sui devan vengutz,",
        "El sieu[s] bel[s] cors es nutz,",
        "Blancs e dreitz e dolgatz,",
        "Ez eu, agenolliatz",
        "Devan leis, ades plor",
        "E clam: Merces!, ploran",
        "Qe oblit sa ricor",
        "Em prendesa bailia",
        "Chanzos, ab mil salutz",
        "Vai al seu cors plazenz,",
        "Car la estai jovenz",
        "E pretz es retengutz,",
        "E dilh quil traja lutz",
        "Lo coven qe<sup>.</sup>m fo datz,",
        "Car om enamoratz",
        "Non pot suffrir dolor,",
        "Qenanz i vauc doptan",
        "E nai gaug e paor,",
        "Tan tem sa segnoria."
    ],
