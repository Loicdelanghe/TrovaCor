{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "De faire chansso ",
    "FullText": [
        "De faire chansso",
        "zo,",
        "per atendre razo",
        "que fos plazens e gaia,",
        "on ma faich ric do",
        "Amors, e taing qe-m plaia ;",
        "onosc e sai",
        "que bon atendre fai ;",
        "quera, mal grat que naia,",
        "on non ai",
        "or que ja la prec mai,",
        "obat qe-m ten gai.",
        "E, pois tant be-m va",
        "qe partitz sui de lai,",
        "ben coven e seschai",
        "qieu grazisc e retraia",
        "onor, que matrai,",
        "b franquesa veraia,",
        "vas tal dompn Amors,",
        "ont es pretz e valors ;",
        "per ques fols qui sesmaia,",
        "qui vis las errors",
        "qai pres aillors,",
        "ve cum sui sors.",
        "Doncs, dic qes follors",
        "qui reign ab mals seignors",
        "on benfaitz ni socors",
        "o-il veingna ni leschaia ;",
        "z es grans honors",
        "quom satraia",
        "on sap e ve",
        "qa franques e merce ",
        "que-l bos seigner sessaia",
        "far be,",
        "malvatz non val re ;",
        "z dechai so que te.",
        "Aissi sai e cre",
        "que cuidet far de me",
        "que non a ab se",
        "mais poder qe-m dechaia,",
        "que tals mi rete",
        "prezo savaia,",
        "qes plus bellassatz",
        "os pretz plus prezatz ",
        "b que-l don no mestraia,",
        "qe-m mandet en patz,",
        "os valens cors honratz,",
        "on chant e massolatz.",
        "E veira-m viatz,",
        "a mon Bel Thesaur platz,",
        "ui es Monferratz,",
        "on jois e pretz sapaia ;",
        ", si-m soi tardatz",
        "vezer, no-il chaia",
        "pessar,",
        "qe-m vuoill ochaisonar,",
        "que la paors mesglaia",
        "m son cors car ;",
        "qom non pot ben amar",
        "men ses doptar !",
        "Per qe-il vuoill mostrar",
        "que mais fai aprezar",
        "qui sap, ses lonc prejar,",
        "z com en crit ni-n braia,",
        "on joi conquistar ;",
        "qui vol qom mal traia",
        "onc temps en perdo",
        "on a larc cor ni pro ;",
        "mas qui leu don e paia,",
        "op dir de no,",
        "u na rie guizardo",
        "b plazer bel e bo.",
        "Ma gaia chanso,",
        "vueilh qen des ochaizo",
        "N Ric de Joi part Blaia,",
        "qes gabatz per bo,",
        "qes gabatz per bo,",
        "qieu nai lonja sazo",
        "zo."
    ],
