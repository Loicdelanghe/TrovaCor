{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Razon e mandamen ",
    "FullText": [
        "Razon e mandamen",
        "ai de lieis on menten",
        "e far gaia chanso,",
        "oncs, pois quil men somo,",
        "ben coven der enan",
        "queu malegr en chantan",
        "mieills que far no solia ;",
        "queras conosc e sai,",
        "pois mos enans li plai,",
        "qen francha seignoria",
        "ai mes mon cor e me ;",
        "per so taing e-is cove,",
        "pois qus seigner fai be",
        "a son hon servidor,",
        "qel se meillur e cresca sa valor.",
        "Qui don de seignor pren",
        "non es ges avinen",
        "qe-il fassa mespreiso",
        "as lui, ses ochaiso ;",
        "ni non es benestan",
        "si puois li gier son dan",
        "ni so que non deuria ;",
        "e pois dompna tan fa",
        "ca son amic satrai,",
        "e lus en lautre-is fia,",
        "non sai don pois lor ve",
        "qe lus lautre malme,",
        "mas tant sai ieu e re",
        "qe cel a mais damor",
        "qe mieils ama e-n reten mais dornor.",
        "En aisso fan no sen",
        "li drut, mon escien,",
        "e, qi-n jutj a razo,",
        "es anta senes pro ;",
        "(cades on mais auran",
        "amor, mieils prejaran",
        "sai e lai chascun dia ;)",
        "e per aqest essa",
        "baiss Amors e decha",
        "e leials drudaria ;",
        "car, per un qe-is capte",
        "as Amor ni vas se",
        "leialmen, ni rete",
        "aqestz aips lo meillor,",
        "en vezem mains que nan lo sordeior.",
        "Drutz cama falsamen",
        "eu, per dreich jutjamen,",
        "aver fals guizerdo ;",
        "mas a vos mi razo,",
        "bona dompna, daitan",
        "qen mi non a engan",
        "contra vos, ni bauzia ;",
        "e si-m donavatz ja",
        "segon lo cor qieu-s ai,",
        "ja ren plus no-us qerria,",
        "qe daitan bona fe",
        "cum anc hom amet re",
        "os am, e no-m recre",
        "per mal ni per dolor,",
        "ant vos ai cor de leial amador.",
        "Dompna, lo cor e-l sen,",
        "e-ls huoills e-l pessamen,",
        "ai en vostra preizo",
        "e non trob garizo,",
        "mal solamen daitan",
        "can vos estau denan ;",
        "adoncs mi par qeu sia",
        "lom el mon cui mieills vai;",
        "e quan mi part de lai",
        "men ven ire feunia",
        "qe-m lassa-l cor e-m te ;",
        "mas pois, qan mi sove",
        "e vos cui jois mante,",
        "oblit lira major,",
        "e torn mon cor en joi et en doussor.",
        "Bels Desirs, mout mi pla",
        "el vostre gen cors gai,",
        "car poja chascun dia",
        "en honor et en be,",
        "que chascus hom qe-us ve",
        "os enanss e-us mante,",
        "qe de gaug e damor",
        "so-il vostre dich, e-il faich son de lauzor."
    ],
