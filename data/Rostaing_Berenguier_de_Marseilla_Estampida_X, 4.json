{
    "Author": [
        "Rostaing_Berenguier_de_Marseilla"
    ],
    "Genre": "Estampida",
    "Title": "La dousa paria ",
    "FullText": [
        "La dousa paria",
        "De ma bell amia",
        "Mi ten nueg e dia",
        "Alegr e joyos",
        "Tant quautra que sia,",
        "Tant ha gran cumdia,",
        "Non vuell ni penria",
        "Nin suy enveyos ;",
        " Quar ha cara",
        " Beutat clara",
        "E cors grasios,",
        " Plasen cara,",
        " E lampara",
        "Fins pres precios.",
        "Tant es yen complida",
        "Daut pres que la guida",
        "Per quem ten a vida",
        "Et autra non vuell.",
        "Pros ez eissernida,",
        "De tot ben guarnida,",
        "Ab valor grazida,",
        "Plazens ses erguell,",
        " Agradiva,",
        " Senhoriva",
        "En tot so que tainh,",
        " On sabriva",
        " Valor viva,",
        "Que res no y sofrainh.",
        "E si mon corage",
        "Y met ni assage",
        "Daver alegrage",
        "Del sieu gen cors car,",
        "Gentil dagradage,",
        "De plasen estage,",
        "Non cre far follage",
        "Car non li truep par.",
        " Non fai failla",
        " Qui treba[i]lla",
        "Per donna valen ;",
        " Conque sailla",
        " E trassailla",
        "En plus donramen.",
        "Mos cors non remira",
        "Ren als ni desira",
        "Ni plus non cosira",
        "Nueg ni jorn languen,",
        "Ni plus non albira",
        "Si non ma en ira",
        "Mas quo nocz regira",
        "Ves mon languimen.",
        " Pos semblansa",
        " Dalegransa",
        "Mi fay gayamen,",
        " Que lavansa",
        " Li balansa",
        "Dun doucz jauzimen?",
        "Sim fezes valensa",
        "Sos cors quades jensa",
        "Fera conoissensa",
        "E fora devers ;",
        "E li gran bestensa",
        "Mi ten en temensa",
        "Que li mortz non vensa",
        "So ques mos volers.",
        " Si plus tarda",
        " Que plus marda",
        "Le gran fuocz que mart",
        " Er musarda",
        " Tota guarda",
        "Que de mort mi guart.",
        " Reire guarda",
        " Ni enguarda",
        "En neguna part",
        " Non fan tarda",
        " Que non marda",
        "Mi dons ab sesguart."
    ],
