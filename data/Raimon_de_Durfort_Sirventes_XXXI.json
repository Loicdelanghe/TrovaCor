{
    "Author": [
        "Raimon_de_Durfort"
    ],
    "Genre": "Sirventes",
    "Title": "Ben es malastrucs dolens ",
    "FullText": [
        " Ben es malastrucs dolens",
        " Lo Caersins a sos grens,",
        "Quan soant aitals presens ;",
        "Ben par que'l conselht sirvens :",
        "Ja elh non sia mos parens,",
        "Que s'elha me'n mostrs dos cens,",
        "Ieu los cornra totz jauzens,",
        "E pueis fora rics e manens,",
        "Neis li refermra las dens.",
        " Non es bona dmn' el mon,",
        " Si'm mostrava'l crn el con",
        "Tot atretal com ilh se son",
        "E pueis m'apelava : 'N Raimon,",
        "Cornatz m'aic sobre'l reon ,",
        "Qu'ieu no'i baisss la car' el front",
        "Com si volgus beure en fon :",
        "Drutz qu'a sa dmna aiss respon,",
        "Ben tanh que de son cr l'aon.",
        " Caersinatz trcher srs,",
        " Tu que d'aquel plach mal mrs",
        "Gartz, perqu, no'i tornas enqurs",
        "Cornar a drech o a envrs ?",
        "Que'l crns es ben lavatz e trs :",
        "Ieu en cornra cent milhrs,",
        "E si n'i a assatz de frs ;",
        "Si fossetz pendutz a Bezrs,",
        "Non feir' m tant chanons ni vrs.",
        " Pus tz malastrucs sobriers",
        " Non es Arnautz l'escoliers,",
        "Cui confondon dat e tauliers",
        "E vai coma penedensiers",
        "Paupres de draps e de deniers,",
        "Qu'ieu li donra grans loguiers",
        "Per  qu'ieu lai corns primiers",
        "E cornra mielhs que porquiers",
        "Ni Prta-jia l'escassiers.",
        " Arnaut escolier, vai m",
        " Ancanch o al mat",
        "A Na Enan, e digas l",
        "Que Raimons de Durfort li",
        "Que ben es pres del Caers",
        "Quand li mostrt son rabo,",
        "Mas grieu li respondra aiss",
        "Ans i cornra sens ta",
        "Plus fresc que sirvens apez.",
        "Bernat de Cornilh, ie 'us desf,",
        "Que aguetz del cornar fast ;",
        "Per mon Truc Malc, N'Audo,",
        "Te puesc desfar e per mi."
    ],
