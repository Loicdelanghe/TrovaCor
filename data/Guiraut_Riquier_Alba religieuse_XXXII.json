{
    "Author": [
        "Guiraut_Riquier"
    ],
    "Genre": "Alba religieuse",
    "Title": "Qui velha ses plazer ",
    "FullText": [
        "Qui velha ses plazer",
        "on pro lonc ser,",
        "alba deu dezirar",
        "que fai lo iorn parer:",
        "u dezir vezer",
        "ha del ver iorn clar,",
        "quar lonc temps ai velha",
        "b dan en escurta",
        "on volria yssir:",
        "per que ai gran dezir",
        "veraya clartat,",
        "que puesc avenir",
        "men vol far secors</em",
        "m>selha qua peccadors</em",
        "m>vius penedens es alba.</em",
        "Quar hom non a, per ver,",
        "far nulh ben poder",
        "verge pregar,",
        "maire de tot saber;",
        "quilh nacapta lezer",
        "b son filh quel pot dar;",
        "o es Dieus, per vertat,",
        "vers que li a dona",
        ", quelh vol exauzir",
        "os precx et obezir:",
        "oncx preguem la de grat,",
        "qua las armas gandir",
        "os fassa ver secors</em",
        "m>sella qua peccadors</em",
        "m>vius penedens es alba.</em",
        "Elha es per dever",
        "via de bon esper",
        "b quens devem salvar,",
        "portz quab ferm voler",
        "podem pregan aver,",
        "mar,",
        "maires de petat,",
        "ums de tota bonta",
        "utz de perir,",
        "porta de gaug complir;",
        "ol que carita",
        "jam, nons pot falhir",
        "far verai secors</em",
        "m>selha qua peccadors</em",
        "m>vius penedens es alba.</em",
        "Yeu, las, me dey doler",
        "u mort temer",
        "per mo malvat obrar",
        "[. . . . . . . . . . .]"
    ],
