{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Aquest terminis clars e gens",
    "FullText": [
        "Aquest terminis clars e gens,",
        "Ques tan deziratz e volgutz,",
        "Deu esser ab joi receubutz",
        "E chascus en sia jauzens,",
        " Car ven estatz",
        " Ab sas clartatz !",
        " A cui no platz",
        " Jois ni solatz,",
        " Non es amatz",
        "    Ni amaire.",
        "A me melhura mos talens",
        "Pel joi, car issem a la lutz.",
        "Que totz lo deportz el desdutz",
        "Conve questa sazo comens.",
        " Pos vei los pratz",
        " Els bois folhatz,",
        " Eu volh sapchatz",
        " Per amistatz",
        " Sui envezatz",
        "   E chantaire.",
        "Mo cor es plus gais e salhens,",
        "Car mes us messatgers vengutz",
        "Quem retrai dunamor salutz,",
        "Don me ve jois e jauzimens.",
        " Sim sui estatz",
        " Lonc tems iratz,",
        " Dezacordatz,",
        " Damor sebratz,",
        " Er posc assatz",
        "    De joi faire.",
        "Molt es grans la proezel sens",
        "Quela; tan bos sabers adutz",
        "Canc no fo per leis mentagutz",
        "Orgolhs ni nolh passet las dens ;",
        " Cumilitatz,",
        " Don es chargatz",
        " Sos cors prezatz,",
        " La ten en patz",
        " Elh ditz : Parlatz",
        "    E  no gaire !",
        "Sobre totz bos ensenhamens,",
        "Aitan fort es sos pretz cregutz,",
        "Es lo seus per melhor tengutz",
        "Ni ja no len er fachs contens;",
        " Ans a poiatz",
        " Los aussors gratz",
        " Cals plus senatz",
        " Es, so sapchatz,",
        " Greus la meitatz",
        "    A retraire.",
        "Tan es riche pros e valens",
        "Cela de cui eu sui rendutz,",
        "Per queu no deiessercrezutz",
        "CAmors me des tans dardimens",
        " Que si fors atz !",
        " De leis privatz,",
        " Vos diriatz",
        " So, sableisjatz,",
        " Qui foronratz",
        "    Lemperaire !",
        "Domna, mos pens e mos entens",
        "E totz mos respechse mos cutz",
        "Es en vostra merce chazutz",
        "E prendaus de me chauzimens ;",
        " Queum sui dun latz",
        " Pel col lassatz",
        " A vos donatz",
        " Et autreiatz,",
        " Car tan eratz",
        "    De bon aire.",
        " Domna, volhatz",
        " Que mos pensatz",
        " Sia vertatz",
        " E, sa vos platz",
        " Ma volontatz,",
        "   Me nesclaire",
        " Domna, sius platz,",
        " Merce naiatz",
        " E nom fassatz",
        "   Lonc mal traire !"
    ],
