{
    "Author": [
        "Blacatz"
    ],
    "Genre": "Canso",
    "Title": "Lo belz douz tems me platz ",
    "FullText": [
        "Lo belz douz tems me platz",
        "E la gaia sazos",
        "El anz dels auelos",
        "E sieu fos tant amatz",
        "Com sui enamoratz",
        "Fera gran cortezia",
        "Ma bella douz amia ;",
        "E pos nuil be nom fai,",
        "Et eu donc qe farai ?",
        "Tant atendrai aman",
        "Tro morrai merceian,",
        "Pos il vol caissi sia.",
        "Aissim son autreiatz",
        "Ab leial cor a vos,",
        "Bella dompna e pros,",
        "Qe nuil autre solatz",
        "Ni autramors nom platz",
        "Ni autra drudaria",
        "Ni mos cors nos cambia.",
        "Per vos, dompna, morrai.",
        "Car me trobaz vera",
        "Vos i prendetz lo dan ;",
        "E non es benestan",
        "Com eis los sieus aucia.",
        "Dompna, vostra beutatz",
        "E las bellas faizos",
        "Eill beill oill amoros",
        "El genz cors be taillatz,",
        "Don sui empreizonatz",
        "De vostramor, qem lia ",
        ". . . . . . . . . . . . . . . . .",
        "Ia de vos nom partrai,",
        "Qe maior honor a",
        "Sol en vostre deman",
        "Qe sautram des baisan",
        "Tot cant eu li qerria.",
        "Bem tengra per honratz",
        "E per aventuros",
        "Saprop cent braus respos",
        "En fos dun ioi pagatz.",
        "Ha ! dompn, humilitatz",
        "E merces nom valria ?",
        "Mes mavetz en tal via",
        "Dont nom desebrarai,",
        "Qe mos fis cors satra",
        "A vostra beutat gran,",
        "Qem fai soffrir laffan",
        "Em destreing noit e dia.",
        "Si per sofrir en patz",
        "Mais daltra ren, canc fos,",
        "Ni per far volontos",
        "Las vostras volontatz,",
        "Dompna, mochaiszonatz",
        "A vos non escharia,",
        "Qar il no sses ges mia",
        "Ni ves vos no laurai,",
        "Anz franchamen mapa",
        "Qan vei vostre semblan,",
        "E can vos sui denan",
        "Tot tort vos fuziria.",
        "Bella Cap, on quem sia,",
        "Vos am eus amara",
        "Ab leial cor vera",
        "Per zo qe valetz tan",
        "Qar eu eill plus prezan",
        "Volem vostra paria."
    ],
