{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Dun dot bell plaser ",
    "FullText": [
        "Dun dot bell plaser",
        "plasen,",
        "movon miei cant ver,",
        "alen,",
        "gien,",
        "car si mos solat",
        "plat",
        "alsfinsben credent,",
        "ni sieu be",
        "fats re,",
        "e midons me ve,",
        "cui ne soi grasire ",
        "Liei desire,",
        "si callior",
        "mon desir no vire,",
        "car lieis am e lieis ador",
        "e causisc per la meglior.",
        "Sol al sieu voler",
        "maten,",
        "car del sieu saber",
        "apren",
        "sen",
        "tal, don mes donat",
        "grat",
        "pelsplus conoisent ",
        "Tant gent me",
        "mante",
        "la sua merce",
        "car soi bos sofrire,",
        "ce gausire",
        "soi damor,",
        "on giausentconsire ;",
        "et anc a nul amador",
        "non avenc tant de ricor.",
        "Et fats so parer",
        "soen,",
        "car, del clar dut ser",
        "giausen,",
        "pren",
        "consiriersamat ",
        " Fat",
        "soi, e pauc sofrent,",
        "car en fre",
        "no-s te",
        "ma boca ; per ce",
        "tagn, las ! qieu-mnasire",
        "cant malbire",
        "sa valor,",
        "e fols trop pot dire !",
        " Soi donc fols, sieu dic monor ?",
        " Oc, se-l dittorn a folor.",
        "Com gia-m det poder,",
        "enten",
        "qieu ages leser,",
        "sen",
        "len",
        "los besce ma dat",
        " Pat !",
        "Sofren, clau las dent !",
        "No-t sove",
        "ce se",
        "pert drut, si no cre ?",
        " Trop pot ver asire.",
        " Voll maucire ?",
        "Si-m socor",
        "cill cui soi servire ?",
        "ni morai, si-n tais lausor,",
        "o si-l dir no lan sabor !",
        "Ben dei doncs temer",
        "temen ;",
        "pero, leis cesper",
        "grasen,",
        "ren",
        "merces dels onrat",
        "lat",
        "e ce-m fes present",
        "e ssap, se",
        "no-m ve,",
        "tant li ai lial fe,",
        "cel cor la remire ;",
        "e-n sospire",
        "e dolor,",
        "e-n trauc greu martire,",
        "car del tornar ai paor",
        "que-m tegna per mentidor.",
        "Pot li doncs cale",
        "sieu men ?",
        " Hoc, gia-t vol veser ;",
        "ai ten !",
        "fen",
        "tot altres pensat,",
        "nat",
        "e flacs pensament",
        " Tremer te",
        "cove ! ",
        " Vau duncs ! gioi mi me",
        "si q eu deia rire ",
        " E no-t tire,",
        "chanso ! cor,",
        "tost, ses escondire,",
        "aN Sobira, mon segnor,",
        "cui Pret pren per validor.",
        "NAgout aus eslire",
        "e N Plus Avinent, cap lor",
        "acap bon pretss e valor."
    ],
