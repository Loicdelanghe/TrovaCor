    "Genre": "Chanson religieuse",
    "Title": "Quis tolgues ",
    "FullText": [
        "Quis tolgues",
        "es tengues",
        "mals en que cossen,",
        "e fezes",
        "totz los bes",
        "que conoys ez enten,",
        "res non es",
        "que nogues",
        "'anar a salvamen",
        "als repres",
        "on la fes",
        "Dieu, quens aten",
        "qu'a bon port nos traisses,",
        "merce prometen.",
        "Prometen",
        "don valen",
        "obam Dieu tan cortes,",
        "que fazen",
        "e dizen",
        "o que crezem que l pes,",
        "quens defen",
        "a prezen,",
        "os mans non faym ges!",
        "Nons car ven,",
        "ans, sufren",
        "pera quens agues",
        "penedens humilmen,",
        "quar nos fes ens conques.",
        "Bens conques,",
        "quar mort pres",
        "per son poble dolen,",
        "que vengues,",
        "sis volgues,",
        "uy sals peneden;",
        "quel paires",
        "premiers fes",
        "Adams un falhimen,",
        "don fon mes",
        "sos heres",
        "en yssilh mot cozen,",
        "o que Dieus sa trames,",
        "quins rezemet moren.",
        "Mas moren,",
        "mal viven,",
        "cazem totz jorns el bres,",
        "en quens pren",
        "desceben",
        "'Enemicx de mals ples",
        "quens apren",
        "ens essen",
        "on vol de ben des,",
        "don tot len",
        "al arden",
        "fuec nos mena espes;",
        "e selh que li conten",
        "Dieu ben apres.",
        "Ben apres",
        "es, que res",
        "ol falh, sel quel desmen;",
        "   quar sotzmes",
        "demanes",
        "'Enemicx ses sen,",
        "qu'a perpres",
        "totz mals ves,",
        "per que fug mantenen",
        "quan sos pes",
        "es entes",
        "utz a nen;",
        "que Dieus endres",
        "quelh afortimen.",
        "Quar mals es",
        "tant apres,",
        "volgutz, faitz per la gen,",
        "pauc amatz bes,",
        "os ten Dieus en turmen.",
        "Narbones",
        "es malmes",
        "blasmatz per nonsen",
        "z er pus, si merces",
        "Dieu no y val breumen.",
        "Pus es grieus per un tres",
        "o mals que hom nol sen."
    ],
