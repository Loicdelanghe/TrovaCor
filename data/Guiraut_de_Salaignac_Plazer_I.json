{
    "Author": [
        "Guiraut_de_Salaignac"
    ],
    "Genre": "Plazer",
    "Title": "Esparviers et austors ",
    "FullText": [
        "Esparviers et austors",
        "E guirfals prendedors",
        "E falcos voladors",
        "E smirles montadors",
        "Voill eu, e pro de renda",
        "Am que mete despenda,",
        "Quenaissi mer honors;",
        "Que a totz los meillors",
        "Voill far don et esmenda.",
        "Bos levrers volvedors,",
        "Liamers fresadors",
        "Voill e los venadors",
        "E chins de sers odors,",
        "E queu lo glat entenda!",
        "Bem platz aitals fazenda;",
        "E voill bos chantador",
        "E bos violadors,",
        "Car solaz si remenda.",
        "Palafres ambladors,",
        "Beus e plans portadors",
        "E destrers corredors,",
        "Mainz seignals de colors",
        "Voill eu e mainta tenda,",
        "E quom per tot mi venda",
        "Tan quen don als plusors;",
        "Als grans et als menors",
        "Voill donar lor vivenda.",
        "Reis et emperadors,",
        "Ducs, marques et contors,",
        "Chastellans, valvassors ",
        "Tant es granz ma ricors",
        "Quieus voill!  a mi satenda",
        "E mos pretz noi deissenda!",
        "Tant voill denvaidors",
        "Que castels fortz ni tors",
        "Contra mi, nos defenda",
        "Los livres dels auctors",
        "Sai e dels ancessors,",
        "Los sens e las follors.",
        "Res nom faill mas amors.",
        "O genser, cui port benda!",
        "Voilla c'a mi se renda,",
        "Si tot ses caps e flors",
        "De totas las gensors. ",
        "De mi merces vos prenda!"
    ],
