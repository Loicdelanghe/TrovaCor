{
    "Author": [
        "Perdigon"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Verges, en bon'hora ",
    "FullText": [
        "Verges, en bonhora",
        "portes lo salvaire,",
        "que selh vos honora",
        "e us fai ioya faire;",
        "el pobol[s] que fora",
        "liuratz a maltraire",
        "os pregue sahora,",
        "santa plazen maire;",
        "quar dire desmay",
        "e de tot esglay",
        "guardatz lo pus laire",
        "que vas vos satray.",
        "Domna doussa e bona,",
        "humil, de bon aire,",
        "aiuda e perdona",
        "ad aquest peccaire;",
        "guarda ma persona",
        "anta e de mal faire,",
        "e marma razona",
        "ab lo tieu car paire,",
        "quels peccatz quieu a",
        "fatz ni ditz ni sa",
        "nom puescan mal faire",
        "quan del segliray.",
        "De graca plena",
        "avetz nom, Maria;",
        "quar getatz de pena",
        "cuy merce vos cria;",
        "lam ni cadena",
        "nol te nil tenria,",
        "pus quab quarantena",
        "gen vos humilia;",
        "penedensa fa",
        "hom iuste veray",
        "e per aital via",
        "va senes esmay.",
        "Regina dauteza",
        "e de senhoria:",
        "la vostra franqueza",
        "al mon en bailia;",
        "e tota boneza",
        "etz rozespandia,",
        "quar en vos ses meza",
        "graca floria,",
        "aisselh frug vera",
        "quintret ab lo ra",
        "en vos, dona pia,",
        "quan langel venc sai.",
        "Verges, en efansa",
        "nasquet lo dous sire",
        "e vos, ses duptansa,",
        "e quieu suy servire;",
        "la sua pitansa",
        "mi fassa iauzire",
        "ab gran alegransa",
        "els bes quieu dezire,",
        "quar gran dezir a",
        "quieu fos el renc la",
        "senes tot cossire",
        "on sanh Peirestay."
    ],
