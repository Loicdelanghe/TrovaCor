{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Si sotils sens",
    "FullText": [
        " Si sotils sens",
        "O plas aturs noi val",
        " Que mos leus chans",
        "Valhe poi e sesmer,",
        "No mes per re semblans",
        "Que poscha molt valer;",
        "Que la cude lesper",
        "Que men sol aiudar",
        "Part et a me no par",
        " Que nuls chantars",
        "Sia Valens ni chars,",
        "Si cudars o temers",
        "Opezanso plazers",
        "No mensenha com chan",
        "Grazissen o claman.",
        " E car no vens",
        "La benanansal mal,",
        " Es grans afans",
        "Celui que trop sofer",
        "Cades sia clamans",
        "De laltrui no-chaler.",
        "Voletz queus dial ver",
        "Quem desplatz en amar?",
        "Com lai poscha trichar",
        " Ni siavars",
        "Celui quilh sera clars",
        "E bevolens e vers.",
        "Dazai aitals poders",
        "Com son amic engan",
        "Nis paie de so dan!",
        " E sil cors gens",
        "Se vira, no men chal",
        " Vas fols mazans.",
        "Ab so que no sesfer",
        "De salutz ni de mans,",
        "Cut cab menhs de jazer",
        "Me poira retener;",
        "Car molt fai a prezar",
        "Cortes assolassar",
        " En mans afars,",
        "On se demoramars,",
        "E fai de grans plazers",
        "E pois adobus sers",
        "La corelha dun an",
        "A cels que ben i van.",
        " E seu sui lens",
        "Ni vir lo cor leial",
        " Nil dezenans",
        "De so quel vol, enquer",
        "Mas lais men?  , a tres ans,",
        "Queu trop en mo saber!",
        "Pos me donet lezer",
        "Ses forsa de preiar",
        "Mos-Senher de chantar",
        " E mos trobars",
        "Fo per samor espars,",
        "Adonc mereup em ders",
        "E falhiram sabers,",
        "Si per mais quelh deman",
        "Enquer com mo desman.",
        " E sim bistens",
        "Nim tel reis nilh reial,",
        " Lo pros es grans,",
        "Mal dans no sai cals er,",
        "E silh es corelhans.",
        "Car sauzet eschazer,",
        "Del venir, so plazer",
        "Fassa del be venjar.",
        "Pois sim letz esperar",
        " Els osteiars",
        "Quelh rei faran, lanars",
        "Val mais quel remaners,",
        "Pos rietatz ni valers",
        "No sen pot poiar tan,",
        "Queu trespasses so man.",
        " E Deus agens",
        "Ogan nostre chaptal",
        " El nos enans",
        "Tan que Sarrazi fer",
        "Sofran perdas e dans,",
        "Tro venhal dechazer.",
        "Et om no deu temer",
        "Mal per Deu gazanhar",
        "Ni no fai a doptar",
        " Lo comensars,",
        "Que Gascos e Navars,",
        "Si lor aondavers,",
        "Aduiral bos espers",
        "E Deus ira denan",
        "Los nostres chabdelan!"
    ],
