    "Genre": "Canso",
    "Title": "Lou premer ior que vi",
    "FullText": [
        "Lou premer ior que vi,",
        "m'abel",
        "li vostres biaus cors gens,",
        "    douz, plaisens,",
        "corteis et debonaire;",
        "e s'eu sap dir ni faire",
        "    nule ren",
        " que vos tengues a ben,",
        "ma douce chere amige",
        " al cors plaisen et gai,",
        " sachaz que mol mi pla",
        "s'eu fai ren qui vos sie."
    ],
