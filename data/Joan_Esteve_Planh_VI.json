{
    "Author": [
        "Joan_Esteve"
    ],
    "Genre": "Planh",
    "Title": "Co ssi moria ",
    "FullText": [
        " Co ssi moria",
        " suy trebalhatz,",
        " no say quem dia,",
        " pus quenrabiatz,",
        " tan me laguia",
        " li mortaldatz",
        " ques fetz lo dia",
        " de Caritatz,",
        "   quar plors",
        "   peiors",
        " no foron vistz,",
        "   dolors",
        "   maiors",
        " ni cors pus tristz;",
        "per quieu suy dolens",
        "e mans dautras gens;",
        "Dieus lur er guirens",
        "cum als ignoscens.",
        " Verges Maria,",
        "si quo venc en vos,",
        " pregatz lon pia",
        "quels salve e nos.",
        " Mai non cre sia",
        " le dans ploratz",
        " nil tristicia",
        " dels turmentatz.",
        " Qui quels vezia",
        " marturiatz",
        " ab dol, avia",
        " dins sos pessatz",
        "   tristors,",
        "   languors",
        " pus que marritz.",
        "   Secors,",
        "   amors",
        " de Dieu er guitz",
        "elhs e mundamens",
        "e lurs fallimens,",
        "e lai defendens",
        "els percussiens.",
        " Verges Maria,",
        "[si quo venc en vos,",
        " pregatz lon pia",
        "quels salve e nos].",
        " Mort, ab bauzia",
        " nos as raubaz,",
        " quen aital guia",
        " najas menatz:",
        " ses malautia,",
        " non cofessatz.",
        " Las, quin poiria",
        " viure pagatz?",
        "   Ranquors",
        "   peiors",
        " nos nan feritz;",
        "   senhors,",
        "   de cors,",
        " grans e petitz,",
        "nos quem sai vivens",
        "preguem humilmens",
        "rey dels elemens",
        "quelh lur er gandens.",
        " Verges Maria,",
        "[si quo venc en vos,",
        " pregatz lon pia",
        "quels salve e nos].",
        " Selh que volria",
        " esser salvatz",
        " ab Dieu deuria",
        " estar comtatz,",
        " pueys no seria",
        " per mort soptatz,",
        " Mar autra via",
        " tenols malvatz",
        "   trachors,",
        "   querrors",
        " an enriquitz.",
        "   Pavors,",
        "   temors",
        " daquels raubitz",
        "lur es dregz niens;",
        "Dieus ner punimens,",
        "als passatz suffrens",
        "ous e paciens.",
        " Verges Maria,",
        "si quo venc en vos,",
        " [pregatz lon pia",
        "quels salve e nos].",
        " Si bens envia",
        " Dieus temps torbatz,",
        " mortz, dolentia,",
        " de quem iratz,",
        " petit embria,",
        " ans malvestatz",
        " mais multiplia",
        " deves totz latz,",
        "   Menors,",
        "   melhors",
        " sai son aunitz.",
        "   Honors,",
        "   ricors",
        " vol hom; giquitz",
        "nes Dieus veramens",
        "e sos mandamens,",
        "Elh er salvamens",
        "als mortz soptamens,",
        " Verges Maria,",
        "[si quo venc en vos,",
        " pregatz lon pia",
        "quels salve e nos].",
        "Guillem ques valens",
        "e Lodeval mens",
        "prec Dieu dels mortz pens,",
        "el Ray eyssamens.",
        " Verges Maria,",
        "si quo venc en vos,",
        " [pregatz lon pia",
        "quels salve e nos]."
    ],
