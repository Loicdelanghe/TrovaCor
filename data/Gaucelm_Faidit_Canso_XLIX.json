{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Per l'esgar ",
    "FullText": [
        "Per l'esgar",
        "del temps clar,",
        "can la brun'aur' el freit",
        "a destreit",
        "los adreit",
        "auselet de cantar,",
        "'esbaudeia",
        "os coragies,",
        "car salvagies,",
        "'enueia",
        "ai estat",
        "'om men ten gia per fat.",
        "Esmendat",
        "e donat",
        "m'a amors ben e gient,",
        "per cel ren",
        "merces cen;",
        "qu'en aiso ai proat:",
        "chi feuneia",
        "oudatges,",
        "bons usages",
        "qui merceia,",
        "c'ab merce",
        "onqier drut, si nos recre.",
        "C'amors ve",
        "e sap be",
        "quill es verais o fals;",
        "er corals",
        "fins lials",
        "amics a cui conve,",
        "cals qu'en seiha",
        "os parages;",
        " viages,",
        "on qu'esteia,",
        "lo condui,",
        "fina amor, c'es ab lui.",
        "Tant d'autru",
        "gioi non fu",
        "enveos, cem quges",
        "nim penses",
        "ce giam des",
        "amors so qu'er m'adu",
        "n pleia",
        "oragies.",
        ",",
        "cem autreia",
        "qe concis,",
        "oi, cor, don tu ris.",
        "Mos Estuis",
        "volgra vis",
        "lo gasardon qem fa",
        "amors sai,",
        "cem ten gai;",
        "e mos Linhaures fis,",
        "quer, nom creiha",
        "uls damagies;",
        "l rics gages,",
        "crei, cem deia,",
        "el gens dos,",
        "ubut per els dos.",
        "Ma cansos",
        "an vais vos",
        "amia, lai on et,",
        "pel ric pret",
        "que avet,",
        "esters grat dels gelos,",
        "cui greiha",
        ",",
        "l lignagies",
        "ur sordeiha,",
        "ce nom par",
        "ben pro en lur gardar.",
        "Hon que seia",
        "os estages,",
        "coragies",
        "'asopleia",
        "ab cor clar",
        "as n'Agout, qe non a par",
        "d'acabar",
        "o c'a preis s'escai a far."
    ],
