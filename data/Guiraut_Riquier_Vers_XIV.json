    "Genre": "Chanson religieuse",
    "Title": "Mentaugutz ",
    "FullText": [
        "Mentaugutz",
        "auch que Dieus es",
        "e crezutz",
        "que de totz bes",
        "es la lutz,",
        "e quel mon fes,",
        "e que nutz",
        "per nos mort pres,",
        "e del vas",
        "ressors de mort,",
        "per qu'estor",
        "on e seran peneden",
        "uch li veray peneden.",
        "Mas tan len",
        "es bes volgutz,",
        "e corren",
        "mals es saubutz,",
        "qu'en parven",
        "non es temsutz",
        "Dieus, que ren",
        "meritz degutz.",
        "So es mes",
        "denant detras,",
        "per qu'em ras",
        "mi e de por",
        "perillam ab deport.",
        "Qu'om fa tor",
        "dreg conoyssen,",
        "per que por",
        "autruy soven",
        "a vil sort,",
        "lo sieu perden;",
        "el pus for",
        "son pus arden,",
        "per qu'es brutz",
        "qu'amors ni fes",
        "ni merces",
        "o son, q'usquecx a mal pas,",
        "per que venem a mal pas.",
        "Doncx tu, las,",
        "senes acort,",
        "quet faras?",
        "Aias recor",
        "que trop as",
        "estat el or",
        "ez auras",
        "so quet remor",
        "fach ab sen.",
        "No sias mutz",
        "quon avutz",
        "ben; cofes, repres,",
        "fai que no sias repres.",
        "Dieus cortes",
        "que vols e fas",
        "drech, qu'iest ples",
        "de gauch, a bras",
        "pren nostres",
        "faitz non d'a pas;",
        "del sotzmes",
        "vil loc trop bas",
        "ses conort,",
        "totz bes fazen,",
        "nos defen",
        "Senher, e lai nos perdutz,",
        "on non es lunhs bes perdutz.",
        "Belh Depor",
        "ayc mout valen",
        "e plazen,",
        "ol puesc mandar salutz;",
        "mas Dieus li sia salutz.",
        "Per saber suy esperdutz,",
        "quar vey que tant es perdutz."
    ],
