{
    "Author": [
        "Pistoleta"
    ],
    "Genre": "Canso",
    "Title": "Se chantars fos grazitz ",
    "FullText": [
        "Se chantars fos grazitz,",
        "si cum sol, ni solatz,",
        "bem tengra per faillitz",
        "qar tant men fui tarzatz ;",
        "mas chanz non ac saizon,",
        "pueis lo reis dAragon",
        "muric nil reis nAnfos",
        "e si per leis non fos",
        "cui sobt altras res blan,",
        "on chantera ugan.",
        "Anz mera relinqitz",
        "totz e desconortatz",
        "e dalegrier geqitz",
        "e de dompnei loignatz ;",
        "mas amors me somon",
        "qen fassa ma chanzon",
        "e qieu torn e ioios",
        "e gais et amoros ;",
        "e mesfortz derenan",
        "fin aman.",
        "Qom iratz ni marritz",
        "non par damor privatz ;",
        "anz sembla deschauzitz,",
        "se tot ses ensegnatz ;",
        "pero fai falison",
        "cel qi trop diras don,",
        "qira fai dun dan dos,",
        "zo es sos gazardos ;",
        "et amors vai tot lan",
        "us gaugz perchassan.",
        "Hai Dieus ! cum es garitz",
        "qi am e es amatz",
        "e iau e es iauzitz,",
        "on si ren per pagatz ;",
        "mas cel qam en perdon",
        "et anc amatz non fon,",
        "eu viure conziros ;",
        "mas ieu non sui clamos,",
        "anz sufr en patz lafan",
        "m ses tot enian.",
        "Hai ! bels cors gen bastitz,",
        "plazenz e deziratz,",
        "e totz bos aibz complitz !",
        "aillam merces, sius platz,",
        "ab vos de cui hom san,",
        "qe daltras non razon",
        "ni non sui enveios ;",
        "omna, eum rent a vos,",
        "per far vostre coman",
        "otz temps, vas on qieu an.",
        "Deus confonda ugan",
        "orgoil e cels qeu fan."
    ],
