    "Genre": "Canso",
    "Title": "Rics pres, ferms e sobeirans ",
    "FullText": [
        "Rics pres, ferms e sobeirans,",
        "omna, vos ten sobeirana,",
        "e [be] sai qes miel certana,",
        "ont ieu vos sui homs certans ;",
        "e per los oils de ma cara,",
        "bella dompna, plazenz, cara,",
        "anc nous ai voluntat vana",
        "nius fui un jorn flacs ni vans ;",
        "pero mais non viurai sanz,",
        "vostre gent[z] cors nom sana.",
        "E si vostre bel[s] cors planz",
        "lo mal qeu ai no maplana,",
        "ni vos nestatz segurana,",
        "e la mort sui seguranz ;",
        "car lo mal [s] damor mafara",
        "lo cors el cor, si que ara",
        "ai mal qAmors lo mamana,",
        "qar mi loing de vostras mans ;",
        "e si jaus estauc loindans,",
        "jes ma mor nous er loindana.",
        "Rics fora, sistes propdans",
        "e vos nim fosses propdana ;",
        "qar hanc nulla crestiana",
        "non amet tant crestians",
        "com am vos, qem faitz avara",
        "autramor, tant qe nos vara",
        "mos cors de vos on pres grana ;",
        "qar vos es de valor grans",
        "e non par siatz de grans",
        "qius aia color de grana.",
        "Mais namera Catalans,",
        "si vos fosses Catalana ;",
        "pero, car es Castelana,",
        "olgrieu esser Castellans ;",
        "qel cossir mi tol em gara",
        "ostre gentz cors, qant mesgara ;",
        "e car mi semblatz serrana,",
        "sui sers dels vostres serranz ;",
        "e servirai Surianz,",
        "vos fossetz Suriana.",
        "Ja nuls lauzengiers trafans,",
        "ni gelos, ni genz trefana,",
        "ni hom qui ab ditz vilanz",
        "fai sa lengua trop vilana,",
        "non tolran qeieu ancara",
        "non mir vostra faizon clara,",
        "per lur garda soteirana",
        "ni per gardar[s] soteirans :",
        "noi ses mes gaire mejanz,",
        "mas dAmor, qi es mejana.",
        "Domna, douzamenz magrana",
        "ab finz jois chascuns dels grans",
        "qem detz, e se ja viu sanz",
        "aisom tol la mort em sana.",
        "NAudeiart dels Baus, certana",
        "alors e fin[s] pres certans",
        "fan vostre[s] faigz sobeiranz",
        "vos de pretz sobeirana."
    ],
