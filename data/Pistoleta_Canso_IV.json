    "Genre": "Canso",
    "Title": "La maier temenza ",
    "FullText": [
        "     La maier temenza",
        "     qeu aia de re",
        "   es qe fassa faillenza",
        "     vas leis qim trai . . .",
        " de cui sui hom e servire,",
        "e prec, si li platz, non mazire,",
        "    qe seus sui e sera",
        "    totz temps qant [eu] vivrai,",
        " per far e dir son plazer,",
        "us dom esfortz e poder.",
        "     Ab ferma crezenza",
        "     et ab bona fe",
        "   [eu] vos port benvolenza,",
        "     qe dals nom sove,",
        " ni daltr afar non cossire,",
        "ni [no s]en re qeu tant dezire ;",
        "    e sel bos cors qeu sa",
        "    nom cre, doncs que farai ?",
        " qar senz vos non puesc aver",
        "ug, ni daillor, non lesper.",
        "     Mas long entendenza",
        "     ma [tant] trait ancse",
        "   canc, pos aic cognossenza,",
        "     nom puesc far mon be ;",
        " mas aissi com bos suffrire",
        "os sui del mal qeu trai grazire,",
        "    qar tant bella non sai ;",
        "    e sem dassetz unba",
        " tro qe fos luecs del iazer,",
        "uit mei trebaill foran lezer.",
        "     Doncs franqezaus venza,",
        "     pois per prec de me",
        "   non puesc trobar guirenza",
        "     ab vos ni merce,",
        " ni sai vas qal part me vire,",
        "qe vostr amors me vol aucire",
        "    senz colpa qeu no lai ;",
        "    e qi sens tort decha",
        " zo qe deu plus car tener,",
        "z pechatz lin deu eschazer.",
        "     Chanzos, part Valenza",
        "     vai a cel qe te",
        "   bon pres senes bistenza.",
        "     e larges ab se",
        " e cort de gaug e de rire",
        "e totz bos faigz, zo aug [ieu] dire,",
        "    ab cor fin e vera",
        "    e bels iocs, de qem pla",
        " qe non volgues retener",
        "zo qe fai altres dechaer.",
        "    Peire Belmon, oima",
        "    sapchatz qeus amarai,",
        " sol beus voilhatz captener ;",
        "qavols rics hom nom pot plazer."
    ],
