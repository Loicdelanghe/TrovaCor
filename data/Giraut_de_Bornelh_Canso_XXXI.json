{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Ab semblan me fai dechazer",
    "FullText": [
        "Ab semblan me fai dechazer",
        "Amors em dona marimen;",
        "Car semblan mes del joi caten",
        "Que jal cor nom nesclaire,",
        "Car en trop ric repaire",
        "Bels semblans me guida",
        "Quem ditz que jauzida",
        "Naurai ses falhia.",
        "Mas som dechai,",
        "  Don fort mesmai,",
        "Car lus semblans mabriva la",
        "E laltrem desvia.",
        "Ab bel semblan me fai voler",
        "Midons so que plus me defen;",
        "Ab art et ab fals genh me pren",
        "Com seu lera trichaire.",
        "Per leis pert mo veiaire,",
        "Tan mes abelida;",
        "Car on plus moblida",
        "Can ops me seria.",
        "Mos cors sen va",
        "Lai on li plai.",
        "Ses cor viu, car ab me no lai,",
        "Quilh la en bailia!",
        "Greu me poiria pro tener",
        "De samor ja segon mo sen,",
        "Pos aman noi trop chauzimen",
        "Si com fizels amaire.",
        "Donc pos noi gazanh gaire,",
        "Que non ai gequida",
        "Lamor quem convida",
        "Damar chascu dia?",
        "Car no posc mai,",
        "Per camarai;",
        "Que be leu enquera naura",
        "De joi a ma guia.",
        "Pos no posc mai, ab bon esper",
        "Aleujarai lo mal queu sen;",
        "Fis serai ses tot jauzimen",
        " E gais per lo maltraire,",
        "Entrom volha refaire",
        "Ma domna chauzida,",
        "Franchet eissernida,",
        "De bela paria,",
        "Ab cui esta",
        "Jois ab cor gai,",
        "Ensenhamens ab pretz verai,",
        "Sens e cortezia.",
        "Domnalh genser com pot vezer,",
        "Oimais me fossetz davinen;",
        "Que conoissetz mo fi talen",
        "E cous am ses cor vaire!",
        "Corteze de bon aire,",
        "Sun pauc metz aizida,",
        "Joios a ma vida",
        "Serai on queu sia;",
        "Si no, be sai,",
        "Tan can viurai,",
        "Si tot nom voletz, beus volrai,",
        " Si tot nom valia.",
        "Senher reis dArago, temer",
        "Vos devon vostre malvolen,",
        "Car fach lor avetz a prezen",
        "Totztems peitz lor afaire",
        " Quez om no sap retraire",
        "Si que nes aunida",
        "Totalh lor partida",
        "E lor senhoria",
        "Mor e desvai;",
        "Tan an desgla",
        "Quelh plus ric son tornat savai,",
        "Car lor pretz te via!",
        "Coms, fort me plai,",
        "Car tan satra",
        "Vostre noms vas fi pretz vera",
        "Quen re nos desvia!",
        "Ab joi ten vai,",
        "Chansos, en la",
        "Vas Mo-Senhor, ab cui esta",
        " Pretz e cortezia!"
    ],
