{
    "Author": [
        "Peire_dAlvergne"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Lauzatz si' Emanuel ",
    "FullText": [
        "Lauzatz si Emanuel,",
        "lo reys de terre de cel,",
        "ques trinus et unitatz,",
        "e filhs e sanctz esperitz",
        "e quasqus payre complitz,",
        "si qus noms es et us guitz",
        "et dieus et homs apellatz,",
        "En divers digz assemblatz",
        "totz, et una trinitatz,",
        "senes sustantia partir;",
        "quayssi tenc lun per maior,",
        "quom lautre non dic menor,",
        "mas un sol Dieu ieu azor",
        "l prec quem denheyssauzir,",
        "Seluy quel mon volc venir",
        "per nostres peccatz delir",
        "e per quels quatrelemen",
        "agron dessemblatz semblans;",
        "qualre noy era estans",
        "mas Dieus quespueys e denans,",
        "quanc non ac comensamen,",
        "Ni ia fin en negun sen",
        "non aura, quel resplanden",
        "e prim destinet, anceys",
        "quel fetz sobrescur la lutz,",
        "quar tan fermas sa vertutz",
        "quesser non pot descrezutz",
        "ni ren pus aver decreys",
        "En luy que det si meteys,",
        "per quel premiers malssesteys",
        "quera mout grans desconortz,",
        "quar selh quanc no fes peccat",
        "enc sufrir humanitat",
        "e mort desotz Pons Pilat",
        "obre sos vestirs sortz.",
        "Mas iamays non ler faitz tortz",
        "nil senhorejara mortz,",
        "luy qual ters iorn sors del vas,",
        "aissi cum era promes,",
        "per quel fels difern mespres,",
        "quant als dissipols crec fes",
        "e parec a sant Tomas.",
        "Pueys non say estet tan bas",
        "que de la vai Iozaphas",
        "un pueg desobrun peiro",
        "no montes en cel e pus;",
        "pueys venc lonzen iorn de sus,",
        "st soptans e clars e clus",
        "us dins una maizo.",
        "Per aver melhor razo",
        "ab bona entencio",
        "lur laisset ses ocaizo",
        "on quascus discipulus",
        "fos forz e ferms sos estrus,",
        "com Dieusdessendenz say jus</em",
        "lur det benedictio.",
        "Aquelh crey ieu per cuy so,",
        "que per nos pres passio",
        "e perdonet al lairo",
        "e ques trinitatz et us,",
        "selh que la maire Ihesus",
        "cossellet en la crotz sus",
        "e ques a venir el tro,",
        "Pus lo segle er cofus,",
        "per iutjar los blancs els brus;",
        "aquelh prec ieu que mescus",
        "mon cor e marmal do."
    ],
