{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Mas, com m'ave, Deus m'aiut",
    "FullText": [
        "Mas, com mave, Deus maiut,",
        "Qu era, can cut chantar, plor ?",
        "Seria ja per Amor",
        "Que ma sobrat e vencut ?",
        "E per amor nom ve jais ?",
        "Si fai ! Donc per que mirais",
        " Ni quem fai languir ?",
        "Que? non o sabria dir ?",
        "Caissi mes esdevengut",
        "Tot leu que perc ma valor",
        "E solatz no ma sabor.",
        "Esdevenc anc mais a drut ?",
        "Drutz sui eu ? no ? ni men lais",
        "Cades am forseis e mais",
        " E volh e dezir ?",
        "No ! Sui drutz ? Quim pot sofrir !",
        "Quera, car sol ai volgut,",
        "Me tenh per fin amador ;",
        "Amaire, si Deu azor,",
        "Sui eu fis e nom remu",
        "Lo coratge nil biais",
        "Damar leis per cui sui gais.",
        " Be pauc tem falhir ;",
        "Donc per que planh e sospir ?",
        "Car ben ai reconogut",
        "CAmors nom val ni macor.",
        "Nom val ? Et am la gensor",
        "Del mon ! No ma pro valgut ?",
        "No per re ! Ans dic quem trais,",
        "Can me det trebalh e fais",
        " Em fetz encobir",
        "So que nom pot avenir.",
        "E com? Non ai receubut",
        "Assatz de ben e donor",
        "De las mas de Mo-Senhor ?",
        "Si ai; mais an retengut !",
        "E que? Un conven ; quem frais",
        "Aicel que lira matrais",
        " Em fara morir,",
        "Sol quen son atur nom vir.",
        "Desvol so que la plagut ?",
        "Non o sai. Ja mer melhor ;",
        "Sin trac mal com cal greujor",
        "Dezira mais de salut !",
        "NAntic, e nous par assais ?",
        "Diatz oc, que, silh jam bais,",
        " Segur posc plevir",
        "Caucirem pot o garir.",
        "Mas sai ma mo dol cregut",
        "Us clams que fan entre lor",
        "Cilh dUrgel, per quelh pluzor",
        "Seran mort e confondut ;",
        "Quelh comtessab cui jois nais",
        "E sabers e pretz verais",
        " Sen cudet eissir,",
        "Qui lolh volgues consentir.",
        "Bels tenrai totz per savais,",
        " Si lan letz eissir,",
        "El rei, so vol consentir."
    ],
