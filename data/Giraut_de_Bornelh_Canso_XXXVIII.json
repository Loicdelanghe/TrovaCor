{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Car non ai",
    "FullText": [
        "   Car non a",
        " Joi que maon,",
        "   Me te de",
        " Chantar soven",
        " E, si menten",
        " En far chansos,",
        "   No mes pros;",
        "Caissi com solia",
        "Noi posc avenir,",
        "Ans men cut partir.",
        " E gierai men?",
        "   No per re!",
        " Queram sove",
        "Quim pres e sim ris",
        "Fors de mo pas.",
        "   E dira",
        " Qui es ni don?",
        "   Non eu, que",
        " Leugeramen",
        " Falh e mespren",
        " Quis fai janglos",
        "   A sazos.",
        "Per que, seu dizia,",
        "Cui am e dezir",
        "Pert, si no consir;",
        " Cab falhimen",
        "   Sestrai se",
        " Cilh cui quer be,",
        "Cui eu sui plus fis",
        "QuElena Paris.",
        "   Mas no sa",
        " Com de preon",
        "   Maperte",
        " Cai marrimen",
        " E de nien",
        " Fatz me gilos",
        "   Enveios,",
        "Cais queu conoistria",
        "Per sobras dalbir.",
        "Mas si Deus mar,",
        " Seu veramen",
        "   Be non cre,",
        " Si nom refre",
        "Daisso que mes vis",
        "Que dolz mer vezis!",
        "   Donc nom va",
        " Lo melhs del mon?",
        "   Som no ve",
        " Contravalen",
        " Al seu cors gen,",
        " Ben es razos",
        "   Camoros",
        "E jauzions sia",
        "Cui denhacolhir",
        "En grat so servir",
        " E cui consen",
        "   Josta se,",
        " Ja, per ma fe,",
        "Melhs non erassis!",
        "Fola res, que dis?",
        "   Que jam fa",
        " Mal e confon.",
        "   Deus, merce!",
        " Can fadamen",
        " Parlam soven,",
        " Si quel manbos",
        "   Ditz que tos!",
        "Com me confondria,",
        "Sim fai esjauzir?",
        "Ans li dei grazir",
        " Lo pensamen",
        "   Que men ve,",
        " Ab que mestre",
        "De so que lai quis,",
        "Que sols la servis.",
        "   Eram tra",
        " Vas mo segon",
        "   Ad esple",
        " Tot mantenen",
        " E port prezen",
        " Al rei nAnfos",
        "   De mos sos;",
        "Caltra manentia",
        "Non ai mas de dir",
        "Que laus perofrir.",
        " Car a valen",
        "   E mante",
        " Pretz, me conve",
        "Queu lestei aclis",
        "Sers oltramaris.",
        " Razo senten,",
        "   Sil mante",
        " Vas sanh terre,",
        "Car trop mais conquis",
        "Sobre Sarrazis!"
    ],
