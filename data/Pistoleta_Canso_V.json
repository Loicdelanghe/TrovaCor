{
    "Author": [
        "Pistoleta"
    ],
    "Genre": "Canso",
    "Title": "Plus gais sui q'eu non sueill ",
    "FullText": [
        "Plus gais sui qeu non sueill",
        "e plus enamoraz,",
        "si tot non sui amaz",
        "per leis cam mais qe me,",
        "ab cui non trob merce,",
        "ni la i pot hom trobar ;",
        "gardaz, seill volgues mal,",
        "n feira preiar.",
        "E car autra non voill",
        "en dreit damor, nim plaz,",
        "e car lim sui donaz",
        "e bon cor per iase,",
        "ni macuoill nim fai be,",
        "neus apenas sonar",
        "mi deigna, qant mi ve,",
        "om naus rancurar.",
        "Et a pauc nom trais luoill,",
        "qant li dis per solaz:",
        "dompn, ieus am, so sapchaz,",
        "mais qe neguna re ;",
        "e sim faz, per ma fe.",
        "Deus men lais mon pro far ;",
        "si fara, qan qe tric,",
        "mas trop mo pot tarzar.",
        "Doncs, per qe no men toill ?",
        "aram venqet foldatz !",
        "anz suffrirai en paz,",
        "qar enaissis cove ;",
        "qe fols es qis recre :",
        "qeu am mais esperar",
        "lo seu honrat esper",
        "qab autra gazaignar.",
        "Chansos, part Eissidoill",
        "ten vai tost e viaz",
        "a la bell on beutatz",
        "es e tuit complit be ;",
        "qella non faill en re,",
        "anz sen sap be gardar,",
        "qe si e Ventadorn",
        "fai chascun iorn puiar.",
        "Del franc rei me sove",
        "Aragon, cui Deus gar !",
        "que senes totz engeinz",
        " e ses malestar."
    ],
