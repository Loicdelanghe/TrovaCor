{
    "Author": [
        "Gaucelm_Faidit"
    ],
    "Genre": "Canso",
    "Title": "Solatz e chantar ",
    "FullText": [
        "Solatz e chantar,",
        "joy e deport e rire,",
        "cugei tot laissar",
        "e viur a gran martire ;",
        "mas silh cuy tenh car",
        "e cobey e dezire",
        "e dupt e reblan",
        "ol que torn en mon chan ;",
        "quera mortz a son dan,",
        "tz, e fai cortezia ",
        "quar no vol sufrir",
        "ma doussa car amia",
        "que-m laysse morir !",
        "Quar, si Dieus me gar",
        "lieys de cuy suy servire",
        " e no puesc jurar",
        "plus fort per vertat dire ",
        "non pogron durar",
        "may un jorn il sospire",
        "quieu de plan talan",
        "no moris deziran ;",
        "per so-lh grazisc chantan",
        "a la belh, on quieu sia,",
        "lonrar e-l servir,",
        "e-l joy que-m ven quec dia",
        "ui dezir.",
        "Be-m dey alegrar,",
        "gar silh que-m vol aucire",
        "mi vol esmendar",
        "o mal don suy sufrire,",
        "quab un dous bayzar",
        "mi venc al cor assire",
        "un ric joy prezan ;",
        "e si-n suy en afan,",
        "mos Bos Espers ma tan",
        "onat qieu no-l poiria",
        "la meytat grazir",
        "si per tostemps vivia,",
        "quan be mo cossir !",
        "Shom per ben amar",
        "fo anc damor jauzire,",
        "be-m deu joyos far",
        "la bella don no-m vire ;",
        "que vendre o dar",
        "me pot  et no salbire",
        "quautra mi deman ;",
        "quades, vas on quieu man,",
        "suy sieus, ses tot enjan ;",
        "e, si tant sumelia,",
        "que-m vuelh enriquir",
        "aquo quieu plus volria,",
        "be-m dey esbaudir !",
        "Quaissi-m fay tremblar",
        "ma domn el cor, e frire,",
        "quab sol son parlar",
        "olf e vir en cossire,",
        "quan son bel vis clar",
        "e son gen cors remire,",
        "reit e benestan ;",
        "et ai joya tan gran",
        "can mi fai bel semblan",
        "amor, que par que-m ria,",
        "qieu re no-lh sai dir",
        "aisso quops me seria :",
        "m fai joys falhir !",
        "De ben e donrar",
        "suy a mi dons grazire,",
        "e dey men lauzar,",
        "mas dautra part mazire :",
        "que, si tot no-m par,",
        "mon senhor suy mentire,",
        "quieu prec e reblan",
        "e cor e de talan :",
        "questat nai mais dun an,",
        "et ai fait gran folia ",
        "quab luy aug venir",
        "joy e pretz, tota via,",
        "uy quenuey ni tir !",
        "A Ma Capa man",
        "en ma chanso chantan",
        "ma benanansa gran !",
        "e lay, en Lombardia,",
        "guar Dieus de falhir",
        "Ric de Joy e samia,",
        "quant ieu dezir"
    ],
