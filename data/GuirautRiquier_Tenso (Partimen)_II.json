{
    "Author": [
        "GuirautRiquier",
        "Falco"
    ],
    "Genre": "Tenso (Partimen)",
    "Title": "Falco, dona avinen ",
    "FullText": [
        "Falco, don[a] avinen",
        "[Guiraut]",
        "matz may que res c'anc fos,",
        "[e] sabetz sertanamen",
        "qu'il ama atertan vos,",
        "on podetz aver;",
        "on faytz tot vostre voler",
        "desamatz,",
        "saben cal desplatz.",
        "Cauzetz ses falhensa",
        "cal plus vos agensa.",
        "Per bo tenc lo partimen,",
        "[Falco]",
        "Guiraut, mays l'una razos",
        "val mays a mon essen;",
        "ja nom sia autres pros,",
        "m mays leys que, si poder",
        "'a, fara mi mon plazer,",
        "que mon bratz.",
        "Per l'autr'enjanatz,",
        "car a ma parvensa",
        "fay o per temensa.",
        "Pres avetz nessamen",
        "[Guiraut]",
        "o volpilh de dezir blos,",
        "m desesperamen",
        "voletz esser amoros,",
        "faus o far non-poder.",
        "Trebalhatz may vuelh tener",
        "ley quem platz",
        "a ma voluntatz,",
        "que, ses joy, sabensa",
        "de sa benvolensa.",
        "Mays vuelh, per son cors plazen",
        "[Falco]",
        "balhat, estar joyos,",
        "que l'autra ab marrimen,",
        "per qu'ieu la&lt;u&gt;s lays a estros.",
        "Com la podetz mantener?",
        "Dol n'a can l'anatz vezer,",
        "e solatz",
        "de vos non li platz;",
        "ans d'elaus comensa",
        "yra e malvolensa.",
        "Quy pot complir son talen",
        "[Guiraut]",
        "o de qu'es enveyos,",
        "balhatz, non es parven",
        "que res sia sofrachos;",
        "mar ses bon esper,",
        "l trebalh el malsaber,",
        "vos l'ayatz,",
        "qu'iem son acordatz",
        "c'autra malsabensa",
        "mon plazer non tensa.",
        "S'a leys c'amatz finamen",
        "[Falco]",
        "balhatz ez enveyos,",
        "pueys nous tenra per valen,",
        "vas Amors non es pros;",
        "vas ela faytz non-dever,",
        "'ap joy se vol sostener.",
        "Iraus platz,",
        "sol profieg n'ayatz;",
        "yeu vuelh entendensa",
        "d'amor ab plazensa.",
        "Trebalhar mays fay valer",
        "[Guiraut]",
        "&lt;m&gt;a part quel vostra per ver,",
        "don es matz",
        "s'om dreg ven jutjatz.",
        "En Miquel prec vensa",
        "la maior falhensa."
    ],
