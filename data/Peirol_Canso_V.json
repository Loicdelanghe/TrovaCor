{
    "Author": [
        "Peirol"
    ],
    "Genre": "Canso",
    "Title": "En joi quem demora ",
    "FullText": [
        "En joi quem demora",
        "vuoill un sonet faire,",
        "quar bem vai aora",
        "ot mon afaire.",
        "Fin amors monora",
        "qual mieu vejaire,",
        "ja tan rics no fora",
        "ieu fos emperaire.",
        "Qel coratge nai",
        "jauzion e gai,",
        "pero non a gaire",
        "quera mortz desmai.",
        "Plus es amors bona",
        "queu non puosc retraire;",
        "qui la malrazona",
        "on es fis amaire.",
        "Tan gen guizerdona,",
        "ot fai maltraire,",
        "qui si abandona",
        "oll es desfizaire.",
        "On que sia sai,",
        "mon pessamen ai",
        "o dous repaire",
        "on ma dompn estai.",
        "Sieus sui quilh me mena",
        "ortesia",
        "ab frevol cadena",
        "fort em lia.",
        "Mos mals nos refrena,",
        "ben garitz seria",
        "ab tan doussa pena",
        "midonz maucizia.",
        "Ja no men partra",
        "ma vida mai;",
        "ieu totz temps vivia",
        "otz temps lamarai.",
        "Francha res cortesa,",
        "bella douss amia,",
        "or vos ma mesa",
        "Amors tota via;",
        "joia mes presa",
        "aital compaignia,",
        "quieu sui, si nous pesa,",
        "vostres on quieu sia.",
        "Ja ren nous querrai",
        "z vos servirai,",
        "qant nous plairia,",
        "ja ren nous dirai.",
        "Sieu, per alegransa,",
        "vuoill cantar e rire",
        "un joi que menansa",
        "on ieu sui jauzire,",
        "ja, dompna, doptansa",
        "on aiatz del dire",
        "quieu fassa semblansa",
        "que de vos cossire.",
        "Ben e gen mi sai",
        "obrir, qan sui lai;",
        "sieu mos huoills vos vire,",
        "ben tost los nestrai.",
        "Som ren mi demanda",
        "mon dous dezire,",
        "Amors mi comanda",
        "vertat escondire.",
        "Mout coven que blanda",
        "quieu plus desire,",
        "que foudatz es granda",
        "ieu qier quilh mazire.",
        "Gardatz cum seschai",
        "o cum si me vai;",
        "o quem sol aucire",
        "madutz joi verai.",
        "Cansoneta, va",
        "h a midons lai,",
        "potz lim ben dire",
        "quen breu la verai."
    ],
