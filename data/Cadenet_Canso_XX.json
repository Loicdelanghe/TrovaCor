{
    "Author": [
        "Cadenet"
    ],
    "Genre": "Canso",
    "Title": "Camjada s'es m'aventura ",
    "FullText": [
        "Camjada ses maventura,",
        "on eu me sofrirassatz,",
        "e si en breu non meillura,",
        "serai amics desamatz,",
        "queram loingna de son aire",
        "cella qem soli atraire",
        "mas chanssos e mos gais sos ;",
        "e puois razos mes faillida,",
        "si vuoill far chansson grazida,",
        "ops mes ajuda de sen,",
        "o non chantarai plazen.",
        "Dompna, nom met en rancura",
        "ges nuilla res quem fassatz,",
        "qans farai tant de mesura",
        "qieu sofrirai tot en patz",
        "per lo ben qem soletz faire ;",
        "et es me greu a retraire",
        "que ja vos vostras faissos",
        "esmentatz a vostra vida ;",
        "et er me bon, sius oblida",
        "que vos fassatz faillimen,",
        "queus planc plus quel dan qieu pren.",
        "E sieu per ma forfaitura",
        "fos, dompn, aissi malmenatz,",
        "eu vos pliu tot so com jura.",
        "qieu fora desesperatz.",
        "mas ieu sui lejals amaire ;",
        "oncs, dompna, qeus es vejaire ?",
        "qe anc pros dompna que fos",
        "non dec laissar ses faillida",
        "son amic, pos la servida",
        "e son poder franchamen ;",
        "e so fetz, noil estet gen.",
        "Dompna, sinaissi pejura",
        "as me vostra voluntatz",
        "e non voletz aver cura",
        "que ab vos mi retengatz,",
        "ja nom pliurai en flor gaire,",
        "tro quen veja lo gran traire,",
        "com joios ni melhuros",
        "en sia, car es delida,",
        "e flors, on miells es florida,",
        "ella se fraing per nien,",
        "qand so que mostra, desmen.",
        "Pero mos cors sasegura,",
        "ompna, car vos nom camjatz",
        "per autre ni per falsura",
        "ni per ren, mas car vos platz ;",
        "per qer plus leu del refaire ;",
        "et ieu sui leials amaire,",
        "mais joios et amoros",
        "com questiers nom vei guerida",
        "ses vos, que metz abellida,",
        "pros dompna, mais per un cen",
        "cal primier comenssamen.",
        "Lausengier, Dieus vos don vida",
        "que tals messonj es auzida",
        "on vos mi faitz honramen",
        "et amar celadamen."
    ],
