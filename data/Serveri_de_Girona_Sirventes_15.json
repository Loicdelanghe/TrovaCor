    "Author": [
        "Serveri_de_Girona"
    ],
    "Genre": "Sirventes",
    "Title": "Un vers ay commenat ",
    "FullText": [
        "Un vers ay commenat,",
        "Ver semblan de pegueza ;",
        "Car dic que paubretatz",
        "Val trop mays que riqueza",
        "E domna ses beutatz",
        "C'azauta ne corteza",
        "Ez erguylls e braveza",
        "Que franc' umilitatz",
        "E nosenz e foudatz",
        "Que pura saveza",
        "E c'onors ne largueza",
        "Tolres e cobeytatz.",
        "Dreit a dreit razona",
        "Ten hom a gran boneza,",
        "Mas tortz, en dreit tornatz,",
        "Es pus sobtils certeza ;",
        "Car per simples letratz",
        "Es razos leu defeza,",
        "Mas de razo mal meza",
        "Genar es mays bontatz,",
        "E doctors es lauzatz,",
        "S'a razo d'altr'apreza ;",
        "Mas can de si l'a preza,",
        "Es pus pels prims presatz !",
        "Greu viu hom ab ricta",
        "Ses tort e ses maleza ;",
        "Doncs per Deu s'es amatz.",
        "Mas qui viu ab paubreza,",
        "Bel' a domna, cresatz",
        "Qu'encen guerr'e conteza",
        "Ez es per tanz enteza",
        "Quel marits n'es iratz,",
        "E l'humils es menatz,",
        "Mal batutz per simpleza,",
        "C'a de venjar flaqueza,",
        "E l'ergoyllos dubtatz.",
        "Los savis mal lor gra",
        "Fora senz e franqueza",
        "D'aucir los fols els fatz,",
        "E res tan fort nols peza.",
        "No manjo re en patz",
        "Ne jazon c'am besteza,",
        "Ans an vil vid'enpreza",
        "Per gen viur'engraixatz ;",
        "No dic dels avocatz,",
        "Qui porton la ma teza",
        "E volon tort'encesa",
        "A dir dreitz biaixatz.",
        "Gran faix a emparat,",
        "Qui honor a perpreza",
        "E pert se pus viatz",
        "Que domna leu enqueza.",
        "No podon viur'onratz",
        "Ses par d'autruy despeza !",
        "Anc deleitz ne nobleza",
        "No n'ac reys ne prelatz.",
        "Sils tolenz esgardatz",
        "Com son en gran auteza",
        "E an lauzor conqueza,",
        "Trop may val toltz que datz",
        "La domna dels Cartz jatz",
        "Entr'onor e franqueza",
        "E Sobrepretz s'es meza",
        "Justa leys, per quem platz.",
        "Si vols esser lauzatz,",
        "Vers, vay t'en ves Monteza",
        "Al bon rey qui l'a preza,",
        "Don er totz temps presatz."
    ],
