{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Solatz, jois e chantar",
    "FullText": [
        "Solatz, jois e chantar",
        "Es eras oblidatz,",
        "Mas tan es alt poiatz",
        "Lo malsque non a par,",
        "Per que pretz e jovens",
        "E bels chaptenemens",
        "En son motz deschazatz,",
        "Si cals plus rics baros",
        "En ave mals ressos,",
        "Et estera lor be",
        "Cus quecs penses de se;",
        "Car Deus als plus prezatz",
        "Donet las eretatz.",
        "Et anc per trop donar",
        "Senes altras foldatz",
        "Rics om no fo cochatz",
        "Ni per so gen-estar,",
        "E si nuls ditz: Tu mens,",
        "Que sia conoissens:",
        "Eu sui ben assermatz;",
        "Que per dichs autoros",
        "Farai creire als bos",
        "Queu dic ver, per ma fe,",
        "Que per bos fachs save",
        "E per adrechs perchatz",
        "Onors ab grans rictatz.",
        "E donc ric omavar,",
        "Can ben es aguzatz",
        "E non garis, onratz",
        "Se deu be pauc prezar;",
        "Car entre bonas gens",
        "Qui mais a e val mens",
        "Deu esser mens nomnatz",
        "E, can el er rescos,",
        "Ner gaps entrels plus pros",
        "Aitals com se conve,",
        "Et el sapcha desse",
        "Canc nuls om rics malvatz",
        "No fo per Deu salvatz.",
        "Per com se deu gardar,",
        "Mentres alezeratz,",
        "De faire grans pechatz",
        "E de tot mal-estar;",
        "Quel segles es niens!",
        "Donc per esser manens,",
        "Voletz esser blasmatz?",
        "Oc be, si voletz vos",
        "Aver mais quesser pros;",
        "Que pretz no sesdeve,",
        "Can om no fai per que,",
        "E seu re be no fatz,",
        "Per que serai lauzatz?",
        "Mas un en sai quem par",
        "Trop ben aministratz",
        "De far rics fachs prezatz,",
        "De be-dir e de far",
        "E de bos fachs sabens;",
        "Ques cortes e plazens,",
        "Umils, de bel solatz",
        "E ja nolh chal a nos",
        "Donar dels esperos,",
        "Ans es, som nol rete",
        "Trop duramen el fre,",
        "Vas pretz tan eslaissatz",
        "Cun pauc en sembla fatz.",
        "Reis nAnfos, cel cus fe",
        "Volha cades siatz",
        "Plus pros e mais prezatz!"
    ],
