{
    "Author": [
        "Arnaut_de_Maroill"
    ],
    "Genre": "Canso",
    "Title": "Mout eron doutz miei cossir ",
    "FullText": [
        "Mout eron doutz miei cossir",
        " e ses tot marrimen,",
        "quan la bell' ab lo cors gen,",
        "humils, franc' e de bon aire,",
        "me dis de s'amor estraire,",
        " don ieu nom puosc partir ;",
        " e car ill nom rete,",
        " ni l'aus clamar merce,",
        "tuich solatz mi son estraing,",
        "pos de lieis jois mi sofraing.",
        "Dompna, sius plagues sofrir,",
        " per vostre chausimen,",
        "c'ab doutz precs cars, humilmen,",
        "merceian cum fis amaire,",
        "os auses mon cor retraire,",
        " en luoc d'autre gauzir,",
        " vos non costera re",
        " e mi feira gran be ;",
        "quel malautes, quan si plaing,",
        "si noil val, si s'en refraing.",
        "Doussa dompna cui desir,",
        " per vostr' enseingnamen,",
        "ostre bel acuillimen",
        "nom vedetz, quem soletz faire ;",
        "el plus nous aus preiar gaire,",
        " tant sui espaventatz,",
        " car etz de tant rics plais.",
        " Mas Ovidis retrais",
        "qu'entrels corals amadors",
        "non paratgeia ricors.",
        "Tant es per tot eissausatz",
        " vostre pretz rics e cars,",
        "tem que noi val mos lauzars ;",
        "pero ben sai ses doptansa,",
        "si tot s'es plenail balansa,",
        " qui met plus de l'un latz,",
        " sol un gran, pesa mais",
        " vas cella part lo fais ",
        "atressi creis vostr' honors,",
        "cum hom plus en ditz lauzors.",
        "Enseignamens e beutatz,",
        " franques' e gens parlars,",
        "gens acuillirs et honrars,",
        "cortes' ab gaia semblansa,",
        "os fant sobr' autras honransa ;",
        " per que jois e solatz",
        " reviu en vos e nais",
        " vas calque part biais,",
        "e no m'o fai dir Amors,",
        "mas vers e vostra valors.",
        "Genos, so sapchatz,",
        " si cum abrils e mais",
        " es d'autres temps plus gais,",
        "es vostre rics pretz colors",
        "resplandens sobrels meillors.",
        " Frances, qui ques biais",
        " ni de proezas lais,",
        "en vos es pretz e valors,",
        "gauz, e solaz et amors."
    ],
