{
    "Author": [
        "Cadenet"
    ],
    "Genre": "Canso",
    "Title": "Oimais m'auretz avinen ",
    "FullText": [
        "Oimais mauretz avinen",
        "e chantar e de solatz",
        "os autre, a cui jois platz,",
        "car tant trob de chausimen",
        "quemendamen nai sivals ;",
        "e sim creissial cabals",
        "e joi, mais malegraria,",
        "non ! per tant que be sabria",
        "mon cor destreigner daitan",
        "que ja nuills hom al mieu chan",
        "gran joi non conoisseria.",
        "Pero chantan e rizen",
        "pot estar qetz e celatz",
        "qui savis es ni membratz.",
        "et eu sui ben daital sen,",
        "que nom es hom tant corals",
        "que nom sembles desleials",
        "puois ja mon joi menqerria ;",
        "e cel qe mais cuidaria",
        "saber mon cor demandan,",
        "sabrian al cap del an",
        "aitan cum al primier dia.",
        "En ren, al mieu escien,",
        "non a ops hom miells senatz",
        "quen amor, car, si amatz",
        "et etz de leugier talen,",
        "seretz de parlar venals,",
        "e de trop parlar ve mals.",
        "sabetz cals ? pert nom samia,",
        "per que senz i taigneria",
        "que capdeles lo talan,",
        "caisi vai amors enan,",
        "e dechai per leugaria.",
        "Oi non ai ren tan plazen,",
        "ompna, cum qan mesgardatz,",
        "ab qel cor maia mandatz",
        "los huoills, cals non vauc queren.",
        "ai ! qai dig ? etz vos doncs tals",
        "que jam fassatz semblan fals ?",
        "os non, pero tant volria",
        "jauzir, dompna, sius plazia,",
        "ensems lo joi el semblan",
        "quieu en tem, qar o vuoill tan ;",
        "sol per aisso dic foillia.",
        "style=\"text-align: center;\">V",
        "Eus am per vostre joven,",
        "eus am car hi es beutatz,",
        "eus am car ades genssatz,",
        "eus am per vostre cor gen,",
        "e vos am car etz leials,",
        "eus am car etz cabals,        ( 1)",
        "eus am per vostra coindia,",
        "eus am per plazen paria,",
        "eus am car etz ses engan,",
        "caissi etz faita garan",
        "que mais ni meins no i taignia.",
        ". . . . . . . . . . . . . . . . . . . .",
        "Sil reina no sofria",
        "alor, del tot decharia,",
        "Helionors, que regnan",
        "ab honor, e si gardan,",
        "meillura de pretz qec dia."
    ],
