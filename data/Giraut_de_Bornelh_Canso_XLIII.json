{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "Jam vai revenen",
    "FullText": [
        "Jam vai revenen",
        "Dun dol e dunira",
        "Mo cor; queraten",
        "Per sol bo conven",
        "Benananse jai,",
        "Per queu chantarai.",
        "Cogan non pensera,",
        "Pos vergers ni pratz",
        "No madui solatz",
        "Ni chans pels plaissatz",
        "Que lauzelet fan",
        "Vas lo torn de lan.",
        "Ni ja lavol gen",
        "Paiatz no sofrira;",
        "Capensadamen",
        "Van vas valor len,",
        "Per que pretz dechai.",
        "Ren als nous en sai,",
        "Mas ja no cudera",
        "Fos aissi viatz",
        "Jois dezamparatz!",
        "Vos men conortatz,",
        "Domna, per cui chan",
        "Em vauc alegran.",
        "E per vos defen",
        "So que plus me tira",
        "Que no mes parven",
        "Pel bo pensamen",
        "Que nagui e nai,",
        "Pos plus no meschai.",
        "Cassatz melhs chantera,",
        "Sil gens cors onratz",
        "Me fos plus privatz,",
        "E pero, sius platz,",
        "Noi dei aver dan,",
        "Sius me prec chantan.",
        "Cab plus dardimen",
        "Mo fat cor nos vira,",
        "Tan no mespaven!",
        "Ans me ditz soven",
        "Ca mo dan serai,",
        "Can vos preiarai,",
        "Pos aissi metz fera,",
        "Car sol cudatz,",
        "Ans que ren sapchatz.",
        "Si plus nauziatz,",
        "Paor me fai gran",
        "Quem dobles lafan.",
        "Mas mon escien",
        "Totaltram sofrira",
        "Plus denvazimen.",
        "Parlem belamen;",
        "Diatz o dirai:",
        "Cal tort vos aurai,",
        "Sius am o enquera",
        "Vos me prec forsatz,",
        "Pos pres e liatz",
        "Sui? Ja no crezatz",
        "Com sobre talan,",
        "Ja mane garan!",
        "Car quil drech enten",
        "Damor nin sospira,",
        "Noi pot aver sen",
        "De gran jauzimen,",
        "Sab foldat noi vai;",
        "Canc drut savi ga",
        "No vi, cans esmera",
        "Lo sen la foldatz",
        "Quera, samavatz",
        "El sen creziatz,",
        "Per pauc de semblan",
        "Iriatz doptan!",
        "E per aisso pren",
        "Qui trop no salbira .",
        "Primers, car consen",
        "So caltre repren.",
        "Ges be no mestai,",
        "Sius me prec, de lai;",
        "Eissamen mamera",
        "Com vos vos amatz",
        "Que guerram fassatz?",
        "Mas sofretz en patz;",
        "Que cilh venceran",
        "Que melhs sofriran.",
        "Quen patz e sofren",
        "Vi ja quem jauzira",
        "Dunamor valen,",
        "Si leugeramen",
        "Per fol sen sava",
        "Nom fezes esgla",
        "So que maiudera,",
        "Seu fos veziatz;",
        "Mas fezim iratz",
        "Per caltre senatz,",
        "Can manei tarzan,",
        "Pois e pres enan.",
        "E pois? Sofert era",
        "Maior tort assatz,",
        "Can men sui lonhatz,",
        "E sui nesfredatz!",
        "Per queus prec eus man",
        "Que sofratz aman.",
        "Bem platz que laman",
        "Amon sofertan.",
        "XI",
        "Car cilh venceran",
        "Que be sofriran."
    ],
