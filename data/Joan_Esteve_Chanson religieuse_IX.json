{
    "Author": [
        "Joan_Esteve"
    ],
    "Genre": "Chanson religieuse",
    "Title": "Le senhers qu'es guitz ",
    "FullText": [
        "Le senhers ques guitz",
        "el mon, que totz bes",
        "   fes,",
        "us vers Dieus complitz,",
        "humil, de merces",
        "   ples,",
        "qui fo pels malditz",
        "juzieus en crotz, pres,",
        "   mes,",
        "mortz, despieut feritz,",
        "ses tort, coma fes",
        "   es,",
        "prec, si cum es clars",
        "   bars,",
        "reys dels reys, senhors,",
        "   flors,",
        "quab sos perdonars",
        "   cars",
        "mautreye samors,",
        "quab mos fals parlars",
        "   vars",
        "suy avutz peiors",
        "   cors,",
        "ez e mos pessars",
        "   fars-",
        "sitz dira e derrors,",
        "   ab bauzia",
        "   quem galia.",
        "aissi mal obran",
        "   lan",
        " quals quem sia,",
        " mercel sia",
        "e so quel deman,",
        "   tan",
        " que la mia",
        " arman ria",
        "lora trespassan:",
        "   quan",
        " er lo dia",
        " donelh via",
        "lay on li sal gran",
        "   van.",
        "De miey falhimen",
        "e de mos peccatz",
        "   datz",
        "siam salvamen,",
        "si a sas bontatz",
        "   platz",
        "el seynhor plazen",
        "a cuy non desplatz",
        "   patz,",
        "ans nan veramen",
        "bonas voluntatz",
        "   gratz,",
        "en ve a bon port",
        "   fort",
        "larma del cor dos,",
        "   bos,",
        "humil, quan la mort",
        "   mort",
        "lo, eil trencal nos;",
        "mar ieu, si recort,",
        "   port,",
        "felh, cor ergullos;",
        "   mos",
        "huelhs man dat conort",
        "   tort,",
        "mal mantas sazos,",
        " ab semblansa",
        " quez enansa",
        "peccat que trah",
        "   mi.",
        " Perdonansa",
        " ner mondansa",
        "el rey quey mat",
        "   vi;",
        " quesperansa",
        " ses duptansa",
        "nay, quen als nom fi,",
        "   n",
        " nay membransa.",
        " Per sonransa",
        "on gaug a ma f",
        "   fi.",
        "El sieu paradis,",
        "on bruelha e nays",
        "   mais",
        "e be quom no dis,",
        "ez es pus verays",
        "   fais,",
        "sil platz, maculhis",
        "Dieus, vers pas quens pays",
        "   gays,",
        "marma peccairis",
        "plena de forfais",
        "   lays,",
        "quanc no saup tener",
        "   ver",
        "pus nasquet em pes,",
        "   des-",
        "torta dun dever.",
        "   Per",
        "sert yeu lim cofes,",
        "e plassal aver",
        "   mer-",
        "ces, re noy gares",
        "   des-",
        "m, el gaug quieu esper",
        "   ser",
        "mati, luenh o pres,",
        " del repaire",
        " on ad aire",
        "estan los lials",
        "   sals",
        " mi peccaire",
        " metal paire",
        "reys celestials,",
        "   quals",
        " nos volc traire",
        " de mezaire,",
        "queram tug egals",
        "   mals",
        " ses estrai re;",
        " denh o faire,",
        "noy gar mos jornals",
        "   fals.",
        "span style=\"text-align: center;\">IV</span",
        " Lo salvaire",
        " perdonaire",
        "maya merce quals",
        "   tals",
        " quo al layre",
        " ac lo paire",
        "quan suffri mortals",
        "   mals."
    ],
