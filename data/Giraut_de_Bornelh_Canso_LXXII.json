{
    "Author": [
        "Giraut_de_Bornelh"
    ],
    "Genre": "Canso",
    "Title": "De chantar   Ab deport",
    "FullText": [
        "De chantar Ab deport",
        "Me foreu totz laissatz;",
        "Mas can sui ben iratz,",
        "Estenh lirab lo chan",
        "E vauc me conortan.",
        "Questers no fora patz",
        "Entre lirel coratge",
        "Ques contrun mal uzatge,",
        "Que nais e poie creis,",
        "Queres falhitz domneis,",
        "Don sol om esser gais,",
        "E pretz no pot ni jais",
        "Revenir entretans;",
        "Car es de cels clamans",
        "Per cui degra valer",
        "E ges pretz ses poder",
        "Longamen sas no dura,",
        "Ses clam o ses rancura.",
        "Alegrar Me volh fort",
        "E sui aissi passatz",
        "E, si no sembles fatz,",
        "Non chamjeral talan.",
        "Mas tenos a mazan",
        "Mans bos sonetz queu fatz",
        "Vila d avol linhatge,",
        "Canc pros om de paratge,",
        "Sen ben auzir ateis,",
        "De lescoltar nos feis",
        "Nil plazer no nestrais.",
        "E non es be savais",
        "Cui jois no platz ni chans?",
        "Et es daufeza grans,",
        "Qui no sap retener",
        "Bel agrat ni plazer",
        "Es defen nis rancura,",
        "Si laltrui jois se dura.",
        "E nous par Peitz de mort",
        "Com cui satanh solatz",
        "Viva desconortatz",
        "Ni fassa mal semblan?",
        "Al ver Deu me coman,",
        "En cal ora fo natz",
        "Ab aital cor salvatge!",
        "Que lauzel el boschatge,",
        "Can lo dolz tems pareis,",
        "Movon entrels mezeis",
        "Sonetz e critz e lais,",
        "E qui ja non er gais,",
        "Com pot esser durans?",
        "Res mais non es afans",
        "Mas ira sostener",
        "Ni res tan mal saber,",
        "Quez ab sen se melhura,",
        "Com ira no peinura!",
        "Dun afar Me conort,",
        "Don degresser iratz;",
        "Que bem fora clamatz",
        "De so que lalsor fan",
        "E del mal e del dan",
        "Quels en a desviatz,",
        "Mas en gran volpilatge",
        "Man mes vila passatge",
        "Queun parlera forseis!",
        "El senher, quem nespeis,",
        "Can mabateral fais,",
        "Am comandat que mais",
        "Non sia corelhans",
        "Plus quilh son de lor dans,",
        "Ni daltrui no-dever",
        "Nom poscha molt chaler!",
        "Nim chal si bes peiura",
        "Lor afars nis melhura?",
        "Bo proar Magra sort",
        "Un dels melhors letratz",
        "Si ja venra vertatz",
        "Ni viures ses engan",
        "Ni si ja cobraran",
        "Jois, deportz ni barnatz",
        "Lor ancian estatge,",
        "Non metria ges gatge!",
        "Tan poial mals anceis",
        "E drechura ni leis",
        "No vei aissi verais",
        "Com ja dis ni retrais",
        "Establimens ni mans;",
        "Per que dezerenans",
        "Estart al remaner",
        "E, si del chaptener",
        "Deus no pren cal que cura,",
        "Nos nirem lambladura!"
    ],
